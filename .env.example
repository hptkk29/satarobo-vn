# Database (Supabase)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<openssl rand -base64 32>"

# Tracking
NEXT_PUBLIC_META_PIXEL_ID="2157352735031955"
META_CAPI_TOKEN=""
NEXT_PUBLIC_GA4_ID="G-0K2CW1DQK1"
GA4_API_SECRET=""

# Meta CRM / Messenger / Ads (Phase R1) — ĐẶT GIÁ TRỊ THẬT Ở .env.local + Vercel, KHÔNG commit.
META_APP_ID=""
META_APP_SECRET=""            # App Dashboard → Settings → Basic → App Secret (ký X-Hub-Signature-256)
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""     # gửi reply Messenger + gọi Ads Insights
META_AD_ACCOUNT_ID=""
# Verify token webhook Messenger: tái dùng WEBHOOK_FACEBOOK_VERIFY_TOKEN (mục dưới).

# Email (Resend) — Phase 5.13.0
RESEND_API_KEY="re_xxxxx_get_from_resend_com_dashboard"
RESEND_FROM_EMAIL="Sata Robo <noreply@satarobo.vn>"
RESEND_REPLY_TO="info@satarobo.vn"
EMAIL_FROM="Sata Robo <noreply@satarobo.vn>"

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="satarobo-uploads"
R2_PUBLIC_URL="https://cdn.satarobo.vn"

# Zalo OA / ZNS (commit 5) — gửi thông báo điểm danh + nhắc công nợ.
# OA ID đã biết (có thể override). Cần ACCESS_TOKEN + template ZNS đã duyệt mới gửi
# thật; bật ZALO_LIVE="true" để gọi API. Thiếu token → tự fallback EMAIL (an toàn).
ZALO_OA_ID="40213330288531842"
ZALO_OA_ACCESS_TOKEN=""
ZALO_LIVE="false"
ZALO_ZNS_TEMPLATE_ATTENDANCE=""
ZALO_ZNS_TEMPLATE_DEBT=""
# Auto-refresh token (lib/zalo/token.ts): access_token Zalo sống ngắn → tự gia hạn
# bằng refresh_token. Cấp 3 biến dưới (lấy 1 lần qua OAuth v4) → hệ thống tự xoay
# token (lưu IntegrationConfig provider=ZALO_OA), khỏi thay token thủ công.
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_REFRESH_TOKEN=""
# Legacy (giữ tương thích)
ZALO_OA_TOKEN=""

# Lead webhooks (Phase T1.4) — shared-secret cho từng nguồn.
# ĐỂ TRỐNG = chế độ stub (không xác thực, chỉ dùng dev). Đặt secret trước go-live.
# Khi đã set: request phải gửi header `x-webhook-secret: <giá trị>` hoặc query `?secret=`.
# Facebook: developers.facebook.com → App → Webhooks → Leadgen.
WEBHOOK_FACEBOOK_VERIFY_TOKEN=""
WEBHOOK_FACEBOOK_SECRET=""
# Verify chữ ký X-Hub-Signature-256 cho webhook Meta (leadgen + messenger) dùng
# META_APP_SECRET (đã khai ở mục Tracking phía trên — DÙNG CHUNG 1 secret).
# Zalo: Zalo OA Dashboard → Webhook.
WEBHOOK_ZALO_SECRET=""
# Google Form: tự đặt, nhập vào Apps Script gửi kèm request.
WEBHOOK_GOOGLE_FORM_SECRET=""

# App
NEXT_PUBLIC_APP_URL="https://satarobo.vn"
NODE_ENV="development"

# RBAC v2 (A0-03) — can() đọc quyền động từ DB. Mặc định OFF (fallback matrix tĩnh).
# Bật dần: dev → staging → 1 tuần shadow-compare → production.
RBAC_V2_ENABLED="false"

# Rate limiting (Upstash Redis — optional, falls back to in-memory if missing)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry error tracking (optional — Sentry SDK no-ops if DSN missing)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
