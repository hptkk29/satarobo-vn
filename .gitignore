# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
appdev.log
*.dev.log

# env files — chặn TẤT CẢ biến thể (.env.vercel, .env.bak, .env.cs2…),
# chỉ .env.example được commit. Liệt kê tay từng tên là bỏ sót file mới.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Backup files (NEVER commit)
*.bak
*.backup
*.swp
*.swo
*~
Thumbs.db

# Sensitive files (extra safety)
*.key
*credentials*
*-secret*
secret-*
*.sql.bak
*.dump

# Claude Code per-user settings (project-wide config trong rules/skills/commands IS committed)
.claude/settings.local.json
.claude/launch.json
.claude/cache/
.claude/.logs/

# Phase 4.UI.FIX.3 — Legacy source reference (do NOT commit)
/_legacy-sources/
/_temp-uploads/

_qa-reports/

# Playwright (test results local, do NOT commit — CI uploads as artifact)
/playwright-report/
/test-results/

# rác cục bộ (lọt vào commit 04/08 — chặn hẳn)
.pnpm-store/
full.txt

# impeccable-ignore-start
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/*.png
# impeccable-ignore-end
shots-teacher/
