generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  MANAGER
  HR
  SALES
  TEACHER
  MARKETING
  ACCOUNTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  ENROLLED
  NURTURING
  LOST
}

enum CourseType {
  ONLINE
  OFFLINE
  HYBRID
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
  PAUSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

// ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Business ───────────────────────────────────────────────────────────

model Center {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  leads     Lead[]
  classes   Class[]
  students  Student[]
  employees Employee[]

  @@index([isActive])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SALES)
  centerId      String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Link 1-1 với Employee (1 user account ↔ 1 employee record)
  employeeId    String?   @unique
  employee      Employee? @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  center        Center?        @relation(fields: [centerId], references: [id])
  accounts      Account[]
  assignedLeads Lead[]         @relation("AssignedLeads")
  notes         Note[]
  teacherClass  Class[]        @relation("TeacherClasses")
  blogPosts     BlogPost[]
  jobPostings   JobPosting[]

  honorsCreated      Honor[]            @relation("HonorCreatedBy")
  pageContentUpdated SitePageContent[]  @relation("PageContentUpdatedBy")
  employeesCreated   Employee[]         @relation("EmployeeCreatedBy")

  @@index([email])
  @@index([centerId])
  @@index([role])
  @@index([deletedAt])
}

model Course {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  type        CourseType @default(OFFLINE)
  description String?    @db.Text
  price       Int?
  duration    Int?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  leads       Lead[]
  classes     Class[]
  enrollments Enrollment[]

  @@index([slug])
  @@index([type])
}

model Lead {
  id           String     @id @default(cuid())
  parentName   String
  phone        String
  email        String?
  childName    String?
  childAge     Int?
  centerId     String?
  courseId     String?
  assignedToId String?
  status       LeadStatus @default(NEW)
  source       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent       String?
  utmTerm          String?
  fbclid           String?
  gclid            String?
  fbp              String?
  fbc              String?
  eventId          String?   @unique
  landingPage      String?
  referrer         String?
  ipAddress        String?
  userAgent        String?   @db.Text
  consentMarketing Boolean   @default(false)
  note             String?   @db.Text
  deletedAt        DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  center     Center? @relation(fields: [centerId], references: [id])
  course     Course? @relation(fields: [courseId], references: [id])
  assignedTo User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes      Note[]

  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@index([centerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([eventId])
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  leadId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

model Student {
  id          String    @id @default(cuid())
  name        String
  dateOfBirth DateTime?
  phone       String?
  email       String?
  parentName  String?
  parentPhone String?
  centerId    String?
  avatarUrl   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  center      Center?      @relation(fields: [centerId], references: [id])
  enrollments Enrollment[]
  attendances Attendance[]

  @@index([phone])
  @@index([centerId])
  @@index([deletedAt])
}

model Class {
  id          String    @id @default(cuid())
  name        String
  courseId    String
  centerId    String?
  teacherId   String?
  schedule    String?
  startDate   DateTime?
  endDate     DateTime?
  maxStudents Int       @default(20)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course      Course       @relation(fields: [courseId], references: [id])
  center      Center?      @relation(fields: [centerId], references: [id])
  teacher     User?        @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@index([courseId])
  @@index([centerId])
  @@index([teacherId])
  @@index([deletedAt])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  courseId  String
  status    EnrollmentStatus @default(ACTIVE)
  tuition   Int?
  paidAt    DateTime?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model ClassSession {
  id        String   @id @default(cuid())
  classId   String
  date      DateTime
  topic     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([classId])
  @@index([date])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

// ─── Content & Marketing ─────────────────────────────────────────────────────

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  authorId    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  category    String?
  tags        String[]
  readingTime Int?
  seoTitle    String?
  seoDesc     String?
  ogImage     String?
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([category])
}

model JobPosting {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  department   String?
  location     String?
  type         String?
  description  String    @db.Text
  requirements String?   @db.Text
  benefits     String?   @db.Text
  salary       String?
  salaryMin    Int?
  salaryMax    Int?
  salaryNote   String?
  openings     Int       @default(1)
  status       JobStatus @default(OPEN)
  authorId     String?
  closesAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author       User?              @relation(fields: [authorId], references: [id])
  applications JobApplication[]

  @@index([slug])
  @@index([status])
  @@index([department])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  name        String
  email       String
  phone       String
  cvUrl       String?
  coverLetter String?           @db.Text
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([email])
}

model MarketingConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================
// HALL OF FAME — VINH DANH NHÂN SỰ
// ============================================

enum HonorCategory {
  SPARK
  GROWTH
  IMPACT
  GRAND_CHAMPION
}

model Honor {
  id             String        @id @default(cuid())
  slug           String        @unique

  // Link sang Employee (source of truth cho thông tin nhân sự)
  // Tạm thời nullable để migration backfill xong mới enforce NOT NULL ở Phase 4.7.1
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Snapshot lúc trao giải (override Employee data hiện tại nếu cần)
  jobTitleAtTime String?
  yearsAtTime    Int?

  // DEPRECATED: Giữ tạm để code cũ rollback an toàn, sẽ drop ở Phase 4.7.1
  // Code mới đọc qua honor.employee.fullName / jobTitle / avatarUrl
  fullName       String?
  jobTitle       String?
  avatarUrl      String?
  yearsAtCompany Int?

  category       HonorCategory
  awardName      String
  awardedAt      DateTime
  awardQuarter   String?

  story          String        @db.Text
  shortBio       String?       @db.VarChar(280)
  pullQuote      String?       @db.VarChar(500)
  achievements   String?       @db.Text

  isFeatured     Boolean       @default(false)
  isPublished    Boolean       @default(true)
  displayOrder   Int           @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  createdBy      User?         @relation("HonorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isFeatured])
  @@index([isPublished, displayOrder])
  @@index([employeeId])
}

model TimelineItem {
  id              String   @id @default(cuid())
  occurredAt      DateTime
  title           String
  description     String   @db.Text
  coverImageUrl   String?
  relatedHonorIds String?
  isPublished     Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, occurredAt])
}

model SitePageContent {
  id           String   @id @default(cuid())
  pageKey      String
  contentKey   String
  contentValue String   @db.Text
  updatedAt    DateTime @updatedAt
  updatedById  String?
  updatedBy    User?    @relation("PageContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([pageKey, contentKey])
  @@index([pageKey])
}

// ============================================
// EMPLOYEE MODULE
// ============================================

enum Department {
  BAN_GIAM_DOC
  DAO_TAO
  MARKETING
  KINH_DOANH
  IT
  HANH_CHANH_NHAN_SU
  KE_TOAN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractType {
  FULLTIME
  PARTTIME
  INTERN
  FREELANCE
}

model Employee {
  id           String        @id @default(cuid())

  // Tier 1: cơ bản
  employeeCode String        @unique
  fullName     String
  jobTitle     String
  department   Department
  avatarUrl    String?
  email        String?       @unique
  joinedAt     DateTime?
  bio          String?       @db.Text
  isActive     Boolean       @default(true)
  isPublic     Boolean       @default(false)
  displayOrder Int           @default(0)

  // Tier 2: HR cơ bản
  phone        String?
  dateOfBirth  DateTime?
  gender       Gender?
  contractType ContractType?
  salaryRank   Int?
  salaryLevel  Int?

  // Cơ sở làm việc
  centerId     String?
  center       Center?       @relation(fields: [centerId], references: [id], onDelete: SetNull)

  // Self-relation: quản lý trực tiếp
  managerId    String?
  manager      Employee?     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[]    @relation("EmployeeManager")

  // CEO flag (chỉ 1 employee được isCEO=true tại 1 thời điểm)
  isCEO        Boolean       @default(false)

  // Meta
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  createdBy    User?         @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Relations
  honors       Honor[]
  userAccount  User?         @relation("UserEmployee")

  @@index([department])
  @@index([isActive])
  @@index([isPublic])
  @@index([isCEO])
}
