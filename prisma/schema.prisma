generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum GrantType {
  ALLOW
  DENY
}

enum Role {
  SUPER_ADMIN
  CENTER_MANAGER // Phase T0.1 — đổi tên từ MANAGER (quản lý cơ sở)
  HR
  SALES_CSM // Phase T0.1 — đổi tên từ SALES (tư vấn & chăm sóc học viên)
  TEACHER
  TRAINING // FL W0 (QĐ-T1) — Đào tạo: quản lý TOÀN BỘ LMS (curriculum/SCORM/câu hỏi/bài tập). KHÁC TEACHER (chỉ lớp được giao).
  MARKETING
  ACCOUNTANT
  PARENT // Phase T0.1 — phụ huynh (portal hocvien.satarobo.vn), KHÔNG vào /admin
}

// R1-04 — nguồn hoa hồng (SR.QD.217): từ ads/admin · sale tự kiếm · giới thiệu.
enum CommissionSource {
  MARKETING_ADMIN
  SALE_SELF
  REFERRAL
}

/// GĐ5 (25/08/2026) — RÚT TỪ 15 XUỐNG 10 GIÁ TRỊ theo đặc tả bàn giao mục 3.
///
/// Năm giá trị bị gỡ và lý do:
///   ASSIGNED       → chức năng của `Lead.assignedToId`, không phải một bậc phễu.
///   NO_ANSWER      → thuộc tính của LẦN GỌI, không phải của lead. Về DA_LIEN_HE.
///   DUPLICATE      → chặn bằng ràng buộc lúc tạo, không phải một bậc phễu.
///   DEMO_SCHEDULED → đã deprecated từ lâu, dữ liệu đã map sang hẹn học thử.
///   ENROLLED       → GỘP vào DA_DANG_KY (chủ dự án chốt câu 6 = A). Phân biệt "đã
///                    chốt" với "mới đăng ký" bằng `Lead.convertedAt`, không bằng
///                    trạng thái — mốc đó do chính lượt convert ghi nên chính xác hơn.
///
/// ⚠️ Khoá chống đua của convert PHẢI bám `convertedAt IS NULL` (đã đổi trước khi gộp).
/// Bám status như bản cũ thì sau khi gộp, lead "đã đăng ký" sẽ không convert được nữa.
enum LeadStatus {
  MOI
  DA_LIEN_HE
  DANG_TU_VAN
  DA_HEN_HOC_THU
  DANG_HOC_THU
  DA_HOC_THU
  CHO_QUYET_DINH
  DA_DANG_KY
  DANG_NUOI_DUONG
  DA_MAT
}

/// R7-01 — trạng thái học thử của từng con trong 1 lead (LeadChild).
enum LeadChildTrialStatus {
  NONE
  SCHEDULED
  IN_PROGRESS
  ATTENDED
}

enum CourseType {
  ONLINE
  OFFLINE
  HYBRID
}

enum EnrollmentStatus {
  // Legacy (kept for back-compat with existing rows)
  ACTIVE
  CANCELLED

  // D5 workflow
  PENDING
  CONFIRMED
  STUDYING
  PAUSED
  COMPLETED
  WITHDREW
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  // R7-08 — 2-phase bước A: thêm giá trị mới, map dần, chưa drop ABSENT/EXCUSED cũ.
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
}

// Module QL học viên PHẦN 2 — trạng thái học bù của buổi vắng.
enum MakeupStatus {
  NONE // không cần bù (mặc định)
  NEEDS_MAKEUP // vắng cần xếp buổi bù
  MADE_UP // đã học bù xong (tính như có mặt)
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
  PAUSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

// ─── Phase 5.6 — Payment + Order enums ────────────────────────────────────

enum PaymentMethodType {
  CASH
  BANK_TRANSFER
  VNPAY
  TINGEE
  COD
  WALLET // reserved for future wallet system (Sprint defer)
}

enum OrderType {
  COURSE // offline class enrollment
  PACKAGE // CoursePackage purchase
  EXAM // exam registration
  PRODUCT // physical product (kit/sensor) — Sprint 5.10
  COMBO // bundle, defer
}

// FIX lead→payment→enroll (M0/LD1/O1) — loại đơn dự kiến của lead (2 lựa chọn nghiệp vụ).
enum OrderKind {
  COURSE // Khoá học (gồm combo)
  PRODUCT // Sản phẩm
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED // payment confirmed, awaiting fulfillment
  COMPLETED // fulfilled (e.g., student attended class, kit delivered)
  CANCELLED // pre-COMPLETED cancellation
  REFUNDED // post-COMPLETED refund
}

enum OrderItemType {
  COURSE_ENROLLMENT // link tới Enrollment (offline class)
  COURSE_PACKAGE // link tới CoursePackage
  EXAM_REGISTRATION // link tới ExamAttempt
  PRODUCT // link tới Product (Sprint 5.10, nullable for now)
}

// ─── Phase 5.7 — Voucher enums ────────────────────────────────────────────

enum VoucherType {
  COURSE // áp dụng cho đơn type=COURSE
  PACKAGE // áp dụng cho đơn type=PACKAGE
  KIT_ROBOT // áp dụng cho product category=KIT (Sprint 5.10 ready)
  SENSOR // áp dụng cho product category=SENSOR (Sprint 5.10 ready)
  ALL // áp dụng cho bất kỳ loại đơn
}

enum VoucherDiscountKind {
  PERCENT // % giảm + max cap VND
  FIXED // tiền cố định VND
}

// ─── Phase 5.10 — Product catalog enums ───────────────────────────────────

enum ProductCategory {
  KIT_ROBOT // Bộ kit robot hoàn chỉnh
  SENSOR // Cảm biến riêng lẻ
  MISSION_BLOCK // Khối nhiệm vụ thi đấu
  ACCESSORY // Phụ kiện
  BOOK // Sách/tài liệu
  CONSUMABLE // Vật tư tiêu hao
  OTHER
}

enum ProductStatus {
  DRAFT // Soạn nháp, chưa bán
  ACTIVE // Đang bán
  PAUSED // Tạm ngưng bán
  DISCONTINUED // Ngừng kinh doanh
}

enum ProductMovementType {
  PURCHASE // Nhập hàng (+)
  SALE // Bán (-)
  ADJUSTMENT // Điều chỉnh (+/-)
  DAMAGE // Hỏng (-)
  RETURN // Trả lại từ KH (+)
  TRANSFER_IN // Chuyển từ CN khác (+)
  TRANSFER_OUT // Chuyển sang CN khác (-)
}

// ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
}

// ─── Core Business ───────────────────────────────────────────────────────────

model Center {
  id           String  @id @default(cuid())
  code         String? @unique // Phase T0.2 — mã cơ sở "CS1", "CS2" cho codegen
  name         String
  slug         String  @unique
  address      String
  ward         String?
  district     String?
  city         String  @default("")
  phone        String?
  email        String?
  googleMapUrl String? @db.Text
  workingHours String?
  managerName  String?

  // Phase NHÓM 4 — geofence chấm công QR.
  latitude            Float?
  longitude           Float?
  allowedRadiusMeters Int?     @default(100)
  logoUrl             String?
  bannerUrl           String?
  description         String?  @db.Text
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  users             User[]
  leads             Lead[]
  classes           Class[]
  classGroups       ClassGroup[]
  trialClasses      TrialClass[]
  students          Student[]
  studentsPreferred Student[]        @relation("StudentPreferredCenter")
  employees         Employee[]
  rooms             Room[]
  holidays          Holiday[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  inventoryAudits   InventoryAudit[]

  // Phase 5.6 — Order
  orders Order[]

  // 30/08/2026 — phương thức thanh toán RIÊNG của cơ sở (dòng centerId = null là
  // phương thức dùng chung, không thuộc cơ sở nào).
  paymentMethods PaymentMethod[]

  @@index([isActive])
  @@index([displayOrder])
}

// ─── A0-01 — OrgUnit tree (Doc 15 §2.1, OI-1) ───
// [Nền Hệ thống P1 · US-05] Hình cây ĐÃ ĐỔI (chủ dự án chốt 11/08/2026, theo BA 08/08 §1.1):
//   HO (gốc) → REGION (khối tỉnh/TP) → CENTER (cơ sở)
// Trước đó Doc 15 OI-1 để ROOT → HO, CS1, CS2 NGANG HÀNG; bản BA thắng theo README bàn giao §1.
// Node ROOT cũ (SATAROBO) vẫn hợp lệ về schema — việc dời cây trên DB đang chạy làm bằng
// script dry-run `scripts/nen-p1-reshape-org-tree.ts`, KHÔNG nhét vào migration (luật cứng #4).
enum OrgUnitType {
  ROOT
  HO
  REGION // P1 — khối quản lý tỉnh/TP (BA §1.1); cha của CENTER
  DEPARTMENT // P1 — phòng ban trong HO/cơ sở (BA §2.2)
  CENTER
  CAMPUS
  PARTNER
  FRANCHISE
}

// P1 — TRỤC SỞ HỮU, độc lập với unitType (BA §2.2: thứ AMIS không có).
// KHÔNG suy từ OrgUnitType.FRANCHISE (giá trị chết, giữ lại chỉ vì additive).
enum OrgRelationshipType {
  OWNED
  FRANCHISEE
  AFFILIATE
}

// P1 — vòng đời đơn vị (BA §2.2). GHI CHÚ QUAN TRỌNG: tới hết P1 đây là cột GƯƠNG của
// `isActive`, KHÔNG phải nguồn sự thật thứ ba. Mọi nơi hỏi "đơn vị còn sống không" đi qua
// đúng một hàm `isOrgUnitLive()` / `isOrgUnitActiveAt()` trong lib/org/status.ts.
enum OrgUnitStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model OrgUnit {
  id      String      @id @default(cuid())
  type    OrgUnitType
  code    String      @unique // "SATAROBO","HO","DANANG","CS1","CS2"
  name    String
  address String? // chỉ thông tin, KHÔNG suy ra quan hệ quản lý

  parentId String?
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children OrgUnit[] @relation("OrgUnitTree")

  // P1 · US-05 — materialized path. Dạng "/ho/danang/cs1/" (CÓ "/" ở cuối để `LIKE path || '%'`
  // cắt đúng biên node, không dính "/cs1" với "/cs10"). Segment = code viết thường, "_" → "-".
  // Nullable ở P1 vì migration additive; write path LUÔN set, invariant test chặn NULL mới.
  path  String?
  depth Int?

  relationshipType OrgRelationshipType @default(OWNED)
  status           OrgUnitStatus       @default(ACTIVE)
  effectiveFrom    DateTime?           @db.Timestamptz(6)
  effectiveTo      DateTime?           @db.Timestamptz(6)

  // Pháp nhân sở hữu (US-06). Nullable: đơn vị nội bộ chưa gắn pháp nhân vẫn hợp lệ ở P1.
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  // Khuôn mẫu sinh ra đơn vị — BA §6 "chừa cột trước, engine sau" (UnitTemplate là P5).
  // Cố ý KHÔNG có FK: bảng đích chưa tồn tại.
  templateId String?

  centerId   String?     @unique // Phase A: trỏ Center cũ. P1 nới cho cả HO (Center 'hoi-so').
  isActive   Boolean     @default(true)
  deletedAt  DateTime?   @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(6)
  positions  Position[]  @relation("PositionOrgUnit")
  workScopes WorkScope[] @relation("WorkScopeOrgUnit")

  /// EL-03 — yêu cầu đào tạo áp cho chính đơn vị này (scopeKind=ORG_UNIT).
  trnRequirements TrnRequirement[] @relation("TrnRequirementOrgUnit")

  @@index([type])
  @@index([parentId])
  @@index([deletedAt])
  // text_pattern_ops PHẢI khai ở đây cho khớp migration 20260811030000. Thiếu nó, lần
  // `prisma migrate dev` kế tiếp thấy shadow DB có opclass còn schema thì không, và sinh
  // migration DROP/CREATE đổi về btree thường — mọi `path LIKE '/ho/danang/%'` của P3 âm
  // thầm quay về seq scan.
  @@index([path(ops: raw("text_pattern_ops"))])
  @@index([legalEntityId])
  @@index([status])
}

// [Nền Hệ thống P1 · US-06] Pháp nhân — TÁCH khỏi đơn vị vận hành (BA §2.3).
// Vì sao tách: học phí thu ở cơ sở nhượng quyền thuộc pháp nhân CỦA HỌ, không phải doanh
// thu của SataRobo. Gắn doanh thu vào orgUnitId thôi là ngày ký hợp đồng đầu tiên phải sửa bảng.
model LegalEntity {
  id        String    @id @default(cuid())
  taxCode   String    @unique // MST — khoá nghiệp vụ thật
  legalName String
  address   String?
  // Đúng MỘT pháp nhân gốc SataRobo. Ép bằng partial unique index (chỉ 1 dòng isPrimary=true).
  isPrimary Boolean   @default(false)
  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  orgUnits OrgUnit[]

  @@index([deletedAt])
}

// ─── A0-02 — RBAC động (Doc 15 §2.2/§2.3) ───
// Role + permission + gán quyền nằm trong DB; admin cấu hình qua UI. can() v2 (A0-03)
// đọc các bảng này. KHÔNG đụng matrix tĩnh permissions.ts / User.role[] (cắt ở Phase C).
enum ScopeType {
  GLOBAL
  CENTER
  CLASS
  OWN
  CHILDREN
  ASSIGNED
}

enum AssignStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model RoleDef {
  id            String           @id @default(cuid())
  code          String           @unique // HO_ACCOUNTANT, CENTER_MANAGER...
  name          String
  isSystem      Boolean          @default(false) // SUPER_ADMIN, PARENT — không xóa/đổi code
  isActive      Boolean          @default(true)
  permissions   RolePermission[]
  userRoles     UserOrgRole[]
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  positionRoles PositionRole[]
}

model RolePermission {
  roleId    String
  action    String // validate qua ACTION_REGISTRY
  scopeType ScopeType
  role      RoleDef   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, action])
  @@index([roleId])
}

// ─── Nền Hệ thống P0 · US-01 — Registry quyền tập trung (TS-01) ───
// Nguồn khai báo: lib/permissions/registry (mỗi module 1 ModuleDecl). Seed nạp lúc
// deploy qua prisma/seed-permission-registry.ts (pnpm db:seed:permissions).
// Key vắng khỏi khai báo → isActive=false, KHÔNG DELETE (giữ vết audit/rollback).
model PermissionDescriptor {
  key             String   @id // vd "leads:view-all" (format v1) — format mới chuẩn hoá ở pha sau
  module          String // module nghiệp vụ sở hữu quyền, vd "crm", "lms"
  action          String // verb thô sau dấu ":"
  scopable        Boolean  @default(true) // quyền có cần data scope không (BA §2.5)
  sensitiveFields String[] @default([])
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  grants PermissionGrant[] // US-02 — grant trỏ về key registry (Restrict: không xoá key còn grant)

  @@index([module])
}

// ─── Nền Hệ thống P0 · US-02 — PermissionGrant (TS-02) ───
// Bảng grant MỚI cho engine can() hợp nhất (lib/permissions/can.ts). Ship RỖNG:
// không grant khớp → fallback NGUYÊN TRẠNG đường cũ (v1/v2/shadow/flag).
// KHÔNG liên quan UserPermissionGrant cũ — engine mới TUYỆT ĐỐI không đọc bảng cũ
// (test ghim [A0-03-T6-02] "grant DENY không làm mất quyền role" phải xanh nguyên trạng).

/// US-02 — chủ thể nhận grant: RoleDef (subjectId = RoleDef.id) hoặc UserGroup (US-03).
enum GrantSubjectType {
  ROLE
  GROUP
}

/// US-02 — phạm vi dữ liệu của grant (BA §2.5). Trước P1 fallback theo centerId (AC3).
enum DataScope {
  ALL
  UNIT_AND_BELOW
  UNIT_ONLY
  OWN
}

model PermissionGrant {
  id            String               @id @default(cuid())
  subjectType   GrantSubjectType
  subjectId     String // polymorphic theo subjectType (RoleDef.id | UserGroup.id US-03) — KHÔNG FK có chủ đích
  // FK về registry (Restrict): không cho grant trỏ key chưa khai báo, không xoá key còn grant.
  permissionKey String
  descriptor    PermissionDescriptor @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  effect        GrantType // ALLOW | DENY — DENY fieldMask rỗng chặn action, KHÁC rỗng chỉ che trường
  dataScope     DataScope
  fieldMask     String[]             @default([]) // rỗng = toàn action; khác rỗng (DENY) = che các trường này
  derivedFrom   String? // vd hợp đồng franchise sinh grant (BA §6 "chừa cột trước" — engine chưa dùng)
  reason        String?              @db.Text // lý do cấp/chặn (audit)
  createdById   String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  @@unique([subjectType, subjectId, permissionKey, effect])
  @@index([subjectType, subjectId])
  @@index([permissionKey])
}

// ─── Nền Hệ thống P0 · US-03 — UserGroup (nhóm người dùng, TS-02) ───
// Nhóm cấp quyền ad-hoc cho ít người mà không sửa vai trò chuẩn: PermissionGrant
// subjectType=GROUP trỏ subjectId = UserGroup.id (polymorphic, không FK — như ROLE).
// SOFT DELETE (deletedAt): nhóm đã xoá → resolveActor bỏ membership → grant của nhóm
// VÔ HIỆU ngay lần resolve kế, KHÔNG cần dọn grant. Grant GROUP ở P0 chỉ nhận
// dataScope ALL|OWN (validator chặn UNIT_* — GROUP không có mapping roleCenterScope
// tới P1, xem [PIN] trong lib/permissions/can.test.ts).
model UserGroup {
  id          String    @id @default(cuid())
  // Unique theo tên CHỈ giữa nhóm còn sống: partial unique index
  // "UserGroup_name_active_key" ON (name) WHERE deletedAt IS NULL — Prisma chưa
  // biểu diễn được partial index nên viết trong SQL migration (20260809160000).
  name        String
  description String?   @db.Text
  deletedAt   DateTime? @db.Timestamptz(6) // SOFT DELETE — nhóm xoá vẫn giữ vết audit
  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  members UserGroupMember[]
}

// Thành viên nhóm — HARD DELETE (gỡ là mất ngay ở lần resolve kế; audit ở RbacAuditLog).
model UserGroupMember {
  userId    String
  groupId   String
  addedById String? // ai thêm (audit nhẹ tại chỗ; vết đầy đủ ở RbacAuditLog)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model UserOrgRole {
  userId        String
  orgUnitId     String
  roleId        String
  effectiveFrom DateTime     @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?    @db.Timestamptz(6) // null = vô thời hạn
  status        AssignStatus @default(ACTIVE)
  grantedById   String // ai cấp (audit)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  role          RoleDef      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, orgUnitId, roleId])
  @@index([userId])
  @@index([orgUnitId])
  @@index([roleId])
}

// Audit cho thay đổi role/permission/assignment (AC4). A0-06 sẽ hợp nhất AuditLog.
model RbacAuditLog {
  id              String   @id @default(cuid())
  entity          String // ROLE | PERMISSION | ASSIGNMENT
  entityId        String
  action          String // CREATE | UPDATE | DELETE | ASSIGN | REVOKE
  changedByUserId String?
  changedByName   String
  oldValues       Json?
  newValues       Json?
  reason          String
  metadata        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([changedByUserId])
  @@index([createdAt])
}

// ─── A0-06 — AuditLog HỢP NHẤT (Doc 15 §8.1) ───
// 1 bảng cho mọi module (thay 8 bảng audit cũ — giữ đọc-only). Immutable: KHÔNG
// có server action update/delete. Viewer scope theo orgUnitId + mask PII theo quyền.
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String? // null = System (cron/dispatcher)
  actorName     String // snapshot tên actor
  module        String // 'rbac','orders','employees',...
  entityType    String
  entityId      String
  action        String // CREATE/UPDATE/DELETE/STATUS_CHANGE/EXPORT/SCOPE_BYPASS...
  oldValues     Json?
  newValues     Json?
  changedFields String[]
  reason        String?
  orgUnitId     String? // để scope viewer theo cơ sở
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@index([orgUnitId, createdAt])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
}

// ─── A0-07 — DomainEvent outbox (Doc 15 §4.5) ───
// Ghi event TRONG transaction nghiệp vụ → dispatcher (cron) gọi handler theo type,
// idempotent + retry. Thêm consumer = 1 dòng on(), không sửa publisher.
model DomainEvent {
  id          String    @id @default(cuid())
  type        String
  payloadJson Json
  status      String    @default("PENDING") // PENDING/PROCESSING/DONE/FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  dedupeKey   String?   @unique // idempotency producer-side
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([type])
}

// ─── A0-08 — EmployeeOrgAssignment (Doc 15 §2.2, OI-6/OI-8/OI-10) ───
// Nhân sự/kiêm nhiệm/lương — KHÔNG sinh quyền (quyền chỉ từ UserOrgRole).
/// P2 · US-08 — KIỂU PHÂN CÔNG VỊ TRÍ (BA §2.4). KHÁC hẳn `AssignmentType` ngay bên
/// dưới: cái đó là phân bổ nhân sự/lương của `EmployeeOrgAssignment` và CỐ Ý KHÔNG sinh
/// quyền; cái này quyết định người đó hưởng bộ quyền của Position nào.
/// Lý do điều động (BA §2.4). Là DỮ LIỆU VẬN HÀNH, không tham gia tính quyền — engine
/// chỉ hỏi "đơn vị nào, trong khoảng nào"; lý do để người duyệt và người tra soát đọc.
enum WorkScopeReason {
  TEACHING
  MAKEUP
  TRIAL
  SUPPORT
}

enum PositionAssignmentKind {
  PRIMARY
  CONCURRENT
  DELEGATED
}

/// P2 · US-08 — VỊ TRÍ CÔNG VIỆC (BA §2.4). Quyền gắn vào VỊ TRÍ, không gắn vào người:
/// người nghỉ → gỡ assignment, vị trí giữ nguyên bộ quyền cho người kế nhiệm.
///
/// `reportsToPositionId` là CÂY THỨ HAI, độc lập cây tổ chức (BA §10): dùng cho luồng
/// duyệt, **KHÔNG** dùng để resolve dataScope. Chống vòng lặp enforce ở tầng ghi
/// (`assertNoReportingCycle`) — Postgres không có ràng buộc đệ quy khai báo được.
model Position {
  id                  String    @id @default(cuid())
  /// Đơn vị TRỰC THUỘC (biên chế) — nơi TÁC NGHIỆP là WorkScope của assignment (US-10).
  orgUnitId           String
  title               String
  isManagerial        Boolean   @default(false)
  reportsToPositionId String?
  isActive            Boolean   @default(true)
  deletedAt           DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  orgUnit     OrgUnit              @relation("PositionOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  reportsTo   Position?            @relation("PositionReportsTo", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  reports     Position[]           @relation("PositionReportsTo")
  roles       PositionRole[]
  assignments PositionAssignment[]

  /// EL-03 — yêu cầu đào tạo theo vị trí. PROD có 0 dòng Position (20/08/2026) nên
  /// ở GƐ1 nhánh này áp cho 0 người — giữ FK vì nó rẻ, không vì nó dùng được ngay.
  trnRequirements TrnRequirement[] @relation("TrnRequirementPosition")

  @@index([orgUnitId, isActive])
  @@index([reportsToPositionId])
}

/// Bộ vai trò của một vị trí. Người nhận assignment vào vị trí hưởng đủ các vai này.
model PositionRole {
  positionId String
  roleId     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  role     RoleDef  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([positionId, roleId])
  @@index([roleId])
}

/// Phân công một NGƯỜI vào một VỊ TRÍ, có thời hạn (US-09 mở rộng ràng buộc PRIMARY).
///
/// ⚠️ TÊN `Assignment` ĐÃ BỊ CHIẾM bởi bài tập LMS (`model Assignment` phía dưới), nên
/// entity của BA mang tên `PositionAssignment`. Đừng đổi lại — đổi là va tên trên toàn
/// bộ Prisma Client.
///
/// KHÔNG xoá lịch sử: hết hiệu lực thì đóng `effectiveTo`, quyền tự tắt vì resolver lọc
/// theo mốc thời gian (US-09 AC2 — không cần cron gỡ tay).
model PositionAssignment {
  id            String                 @id @default(cuid())
  positionId    String
  userId        String
  kind          PositionAssignmentKind @default(PRIMARY)
  effectiveFrom DateTime               @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?              @db.Timestamptz(6)
  status        AssignStatus           @default(ACTIVE)
  note          String?
  createdById   String?
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(6)

  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  user     User     @relation("UserPositionAssignments", fields: [userId], references: [id], onDelete: Cascade)

  workScopes WorkScope[]

  @@index([userId, status])
  @@index([positionId, status])
}

/// P2 · US-10 — NƠI TÁC NGHIỆP, tách khỏi NƠI TRỰC THUỘC (BA §2.4).
///
/// Giáo viên biên chế phòng Đào tạo (Hội sở) được điều xuống CS1 dạy: `Position.orgUnitId`
/// giữ nguyên (biên chế không đổi), `WorkScope` mở đúng CS1 trong đúng khoảng thời gian.
/// Đổi cơ sở dạy = sửa WorkScope, KHÔNG đụng vai trò hay quyền.
///
/// ⚠️ WorkScope KHÔNG cấp quyền — nó chỉ NỚI PHẠM VI DỮ LIỆU của những vai người đó ĐÃ có
/// qua phân công này. Giáo viên được điều sang CS1 vẫn chỉ là giáo viên ở CS1, và vẫn chỉ
/// thấy lớp mình được phân công (quyền lớp của họ vốn scope ASSIGNED).
///
/// ⚠️ KHÔNG có cột `status`: "còn hiệu lực" ở đây là một KHOẢNG THỜI GIAN. Thêm cờ song
/// song là đẻ nguồn sự thật thứ hai — bài học US-09. Kết thúc điều động = đóng `effectiveTo`.
model WorkScope {
  id            String          @id @default(cuid())
  assignmentId  String
  orgUnitId     String
  reason        WorkScopeReason
  effectiveFrom DateTime        @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?       @db.Timestamptz(6)
  note          String?
  createdById   String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  assignment PositionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  orgUnit    OrgUnit            @relation("WorkScopeOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([orgUnitId])
}

enum AssignmentType {
  PRIMARY
  SECONDARY
  SUPPORT
  SUBSTITUTE
  SHARED
}

model EmployeeOrgAssignment {
  id                String         @id @default(cuid())
  employeeId        String
  orgUnitId         String
  roleInOrg         String? // mô tả vai trò nghiệp vụ (KHÔNG phải RoleDef)
  assignmentType    AssignmentType
  effectiveFrom     DateTime       @default(now()) @db.Timestamptz(6)
  effectiveTo       DateTime?      @db.Timestamptz(6)
  status            AssignStatus   @default(ACTIVE)
  allocationPercent Int? // 0..100 — phân bổ chi phí/lương
  createdById       String
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  @@index([employeeId, status])
  @@index([orgUnitId, status])
}

// ─── R1-01 — CRM Messenger (SR.QD.217, Doc 15 §5) ───
// Page HO/CS → hội thoại → message. centerId để scopedDb cách ly (C1.4).
model FacebookPageMapping {
  id        String      @id @default(cuid())
  pageId    String      @unique
  pageName  String?
  scopeType OrgUnitType // HO | CENTER (validate ở service)
  centerId  String? // chỉ khi scopeType=CENTER
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([scopeType])
  @@index([orgUnitId])
}

model MessengerConversation {
  id             String             @id @default(cuid())
  pageId         String
  psid           String // page-scoped user id
  parentName     String?
  phone          String?
  status         String             @default("OPEN") // OPEN/QUALIFIED/CLOSED
  centerId       String? // suy từ page mapping → scopedDb
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  firstMessageAt DateTime?          @db.Timestamptz(6)
  respondedAt    DateTime?          @db.Timestamptz(6)
  leadId         String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  messages       MessengerMessage[]

  @@unique([pageId, psid])
  @@index([centerId])
  @@index([status])
  @@index([leadId])
  @@index([orgUnitId])
}

model MessengerMessage {
  id              String                @id @default(cuid())
  conversationId  String
  direction       String // IN | OUT
  text            String?               @db.Text
  attachments     Json?
  externalEventId String?               @unique // idempotency webhook (R1-02 C2.4)
  sentAt          DateTime              @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  conversation    MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

// R1-10 — Bảng hoa hồng theo kỳ (SR.QD.217, tiền). DRAFT→APPROVED→REOPENED.
enum CommissionStatus {
  DRAFT
  APPROVED
  REOPENED
}

model CommissionStatement {
  id           String           @id @default(cuid())
  period       String           @unique // "2026-06"
  status       CommissionStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  lines        CommissionLine[]
}

model CommissionLine {
  id          String              @id @default(cuid())
  statementId String
  recipientId String // user hưởng hoa hồng
  tier        String // QC | SALE_ADMIN | SALE | QL_TT | TRIAL_TEACHER
  amount      Int // VND; âm = clawback
  isClawback  Boolean             @default(false)
  leadId      String?
  statement   CommissionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  // Site GV 25/08 — hoa hồng GV dạy trial (tier TRIAL_TEACHER, 1% học phí khi học viên
  // học thử NHẬP HỌC). Khác 4 tầng Sale ở chỗ nó sinh TỪNG DÒNG theo ghi danh, ngay
  // trong transaction convert — nên cần khoá chống ghi trùng khi convert bị chạy lại.
  // 4 tầng Sale không dùng 2 cột này (setStatementLines ghi lại cả kỳ, tự nhất quán).
  enrollmentId String?
  note         String?

  @@unique([statementId, tier, recipientId, enrollmentId])
  @@index([statementId])
  @@index([recipientId])
  @@index([enrollmentId])
}

// R6-F2 — Bản ghi LỆCH giữa can() v1 (matrix) và v2 (DB actor) khi shadow-run.
// Mục tiêu: report = 0 trong N ngày → an toàn bật RBAC_V2_ENABLED. Chỉ ghi khi LỆCH.
/// P3 · US-12 — lệch giữa resolver dataScope CŨ (đo centerId) và MỚI (đo orgUnitId).
///
/// BẢNG RIÊNG, không dùng chung `RbacShadowDiff`: bảng kia so `can()` v1↔v2 và có một
/// cổng đang đọc nó (`isSafeToEnableRbacV2`). Trộn hai phép so vào một bảng làm cả hai
/// báo cáo mất nghĩa và cổng kia đếm nhầm.
///
/// `ketQua` có BA giá trị chứ không phải hai: ngoài `LECH` còn `CHUA_PHU` — chỗ gọi
/// chưa truyền `orgUnitId` nên không so được. Đếm riêng vì đó là ĐỘ PHỦ, không phải
/// lỗi; và vì coi nó là lệch thì cổng 7 ngày sẽ không bao giờ xanh vì lý do sai.
model ScopeShadowDiff {
  id              String   @id @default(cuid())
  /// LECH | CHUA_PHU — `GIONG` KHÔNG ghi (ghi mọi request là tự DDoS chính mình).
  ketQua          String
  permissionKey   String
  /// "grant" (bảng PermissionGrant P0) hay "perm" (đường cũ đang enforce) — biết
  /// shadow phủ được nhánh nào.
  nguon           String
  userId          String
  /// Kết quả đường CŨ (đang chạy thật). Đây là thứ người dùng thực sự nhận được.
  cu              Boolean
  /// Kết quả đường MỚI; null khi `CHUA_PHU`.
  moi             Boolean?
  /// Ngữ cảnh đủ để TÁI HIỆN (AC2) — không phải chỉ để đếm.
  roleId          String?
  targetCenterId  String?
  targetOrgUnitId String?
  /// Đơn vị của dòng log (luật cứng #3). = targetOrgUnitId khi có, để lọc theo đơn vị.
  orgUnitId       String?
  lyDo            String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([ketQua, createdAt])
  @@index([permissionKey])
  @@index([orgUnitId])
}

model RbacShadowDiff {
  id        String   @id @default(cuid())
  action    String
  userId    String
  v1        Boolean
  v2        Boolean
  targetKey String? // mô tả target (centerId/classId...) để truy vết
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([action])
}

// R6-B1 — Tỉ lệ hoa hồng theo kỳ trong DB (thay hằng số DEFAULT_RATES).
// Mỗi tier có chuỗi version theo effectiveFrom/To; rate hiệu lực = row phủ thời điểm
// đóng đơn. Trần Σ rate ≤ 8% enforce khi ghi. SUPER_ADMIN sửa + audit + reason.
model CommissionRateConfig {
  id            String    @id @default(cuid())
  tier          String // QC | SALE_ADMIN | SALE | QL_TT
  rate          Float // 0..1
  effectiveFrom DateTime  @db.Timestamptz(6)
  effectiveTo   DateTime? @db.Timestamptz(6) // null = đang hiệu lực
  reason        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tier, effectiveFrom])
}

// R1-12 — Báo cáo marketing tuần/tháng (snapshot) của QL TT (SR.QD.217 C12.2).
enum ReportPeriodType {
  WEEK
  MONTH
}

model MarketingReport {
  id            String           @id @default(cuid())
  periodType    ReportPeriodType
  periodKey     String // "2026-W23" | "2026-06"
  submittedById String
  snapshot      Json
  submittedAt   DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([periodType, periodKey, submittedById])
  @@index([periodType, periodKey])
}

// R1-09 — Kỳ phân bổ chi phí marketing (SR.QD.217). DRAFT→CONFIRMED→REOPENED.
enum CostPeriodStatus {
  DRAFT
  CONFIRMED
  REOPENED
}

model MarketingCostPeriod {
  id            String           @id @default(cuid())
  period        String           @unique // "2026-06"
  totalQcCost   Int              @default(0) // VND (số nguyên) — H5/COL2
  status        CostPeriodStatus @default(DRAFT)
  confirmedById String?
  confirmedAt   DateTime?        @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
}

// R1-07 — Ads Insights theo ngày/kênh (SR.QD.217, CPL/CPA/ROAS). unique (date,channel).
model AdsInsightDaily {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  channel     String // "facebook" | "google" | "manual" ...
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  source      String   @default("META_API") // META_API | MANUAL
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([date, channel])
  @@index([date])
}

// R3-06 — Đồng ý dùng hình ảnh học viên (privacy-first, Doc 15 §8.3).
enum ConsentType {
  CLASS_MEDIA
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model StudentConsent {
  id        String        @id @default(cuid())
  studentId String
  type      ConsentType
  status    ConsentStatus @default(GRANTED)
  grantedAt DateTime      @default(now()) @db.Timestamptz(6)
  revokedAt DateTime?     @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)

  @@unique([studentId, type])
  @@index([studentId])
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Room {
  id           String     @id @default(cuid())
  name         String
  code         String
  centerId     String
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center       Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  capacity     Int        @default(15)
  equipment    String[]   @default([])
  status       RoomStatus @default(ACTIVE)
  notes        String?    @db.Text
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)

  classes       Class[]
  trialClasses  TrialClass[]
  classSessions ClassSession[] // W2-4b — phòng theo buổi

  @@unique([centerId, code])
  @@index([centerId, status])
  @@index([orgUnitId])
}

enum HolidayType {
  HOLIDAY
  MAINTENANCE
  EVENT
  OTHER
}

model Holiday {
  id        String      @id @default(cuid())
  name      String
  date      DateTime    @db.Date
  endDate   DateTime?   @db.Date
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center?     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  type      HolidayType @default(HOLIDAY)
  note      String?     @db.Text
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)

  @@index([date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

model User {
  id              String    @id @default(cuid())
  name            String?
  // AUTH-SĐT P3 — email nới nullable (P5 sẽ tạo phụ huynh chỉ có SĐT); GIỮ unique.
  // Nhân sự vẫn BẮT BUỘC email ở tầng validator (QĐ-C) — không phải ở DB.
  email           String?   @unique
  emailVerified   DateTime? @db.Timestamptz(6)
  // AUTH-SĐT P3 — SĐT làm khoá đăng nhập, LUÔN dạng canonical 84XXXXXXXXX
  // (lib/phone.ts). KHÔNG backfill trong migration — unique index trên toàn
  // NULL không thể fail trên prod; backfill là script riêng ở P5.
  phone           String?   @unique
  phoneVerifiedAt DateTime? @db.Timestamptz(6)
  password        String?
  image           String?
  role            Role      @default(SALES_CSM) // Đợt 3B — vai trò CHÍNH (primary)
  roles           Role[]    @default([]) // Đợt 3B — tất cả vai trò người này giữ (union quyền)
  centerId        String?
  orgUnitId       String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  isActive        Boolean   @default(true)
  deletedAt       DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  // ─── Per-user permission system (Phase 5.3.0) ───
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime? @db.Timestamptz(6)

  // Cụm A1 — trạng thái kích hoạt tài khoản (phụ huynh tạo qua chuyển lead).
  accountStatus AccountStatus @default(ACTIVE)

  // BGĐ 31/07 — cấp/reset MK bởi admin → bắt đổi MK ngay lần đăng nhập kế tiếp
  // (layout admin/teacher redirect /doi-mat-khau khi cờ bật).
  mustChangePassword Boolean @default(false)

  // FIX lead→payment→enroll (M0) — CCCD + địa chỉ phụ huynh (lưu trên User, KHÔNG trên Student).
  cccd    String? // CCCD/CMND phụ huynh
  address String?
  ward    String? // phường/xã (cơ cấu 2 cấp 2025)
  city    String? // tỉnh/thành

  // Link 1-1 với Employee (1 user account ↔ 1 employee record)
  employeeId String?   @unique
  employee   Employee? @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  center             Center?             @relation(fields: [centerId], references: [id])
  accounts           Account[]
  children           Student[]           @relation("ParentChildren")
  assignedLeads      Lead[]              @relation("AssignedLeads")
  // T3.2 — Sale phụ trách học viên, gắn ở cấp GHI DANH (theo lớp) chứ không phải
  // Student: 1 HV học nhiều khoá/lớp có thể do sale khác chăm (QĐ-7).
  saleEnrollments    Enrollment[]        @relation("EnrollmentSale")
  notes              Note[]
  teacherClass       Class[]             @relation("TeacherClasses")
  assistantClass     Class[]             @relation("AssistantClasses")
  teacherProfile     TeacherProfile?     @relation("UserTeacherProfile") // FIX 10
  shiftRegistrations ShiftRegistration[] // Đợt 3E
  teacherReviews     TeacherReview[]     @relation("TeacherReviewer") // FIX 10 — đánh giá nội bộ do user này tạo
  trialClasses       TrialClass[]        @relation("TrialTeacher")
  jobPostings        JobPosting[]

  honorsCreated      Honor[]           @relation("HonorCreatedBy")
  pageContentUpdated SitePageContent[] @relation("PageContentUpdatedBy")
  employeesCreated   Employee[]        @relation("EmployeeCreatedBy")

  permissionGrants   UserPermissionGrant[] @relation("UserPermissionGrants")
  permissionsGranted UserPermissionGrant[] @relation("UserPermissionGrantor")

  // Nền Hệ thống P0 · US-03 — nhóm người dùng (một người thuộc nhiều nhóm).
  groupMemberships UserGroupMember[]

  // Phase 5.4.0 — Audit log relations
  auditLogs           UserAuditLog[]            @relation("UserAuditLogs")
  grantAuditLogs      PermissionGrantAuditLog[] @relation("UserGrantAudits")
  positionAssignments PositionAssignment[]      @relation("UserPositionAssignments")

  /// EL-03 — bằng chứng đã được thông báo phạm vi dữ liệu thu thập (QĐ-CDA-12).
  trnPolicyAcceptances TrnPolicyAcceptance[] @relation("TrnPolicyAcceptanceUser")

  @@index([email])
  @@index([phone])
  @@index([centerId])
  @@index([role])
  @@index([deletedAt])
  @@index([orgUnitId])
}

model UserPermissionGrant {
  id        String    @id @default(cuid())
  userId    String
  action    String // e.g. "leads:edit", phải match Action union trong lib/auth/permissions.ts
  grant     GrantType
  reason    String?   @db.Text
  grantedBy String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  user    User @relation("UserPermissionGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantor User @relation("UserPermissionGrantor", fields: [grantedBy], references: [id])

  @@unique([userId, action])
  @@index([userId])
  @@index([grantedBy])
}

// Đợt 3D — 2 danh mục khoá học (nguồn chân lý nghiệp vụ).
enum CourseCategory {
  LUYEN_THI_ROBOSIM
  LAP_TRINH_ROBOT
}

// R6-B3 — Danh mục khoá học dạng MODEL (thêm danh mục không sửa code). 2-phase: enum
// CourseCategory + Course.category giữ; thêm Course.categoryId trỏ model. code khớp enum (T12).
model CourseCategoryDef {
  id           String   @id @default(cuid())
  code         String   @unique // khớp enum cũ khi backfill (LAP_TRINH_ROBOT...)
  name         String
  slug         String?  @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  courses Course[] @relation("CourseCategoryDef")
}

model Course {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  type        CourseType @default(OFFLINE)
  description String?    @db.Text
  price       Int?
  duration    Int?
  isActive    Boolean    @default(true)
  // R7-03 — phân loại độ tuổi / trình độ cho khóa dạy.
  ageRange    String? // vd "6-8 tuổi"
  level       String? // vd "Cơ bản"

  // Marketing fields (Phase 4.UI.FINAL)
  code             String? // Code ngắn cho product cards (vd. "LTR", "LTRS")
  shortDescription String? @db.Text
  priceDisplay     String? // "2,400,000đ" hoặc "Liên hệ"

  // Đợt 3D — phân loại danh mục + cờ "khoá cụ thể dùng để mở lớp/giảng dạy".
  category        CourseCategory? // null = không phải khoá dạy (vd mục landing cũ LTR/LTRS)
  // R6-B3 — danh mục dạng model (2-phase, song song enum `category`).
  categoryId      String?
  categoryDef     CourseCategoryDef? @relation("CourseCategoryDef", fields: [categoryId], references: [id])
  isTeachable     Boolean            @default(false)
  // Đợt 6 — số buổi CHUẨN (cam kết) của khoá; ưu tiên hơn đếm Curriculum lessons.
  totalSessions   Int?
  durationDisplay String? // "6 tháng" hoặc "Tuỳ chỉnh"
  studentCount    Int                @default(0)
  displayOrder    Int                @default(0)
  isPublished     Boolean            @default(true)

  thumbnail String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  leads            Lead[]
  expectedByLeads  Lead[]           @relation("LeadExpectedCourse") // G2 — khoá dự kiến của lead
  classes          Class[]
  enrollments      Enrollment[]
  curriculums      Curriculum[]
  discounts        CourseDiscount[] // R7-03
  trialRecommended TrialFeedback[]  @relation("TrialRecommendedCourse")

  // FIX 7 — khoá tiên quyết (cấu hình qua UI admin).
  prerequisites     CoursePrerequisite[] @relation("CoursePrereqOwner")
  requiredByCourses CoursePrerequisite[] @relation("CoursePrereqRequired")

  // FIX 10 — khoá GV dạy được.
  teacherCourses TeacherCourse[]
  completions    CourseCompletion[] @relation("CourseCompletions")

  // R7 — lộ trình chuyển cấp: khoá kế tiếp (vd Sata 3 → Sata 4). Self-relation, cấu
  // hình admin; hoàn thành khoá gợi ý "Chuyển sang".
  nextCourseId String?
  nextCourse   Course?  @relation("CourseProgression", fields: [nextCourseId], references: [id], onDelete: SetNull)
  prevCourses  Course[] @relation("CourseProgression")

  // FL W0 — gộp gói bán (FL1-05) + kho câu hỏi theo khoá (FL1-03).
  coursePackages CoursePackage[]
  questions      Question[]

  @@index([slug])
  @@index([type])
  @@index([code])
  @@index([isPublished, displayOrder])
}

// FIX 7 — Khoá tiên quyết: khoá `courseId` yêu cầu hoàn thành `requiredCourseId`
// trước khi đăng ký. Nhiều-nhiều tự tham chiếu trên Course; admin tự thêm/xoá
// qua UI (không sửa code). 1 khoá có thể yêu cầu ≥1 khoá trước.
model CoursePrerequisite {
  id               String   @id @default(cuid())
  courseId         String
  requiredCourseId String
  course           Course   @relation("CoursePrereqOwner", fields: [courseId], references: [id], onDelete: Cascade)
  requiredCourse   Course   @relation("CoursePrereqRequired", fields: [requiredCourseId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([courseId, requiredCourseId])
  @@index([courseId])
  @@index([requiredCourseId])
}

// FIX 10 — Hồ sơ chuyên môn giáo viên (1-1 với User role TEACHER).
enum TeacherRank {
  TRAINEE
  JUNIOR
  ADVANCED
  SENIOR
  EXPERT
}

enum EmploymentType {
  FULLTIME
  PARTTIME
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model TeacherProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation("UserTeacherProfile", fields: [userId], references: [id], onDelete: Cascade)
  rank           TeacherRank    @default(TRAINEE)
  employmentType EmploymentType @default(PARTTIME)
  status         TeacherStatus  @default(ACTIVE)
  bio            String?        @db.Text

  teachableCourses TeacherCourse[]
  reviews          TeacherReview[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

// Khoá GV dạy được (n-n TeacherProfile ↔ Course).
model TeacherCourse {
  teacherProfileId String
  courseId         String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, courseId])
  @@index([courseId])
}

// Đánh giá nội bộ / dự giờ (PHẦN 6).
model TeacherReview {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  reviewerId       String?
  reviewer         User?          @relation("TeacherReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName     String
  score            Int // 1-5
  note             String?        @db.Text
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)

  @@index([teacherProfileId, createdAt])
}

model Lead {
  id               String     @id @default(cuid())
  parentName       String
  /// Có thể là chuỗi RỖNG: biểu mẫu /nhap-khach-hang (22/08/2026) không bắt buộc
  /// ô nào, mà lead từ quảng cáo Facebook rất hay chỉ có link FB chưa có số.
  /// KHÔNG nới cột sang nullable (mọi đường đọc đang giả định string) — "" là
  /// giá trị "chưa có số", và `phoneVariants("")` trả [] nên dedup tự bỏ qua.
  phone            String
  email            String?
  /// Link Facebook/Messenger của phụ huynh — lead chạy quảng cáo FB thường có
  /// link trước khi có số. Ô này là đường liên hệ THẬT, không phải ghi chú.
  facebookUrl      String?
  childName        String?
  childAge         Int?
  centerId         String?
  orgUnitId        String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  courseId         String?
  assignedToId     String?
  // 23/08/2026 — NGƯỜI NHẬP phiếu. Khác `assignedToId` (người CHĂM): phiếu do
  // Sale Hội sở nhập vẫn tự chia về Sale cơ sở, nhưng người nhập phải theo được
  // phiếu của mình. Trước đó danh tính người nhập chỉ nằm dưới dạng CHỮ trong
  // `note` ("Nhân viên nhập: HO.KD.001") — không lọc được, nên không dựng nổi
  // luật "chỉ thấy phiếu mình nhập".
  //
  // Cột TRẦN, không FK — cùng tiền lệ `orgUnitId` (PR-A). Chỉ so bằng với
  // `actor.userId`; muốn tên người nhập thì tra `User` riêng.
  // NULL = phiếu cũ, hoặc phiếu vào từ webhook (không có phiên đăng nhập).
  createdById      String?
  // #11 T1 (câu 10 BGĐ, Kiệt ký 10/07): "dùng chung" — CSKH cùng CƠ SỞ thấy lead này
  // (đọc mở rộng OR isSharedWithTeam=true, cách ly cơ sở vẫn do scopedDb). Chỉ owner
  // (assignee) hoặc CENTER_MANAGER bật/tắt; sharedById = ai bật (không FK — chỉ hiển thị).
  isSharedWithTeam Boolean    @default(false)
  sharedAt         DateTime?  @db.Timestamptz(6)
  sharedById       String?
  status           LeadStatus @default(MOI)
  source           String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  fbclid           String?
  gclid            String?
  fbp              String?
  fbc              String?
  eventId          String?    @unique
  landingPage      String?
  referrer         String?
  ipAddress        String?
  userAgent        String?    @db.Text
  consentMarketing Boolean    @default(false)
  note             String?    @db.Text
  handoverNote     String?    @db.Text // Module CRM PHẦN 3 — note bàn giao gần nhất (nổi bật)
  // Cụm A3 — ai/khi nào chuyển lead sang ĐÃ ĐĂNG KÝ.
  convertedById    String?
  convertedAt      DateTime?  @db.Timestamptz(6)

  // R1-04/05 — mốc thời gian phễu SR.QD.217 (L1→L2→L3 + bàn giao + SLA).
  qualifiedAt         DateTime?         @db.Timestamptz(6) // L2 — có SĐT + note
  handedAt            DateTime?         @db.Timestamptz(6) // HO bàn giao về CS
  receivedConfirmedAt DateTime?         @db.Timestamptz(6) // CS xác nhận tiếp nhận
  assignedAt          DateTime?         @db.Timestamptz(6) // phân Sale
  firstContactAt      DateTime?         @db.Timestamptz(6) // Sale liên hệ lần đầu
  commissionSource    CommissionSource? // nguồn để chia hoa hồng
  adminId             String? // Sale Admin xử lý L1→L2

  // BGĐ 31/07 — NGUỒN GIỚI THIỆU (affiliate): ai giới thiệu ra lead này.
  // Gán tự động khi khách vào site qua link `?ref=<code>`, hoặc admin chọn tay.
  affiliateId String?
  affiliate   Affiliate? @relation("AffiliateLeads", fields: [affiliateId], references: [id], onDelete: SetNull)

  // FIX lead→payment→enroll (M0/LD1) — loại đơn dự kiến (gợi ý nguồn item khi tạo đơn).
  orderKind OrderKind?

  // G2 — sản phẩm/khoá học DỰ KIẾN theo loại đơn (tách khỏi courseId="Khoá quan tâm").
  // optional: chỉ là gợi ý khi tạo đơn; orderKind=COURSE → expectedCourseId, =PRODUCT → expectedProductId.
  expectedCourseId  String?
  expectedProductId String?

  /// ─── Chia lead (29/08/2026) ──────────────────────────────────────────────
  /// Đường nào đưa lead này tới chủ của nó. Null = lead có TRƯỚC ngày đổi, không
  /// suy ngược được — đừng đoán.
  assignmentSource LeadAssignSource?
  /// Người THAO TÁC gán (quản lý giao tay). Null khi máy chia.
  assignedById     String?
  /// LẦN NHẬP GẦN NHẤT. Khác `createdAt`: khách gọi lại/điền form lại thì không
  /// đẻ lead mới (trùng SĐT), nhưng mốc này nhảy — nếu không, phiếu nóng trông
  /// y hệt phiếu nguội ba tháng.
  lastInboundAt    DateTime?         @db.Timestamptz(6)
  /// Đã vào hệ thống bao nhiêu lần (kể cả các lần bị chặn vì trùng).
  inboundCount     Int               @default(1)

  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  center          Center?  @relation(fields: [centerId], references: [id])
  course          Course?  @relation(fields: [courseId], references: [id])
  expectedCourse  Course?  @relation("LeadExpectedCourse", fields: [expectedCourseId], references: [id])
  expectedProduct Product? @relation("LeadExpectedProduct", fields: [expectedProductId], references: [id])
  assignedTo      User?    @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes           Note[]

  // Phase T1.2 — Activity timeline + follow-up tasks
  activities LeadActivity[]
  tasks      LeadTask[]

  // Phase T1.3 — chống trùng
  duplicates LeadDuplicate[] @relation("LeadDuplicates")

  // Phase T1.4 — học thử
  trialClasses TrialClass[]

  // Phase 5.4.0 — Audit log
  auditLogs LeadAuditLog[] @relation("LeadAuditLogs")

  // Phase 5.6 — Order
  orders            Order[]                 @relation("LeadOrders")
  assignmentHistory LeadAssignmentHistory[]

  // R7-01 — LeadChild (N con) + mốc hoạt động gần nhất cho SLA idle.
  children       LeadChild[]
  lastActivityAt DateTime?   @db.Timestamptz(6) // cập nhật khi có LeadActivity; SLA lead_idle_24h đọc field này

  // ─── GĐ1 — sổ trạng thái ───────────────────────────────────────────────────
  /// Mốc lần đổi trạng thái GẦN NHẤT. Có cột này thì nhắc việc mới đo được "nằm im
  /// bao lâu ở bậc hiện tại"; trước GĐ1 mọi cảnh báo đọc `updatedAt`, mà mọi thao
  /// tác chạm lead đều dời `updatedAt` nên lead nằm im 10 ngày vẫn không lên chuông.
  ///
  /// `@default(now())` là mốc đổi trạng thái ĐẦU TIÊN (lúc lead ra đời ở bậc "Mới").
  /// Không có nó thì mọi lead mới sinh ra với `statusChangedAt = NULL`: không đường
  /// `lead.create` nào trong repo set field này, mà chúng nằm rải nhiều nơi (form
  /// admin, import Excel, webhook, biểu mẫu công khai) nên sửa từng chỗ là chắc chắn
  /// sót. Đặt default ở DB thì mọi đường ghi — kể cả SQL thô — đều có dòng sổ đầu.
  /// ⚠️ Vẫn để NULLABLE: lead CŨ có trước GĐ1 không suy ngược được mốc đó, và
  /// migration cố ý KHÔNG backfill (xem ghi chú trong 20260825120000).
  statusChangedAt DateTime?   @default(now()) @db.Timestamptz(6)
  /// Lead rơi khỏi phễu ở BẬC NÀO (trạng thái ngay trước khi sang DANG_NUOI_DUONG
  /// hoặc mất). NULL với toàn bộ lead cũ — không suy ngược được, đừng bịa.
  droppedAtStage  LeadStatus?
  /// LÝ DO RỚT ở cấp PHỤ HUYNH — ô ghi chú TỰ DO, không danh mục.
  ///
  /// Trạng thái rớt thì theo TỪNG CON (`LeadChild.status = LOST`) — hai tầng khác nhau,
  /// cố ý. Hệ quả đã biết: hai con rớt vì hai lý do khác nhau ⇒ lượt ghi sau ĐÈ lượt
  /// trước; lý do của từng con tra ở `AuditLog` + `LeadActivity`.
  lostNote        String?     @db.Text
  lostAt          DateTime?   @db.Timestamptz(6)
  /// 27/08/2026 — cột `dropReason` ĐÃ GỠ. Lý do rơi nay dùng chung `lostNote`/`lostAt`
  /// ở trên: hai cột cùng trả lời "vì sao phiếu này rụng", mà `lostNote` đã là một
  /// tính năng chạy thật (đánh dấu rớt theo TỪNG CON, bảng "Lead rớt" ở dashboard
  /// QLCS, nhãn trong lịch sử) còn `dropReason` chỉ có đúng một người đọc.
  /// `droppedAtStage` giữ nguyên — nó trả lời câu KHÁC: rụng ở BẬC nào.

  statusHistory LeadStatusHistory[]

  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@index([centerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([eventId])
  @@index([orgUnitId])
  @@index([expectedCourseId])
  @@index([expectedProductId])
  @@index([affiliateId]) // BGĐ 31/07 — báo cáo lead theo người giới thiệu
  // IDX-2: trang leads (Kanban + table) page/order theo createdAt DESC dưới scope centerId
  // → composite cho index-ordered rows (bỏ sort + OFFSET scan). Bảng high-growth.
  @@index([centerId, status, createdAt])
  @@index([createdById])
}

/// GĐ1 — SỔ ĐỔI TRẠNG THÁI LEAD. Một dòng cho MỖI lần trạng thái đổi thật.
///
/// Vì sao cần bảng riêng dù đã có `LeadActivity` loại STATUS_CHANGE: activity là
/// dòng thời gian cho NGƯỜI ĐỌC, ai cũng chèn được, kiểu nội dung tự do, và hai
/// đường ghi của module học thử chưa bao giờ ghi vào đó. Tỷ lệ chuyển đổi từng
/// chặng phải tính từ một bảng có cấu trúc chặt, không suy từ trạng thái hiện tại
/// (suy như vậy thì lead đã rớt biến mất khỏi mọi bậc, mẫu số sai).
///
/// KHÔNG có FK tới User: `changedById` có thể là null khi hệ thống tự đổi (cron,
/// webhook, tiến độ điểm danh) và ta không muốn xoá user làm cascade mất lịch sử.
model LeadStatusHistory {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// NULL = dòng đầu tiên của lead (lúc tạo), không có bậc trước.
  fromStatus LeadStatus?
  toStatus   LeadStatus

  /// Ai đổi. NULL = hệ thống tự đổi. `changedByName` là ảnh chụp tên tại thời điểm
  /// đổi — đổi tên nhân sự sau này không viết lại lịch sử.
  changedById   String?
  changedByName String?

  /// Đổi từ đâu: "admin" | "assign" | "auto-assign" | "trial" | "payment" |
  /// "convert" | "import" | "handover". Dùng để tách số liệu do người làm và do máy chạy.
  source String

  /// Lý do (khi rơi khỏi phễu). Chép sang `Lead.lostNote` ở cùng giao dịch — nhưng
  /// CHỈ khi lượt này thật sự mang lý do, xem `lib/leads/set-status.ts`.
  reason String?

  centerId  String? // cách ly cơ sở (scopedDb)
  /// Cột SONG SONG với centerId theo P1 · US-07. Cột trần, không FK.
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([leadId, createdAt])
  @@index([toStatus, createdAt])
  @@index([centerId])
  @@index([orgUnitId])
}

// BGĐ 31/07 — NGƯỜI/ĐỐI TÁC GIỚI THIỆU (affiliate).
//
// Mỗi affiliate có 1 MÃ duy nhất; link `satarobo.vn/...?ref=<code>` đưa khách vào
// site sẽ gắn lead về đúng người. Cũng gán tay được ở màn Lead.
//
// ⚠️ Hoa hồng affiliate: mức % + thời điểm chốt trả CHƯA có quy chế (chờ BGĐ) —
// model này chỉ ghi NGUỒN + tỉ lệ tham chiếu; KHÔNG tự sinh phiếu chi.
model Affiliate {
  id        String  @id @default(cuid())
  /// Mã giới thiệu dùng trong link `?ref=` — chữ HOA + số, không dấu.
  code      String  @unique
  name      String
  /// Liên hệ để đối soát (không bắt buộc).
  phone     String?
  email     String?
  /// Phụ huynh/HV giới thiệu có thể gắn về tài khoản User (không bắt buộc).
  userId    String?
  /// Cơ sở phụ trách theo dõi (null = toàn hệ thống).
  centerId  String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  /// Tỉ lệ hoa hồng tham chiếu (%) — dùng để đối soát tay tới khi có quy chế.
  commissionPercent Float?
  isActive          Boolean @default(true)
  note              String? @db.Text

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  leads Lead[] @relation("AffiliateLeads")

  @@index([isActive])
  @@index([centerId])
  @@index([orgUnitId])
}

/// R7-01 — 1 Lead có N con. Nền cho lớp trải nghiệm (R7-02). Field phẳng cũ
/// (Lead.childName/childAge) giữ đọc-only (2-phase, KHÔNG drop).
model LeadChild {
  id                 String               @id @default(cuid())
  leadId             String
  lead               Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fullName           String
  dob                DateTime?            @db.Date
  ageYears           Int?
  gender             String?
  schoolName         String?
  gradeLevel         String?
  interestedCourseId String? // tham chiếu Course (không ràng FK cứng — additive)
  interestedCenterId String? // tham chiếu Center
  note               String?              @db.Text
  trialStatus        LeadChildTrialStatus @default(NONE)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)

  trialEnrollments TrialEnrollment[] // R7-02
  enrollments      Enrollment[] // R7-06 — enrollment chính thức convert từ con này
  trialHistory     LeadTrialHistory[] // FL-R2 — lịch sử đã từng học thử

  @@index([leadId])
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  leadId    String
  authorId  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

enum StudentStatus {
  ACTIVE // Đang học
  PAUSED // Bảo lưu (tạm nghỉ)
  GRADUATED // Hoàn thành khoá học
  INACTIVE // Nghỉ học hẳn
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
  UNKNOWN
}

model Student {
  id          String    @id @default(cuid())
  name        String
  studentCode String?   @unique
  dateOfBirth DateTime? @db.Timestamptz(6)
  gender      Gender?
  phone       String?
  email       String?
  avatarUrl   String?

  // Education
  currentGrade Int?
  school       String?

  // Parent / Guardian
  // parentName + parentPhone stay nullable in the DB for the existing rows
  // (some seeded students lack them). Zod requires them at write time.
  parentName       String?
  parentPhone      String?
  parentEmail      String?
  parentRelation   String?
  parentNationalId String? // CCCD phụ huynh (#15 câu 32) — CHỈ CCCD PH; PII: mask + audit khi xem
  parent2Name      String?
  parent2Phone     String?
  parent2Relation  String?

  // Address
  address  String?
  ward     String?
  district String?
  city     String?

