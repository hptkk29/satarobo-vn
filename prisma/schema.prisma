generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  MANAGER
  HR
  SALES
  TEACHER
  MARKETING
  ACCOUNTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  ENROLLED
  NURTURING
  LOST
}

enum CourseType {
  ONLINE
  OFFLINE
  HYBRID
}

enum EnrollmentStatus {
  // Legacy (kept for back-compat with existing rows)
  ACTIVE
  CANCELLED

  // D5 workflow
  PENDING
  CONFIRMED
  STUDYING
  PAUSED
  COMPLETED
  WITHDREW
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
  PAUSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

// ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Business ───────────────────────────────────────────────────────────

model Center {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  address      String
  ward         String?
  district     String?
  city         String   @default("")
  phone        String?
  email        String?
  googleMapUrl String?  @db.Text
  workingHours String?
  managerName  String?
  logoUrl      String?
  bannerUrl    String?
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users     User[]
  leads     Lead[]
  classes   Class[]
  students  Student[]
  studentsPreferred Student[] @relation("StudentPreferredCenter")
  employees Employee[]
  rooms     Room[]
  holidays  Holiday[]

  @@index([isActive])
  @@index([displayOrder])
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Room {
  id           String     @id @default(cuid())
  name         String
  code         String
  centerId     String
  center       Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  capacity     Int        @default(15)
  equipment    String[]   @default([])
  status       RoomStatus @default(ACTIVE)
  notes        String?    @db.Text
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  classes      Class[]

  @@unique([centerId, code])
  @@index([centerId, status])
}

enum HolidayType {
  HOLIDAY
  MAINTENANCE
  EVENT
  OTHER
}

model Holiday {
  id        String      @id @default(cuid())
  name      String
  date      DateTime    @db.Date
  endDate   DateTime?   @db.Date
  centerId  String?
  center    Center?     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  type      HolidayType @default(HOLIDAY)
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([date])
  @@index([centerId, date])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SALES)
  centerId      String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Link 1-1 với Employee (1 user account ↔ 1 employee record)
  employeeId    String?   @unique
  employee      Employee? @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  center        Center?        @relation(fields: [centerId], references: [id])
  accounts      Account[]
  assignedLeads Lead[]         @relation("AssignedLeads")
  notes         Note[]
  teacherClass    Class[]      @relation("TeacherClasses")
  assistantClass  Class[]      @relation("AssistantClasses")
  jobPostings   JobPosting[]

  honorsCreated      Honor[]            @relation("HonorCreatedBy")
  pageContentUpdated SitePageContent[]  @relation("PageContentUpdatedBy")
  employeesCreated   Employee[]         @relation("EmployeeCreatedBy")

  @@index([email])
  @@index([centerId])
  @@index([role])
  @@index([deletedAt])
}

model Course {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  type        CourseType @default(OFFLINE)
  description String?    @db.Text
  price       Int?
  duration    Int?
  isActive    Boolean    @default(true)

  // Marketing fields (Phase 4.UI.FINAL)
  code             String? // Code ngắn cho product cards (vd. "LTR", "LTRS")
  shortDescription String? @db.VarChar(280)
  priceDisplay     String? // "2,400,000đ" hoặc "Liên hệ"
  durationDisplay  String? // "6 tháng" hoặc "Tuỳ chỉnh"
  studentCount     Int     @default(0)
  displayOrder     Int     @default(0)
  isPublished      Boolean @default(true)

  thumbnail   String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  leads       Lead[]
  classes     Class[]
  enrollments Enrollment[]
  curriculums Curriculum[]

  @@index([slug])
  @@index([type])
  @@index([code])
  @@index([isPublished, displayOrder])
}

model Lead {
  id           String     @id @default(cuid())
  parentName   String
  phone        String
  email        String?
  childName    String?
  childAge     Int?
  centerId     String?
  courseId     String?
  assignedToId String?
  status       LeadStatus @default(NEW)
  source       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent       String?
  utmTerm          String?
  fbclid           String?
  gclid            String?
  fbp              String?
  fbc              String?
  eventId          String?   @unique
  landingPage      String?
  referrer         String?
  ipAddress        String?
  userAgent        String?   @db.Text
  consentMarketing Boolean   @default(false)
  note             String?   @db.Text
  deletedAt        DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  center     Center? @relation(fields: [centerId], references: [id])
  course     Course? @relation(fields: [courseId], references: [id])
  assignedTo User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes      Note[]

  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@index([centerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([eventId])
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  leadId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

enum StudentStatus {
  ACTIVE     // Đang học
  PAUSED     // Bảo lưu (tạm nghỉ)
  GRADUATED  // Hoàn thành khoá học
  INACTIVE   // Nghỉ học hẳn
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
  UNKNOWN
}

model Student {
  id           String    @id @default(cuid())
  name         String
  studentCode  String?   @unique
  dateOfBirth  DateTime?
  gender       Gender?
  phone        String?
  email        String?
  avatarUrl    String?

  // Education
  currentGrade Int?
  school       String?

  // Parent / Guardian
  // parentName + parentPhone stay nullable in the DB for the existing rows
  // (some seeded students lack them). Zod requires them at write time.
  parentName      String?
  parentPhone     String?
  parentEmail     String?
  parentRelation  String?
  parent2Name     String?
  parent2Phone    String?
  parent2Relation String?

  // Address
  address  String?
  ward     String?
  district String?
  city     String?

  // Health
  bloodType   BloodType?
  allergies   String[]   @default([])
  healthNotes String?    @db.Text

  // Sata Robo specific
  enrollmentDate    DateTime?     @db.Date
  preferredCenterId String?
  preferredCenter   Center?       @relation("StudentPreferredCenter", fields: [preferredCenterId], references: [id])
  notes             String?       @db.Text
  status            StudentStatus @default(ACTIVE)

  // Legacy "current center" — pre-D1 association, kept for compat.
  centerId String?
  center   Center?  @relation(fields: [centerId], references: [id])

  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  enrollments           Enrollment[]
  attendances           Attendance[]
  examAttempts          ExamAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  progressReports       ProgressReportLog[]

  @@index([phone])
  @@index([centerId])
  @@index([deletedAt])
  @@index([status])
  @@index([preferredCenterId])
  @@index([parentPhone])
}

enum ClassStatus {
  PLANNED
  RECRUITING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Class {
  id          String    @id @default(cuid())

  // Identity
  classCode   String?   @unique
  name        String
  description String?   @db.Text

  // Relations (existing target preserved: teacher → User)
  courseId    String
  centerId    String?
  teacherId   String?
  assistantId String?
  roomId      String?

  // Schedule
  schedule     String?   // legacy free-text (e.g. "T2 T4 17:30")
  startDate    DateTime?
  endDate      DateTime?
  scheduleDays Int[]     @default([])   // 0=CN, 1=T2, ..., 6=T7
  startTime    String?                   // "HH:mm"
  endTime      String?                   // "HH:mm"

  // Capacity
  maxStudents Int       @default(20)
  minStudents Int       @default(5)

  // Status (new) + legacy isActive flag (kept for back-compat)
  status      ClassStatus @default(PLANNED)
  isActive    Boolean   @default(true)

  // Other
  notes       String?   @db.Text
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course      Course       @relation(fields: [courseId], references: [id])
  center      Center?      @relation(fields: [centerId], references: [id])
  teacher     User?        @relation("TeacherClasses", fields: [teacherId], references: [id])
  assistant   User?        @relation("AssistantClasses", fields: [assistantId], references: [id])
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  sessions        ClassSession[]
  exams           Exam[]
  assignments     Assignment[]
  progressReports ProgressReportLog[]

  @@index([courseId])
  @@index([centerId])
  @@index([teacherId])
  @@index([deletedAt])
  @@index([status, centerId])
  @@index([courseId, status])
  @@index([roomId])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  courseId  String
  status    EnrollmentStatus @default(ACTIVE)

  // Financial (legacy)
  tuition   Int?
  paidAt    DateTime?

  // Legacy dates (kept for back-compat)
  startDate DateTime?
  endDate   DateTime?

  // D5 workflow timestamps
  enrolledAt   DateTime  @default(now())
  confirmedAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?

  // Transfer
  transferredToId String?
  transferredTo   Enrollment?  @relation("EnrollmentTransfer", fields: [transferredToId], references: [id])
  transferredFrom Enrollment[] @relation("EnrollmentTransfer")
  transferReason  String?      @db.Text

  // Other
  notes     String?  @db.Text

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  auditLogs EnrollmentAuditLog[]

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@index([classId, status])
  @@index([studentId, status])
  @@index([status, enrolledAt])
}

model EnrollmentAuditLog {
  id              String      @id @default(cuid())
  enrollmentId    String
  enrollment      Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  fromStatus      String
  toStatus        String

  changedByUserId String?
  changedByName   String

  reason          String?     @db.Text
  extraData       Json?

  createdAt       DateTime    @default(now())

  @@index([enrollmentId, createdAt])
}

model ClassSession {
  id          String   @id @default(cuid())
  classId     String
  date        DateTime
  topic       String?
  notes       String?  @db.Text

  // Phase E6 — link session to curriculum lesson for progress tracking
  lessonId    String?
  lessonNotes String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attendances Attendance[]

  @@index([classId])
  @@index([date])
  @@index([lessonId])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

// ─── Content & Marketing ─────────────────────────────────────────────────────

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum ExperienceLevel {
  ENTRY  // Mới ra trường, không yêu cầu kinh nghiệm
  JUNIOR // 1-2 năm
  MID    // 3-5 năm
  SENIOR // 5+ năm
  EXPERT // Chuyên gia 10+ năm
}

model JobPosting {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  department       String?
  location         String?
  type             String?
  description      String           @db.Text
  workingHours     String?
  experienceLevel  ExperienceLevel?
  responsibilities String[]         @default([])
  requirements     String[]         @default([])
  benefits         String[]         @default([])
  salary           String?
  salaryMin        Int?
  salaryMax        Int?
  salaryNote       String?
  openings         Int              @default(1)
  status           JobStatus        @default(OPEN)
  authorId         String?
  contactEmail     String?
  contactPhone     String?
  closesAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  author       User?              @relation(fields: [authorId], references: [id])
  applications JobApplication[]

  @@index([slug])
  @@index([status])
  @@index([department])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  name        String
  email       String
  phone       String
  cvUrl       String?
  coverLetter String?           @db.Text
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([email])
}

model MarketingConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================
// COURSE PACKAGES (Phase 4.UI.RESET.2 PART D3)
// Sata1-Sata8 + Combo packages — children of Course "laptrinhrobot"
// ============================================
model CoursePackage {
  id               String  @id @default(cuid())
  slug             String  @unique
  code             String
  name             String
  shortName        String?
  subtitle         String?
  shortDescription String? @db.Text
  description      String? @db.Text

  ageGroup String?
  level    String?

  lessons        Int?
  duration       String?
  priceOriginal  Int?
  priceEarlyBird Int?
  priceMember    Int?

  features   Json?
  highlights Json?
  curriculum Json?

  badge        String?
  color        String?
  displayOrder Int     @default(0)
  isPublished  Boolean @default(false)
  isFeatured   Boolean @default(false)

  thumbnail String?

  seoTitle       String?
  seoDescription String? @db.Text

  parentCourseSlug String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([parentCourseSlug, isPublished, displayOrder])
}

// ============================================
// NEWS (Phase 4.UI.RESET.2 PART D4)
// Marketing articles (replaced legacy BlogPost in Phase A4)
// ============================================
model News {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String    @db.Text
  content        String    @db.Text
  coverImage     String?
  category       String?
  tags           String[]
  isPublished    Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  publishedAt    DateTime?
  displayOrder   Int       @default(0)
  seoTitle       String?
  seoDescription String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
}

// ============================================
// HALL OF FAME — VINH DANH NHÂN SỰ
// ============================================

enum HonorCategory {
  SPARK
  GROWTH
  IMPACT
  GRAND_CHAMPION
}

model Honor {
  id             String        @id @default(cuid())
  slug           String        @unique

  // Link sang Employee (source of truth cho thông tin nhân sự)
  // Tạm thời nullable để migration backfill xong mới enforce NOT NULL ở Phase 4.7.1
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Snapshot lúc trao giải (override Employee data hiện tại nếu cần)
  jobTitleAtTime String?
  yearsAtTime    Int?

  // DEPRECATED: Giữ tạm để code cũ rollback an toàn, sẽ drop ở Phase 4.7.1
  // Code mới đọc qua honor.employee.fullName / jobTitle / avatarUrl
  fullName       String?
  jobTitle       String?
  avatarUrl      String?
  yearsAtCompany Int?

  category       HonorCategory
  awardName      String
  awardedAt      DateTime
  awardQuarter   String?

  story          String        @db.Text
  shortBio       String?       @db.VarChar(280)
  pullQuote      String?       @db.VarChar(500)
  achievements   String?       @db.Text

  isFeatured     Boolean       @default(false)
  isPublished    Boolean       @default(true)
  displayOrder   Int           @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  createdBy      User?         @relation("HonorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isFeatured])
  @@index([isPublished, displayOrder])
  @@index([employeeId])
}

model TimelineItem {
  id              String   @id @default(cuid())
  occurredAt      DateTime
  title           String
  description     String   @db.Text
  coverImageUrl   String?
  relatedHonorIds String?
  isPublished     Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, occurredAt])
}

model SitePageContent {
  id           String   @id @default(cuid())
  pageKey      String
  contentKey   String
  contentValue String   @db.Text
  updatedAt    DateTime @updatedAt
  updatedById  String?
  updatedBy    User?    @relation("PageContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([pageKey, contentKey])
  @@index([pageKey])
}

// ============================================
// EMPLOYEE MODULE
// ============================================

enum Department {
  BAN_GIAM_DOC
  DAO_TAO
  MARKETING
  KINH_DOANH
  IT
  HANH_CHANH_NHAN_SU
  KE_TOAN
  // Phase 4.7 extension
  TUYEN_SINH
  GIAO_VU
  GIANG_DAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractType {
  FULLTIME
  PARTTIME
  INTERN
  FREELANCE
  // Phase 4.7 extension — Vietnam labor law contract types
  THU_VIEC
  CHINH_THUC_XAC_DINH
  CHINH_THUC_KHONG_XAC_DINH
}

enum EmploymentStatus {
  ACTIVE      // Đang làm
  ON_LEAVE    // Tạm nghỉ (sản, ốm dài)
  RESIGNED    // Đã nghỉ tự nguyện
  TERMINATED  // Bị cho nghỉ
}

model Employee {
  id           String        @id @default(cuid())

  // Tier 1: cơ bản
  employeeCode String        @unique
  fullName     String
  jobTitle     String
  department   Department
  avatarUrl    String?
  email        String?       @unique
  joinedAt     DateTime?
  bio          String?       @db.Text
  isActive     Boolean       @default(true)
  isPublic     Boolean       @default(false)
  displayOrder Int           @default(0)

  // Tier 2: HR cơ bản
  phone        String?
  dateOfBirth  DateTime?
  gender       Gender?
  contractType ContractType?
  salaryRank   Int?
  salaryLevel  Int?

  // Phase 4.7 — additional Tier 2 HR fields
  endDate          DateTime?    // Ngày kết thúc HĐ (cho hợp đồng có thời hạn)
  bhxhBase         Float?       // Mức lương đóng BHXH
  address          String?
  emergencyContact String?      // Tên - Quan hệ - SĐT
  notes            String?      @db.Text

  // Phase C1 — extended HR fields
  nationalId       String?      // CCCD / CMND
  status           EmploymentStatus @default(ACTIVE)
  subjects         String[]     @default([])  // Môn dạy (mainly for GIANG_DAY / DAO_TAO)
  certifications   String[]     @default([])  // Chứng chỉ chuyên môn

  // Cơ sở làm việc
  centerId     String?
  center       Center?       @relation(fields: [centerId], references: [id], onDelete: SetNull)

  // Self-relation: quản lý trực tiếp
  managerId    String?
  manager      Employee?     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[]    @relation("EmployeeManager")

  // CEO flag (chỉ 1 employee được isCEO=true tại 1 thời điểm)
  isCEO        Boolean       @default(false)

  // Meta
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  createdBy    User?         @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Relations
  honors        Honor[]
  userAccount   User?         @relation("UserEmployee")
  roleAuditLogs RoleAuditLog[]
  authoredQuestions  Question[]    @relation("QuestionAuthor")
  createdExams       Exam[]        @relation("ExamCreator")
  gradedAttempts     ExamAttempt[] @relation("AttemptGrader")
  uploadedDocuments  Document[]    @relation("DocumentUploader")
  createdAssignments Assignment[]              @relation("AssignmentCreator")
  gradedSubmissions  AssignmentSubmission[]    @relation("SubmissionGrader")
  generatedReports   ProgressReportLog[]       @relation("ReportGenerator")

  @@index([department])
  @@index([isActive])
  @@index([isPublic])
  @@index([isCEO])
  @@index([status])
}

// Audit trail for User.role changes scoped to one Employee (the linked
// userAccount's role). Stored as String (not Role enum) so the log
// stays readable if the enum ever shifts. Cascade on Employee delete.
model RoleAuditLog {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  fromRole        String
  toRole          String

  changedByUserId String?  // nullable — defensive if the auditor User row gets removed
  changedByName   String   // snapshot so the trail is human-readable even after deletion

  reason          String?  @db.Text

  createdAt       DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([createdAt])
}

// ─── Phase 4.UI.FIX.2 ─────────────────────────────────────────────────────
// Học cụ Robotics ZMROBO — 3 bộ kit (Alpha / Beta / Intelligence Storm).
// Specs/features/highlights là JSON để giữ schema linh hoạt.
model ZMRoboKit {
  id               String   @id @default(cuid())
  slug             String   @unique

  brand            String   @default("ZMROBO")
  series           String
  code             String?
  title            String
  subtitle         String
  shortDescription String   @db.Text
  description      String   @db.Text

  priceDisplay     String   @default("Liên hệ tư vấn")
  isAvailable      Boolean  @default(true)

  specs            Json
  features         Json
  highlights       Json

  mainImage        String   @default("")
  galleryImages    String[]

  sourceUrl        String?

  displayOrder     Int      @default(0)
  isPublished      Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([isPublished, displayOrder])
}

// ─── Phase E1 ─────────────────────────────────────────────────────────────
// Curriculum (Giáo trình) chứa Lesson (Bài học). Tách rời khỏi Course để
// course (protected) giữ metadata, còn syllabus có thể update qua versions.
model Curriculum {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])

  version     Int      @default(1)
  name        String
  description String?  @db.Text

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]

  @@unique([courseId, version])
  @@index([courseId, isActive])
}

model Lesson {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  order        Int

  title        String
  description  String?    @db.Text
  content      String?    @db.Text

  duration     Int        @default(90)
  objectives   String[]   @default([])
  materials    String[]   @default([])

  notes        String?    @db.Text

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  questions     Question[]
  exams         Exam[]
  documents     Document[]
  assignments   Assignment[]
  classSessions ClassSession[]

  @@unique([curriculumId, order])
  @@index([curriculumId])
}

// ─── Phase E2 ─────────────────────────────────────────────────────────────
// Question bank with 5 types. Choice (cascade) only used by MULTIPLE_CHOICE
// + TRUE_FALSE; correctAnswer used by SHORT_ANSWER / CODE / ESSAY.
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  CODE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Question {
  id            String              @id @default(cuid())

  questionCode  String?             @unique
  type          QuestionType
  text          String              @db.Text
  explanation   String?             @db.Text

  difficulty    QuestionDifficulty  @default(MEDIUM)
  tags          String[]            @default([])

  lessonId      String?
  lesson        Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  // For SHORT_ANSWER / CODE / ESSAY
  correctAnswer String?             @db.Text

  // For MULTIPLE_CHOICE / TRUE_FALSE
  choices       Choice[]

  examQuestions ExamQuestion[]

  authorId      String?
  author        Employee?           @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  isPublic      Boolean             @default(true)
  notes         String?             @db.Text

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([lessonId])
  @@index([type, difficulty])
  @@index([authorId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  order      Int
  text       String   @db.Text
  isCorrect  Boolean  @default(false)

  @@unique([questionId, order])
}

// ─── Phase E3 — Exam workflow ────────────────────────────────────────────
enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  REVIEWED
}

model Exam {
  id              String       @id @default(cuid())

  examCode        String?      @unique
  title           String
  description     String?      @db.Text

  classId         String?
  class           Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  durationMinutes Int          @default(60)
  totalPoints     Float        @default(10)
  passingScore    Float        @default(5)
  shuffleQuestions Boolean     @default(false)
  shuffleChoices   Boolean     @default(false)

  openAt          DateTime?
  closeAt         DateTime?

  status          ExamStatus   @default(DRAFT)

  createdById     String?
  createdBy       Employee?    @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  examQuestions   ExamQuestion[]
  attempts        ExamAttempt[]

  @@index([status, classId])
  @@index([lessonId])
  @@index([createdById])
}

model ExamQuestion {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])

  order       Int
  points      Float    @default(1)

  answers     ExamAnswer[]

  @@unique([examId, order])
  @@unique([examId, questionId])
  @@index([examId])
}

model ExamAttempt {
  id           String        @id @default(cuid())
  examId       String
  exam         Exam          @relation(fields: [examId], references: [id])
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])

  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  gradedAt     DateTime?

  status       AttemptStatus @default(IN_PROGRESS)
  totalScore   Float?
  passed       Boolean?

  gradedById   String?
  gradedBy     Employee?     @relation("AttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  feedback     String?       @db.Text

  answers      ExamAnswer[]

  @@unique([examId, studentId])
  @@index([status, examId])
  @@index([studentId])
}

model ExamAnswer {
  id              String       @id @default(cuid())
  attemptId       String
  attempt         ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId  String
  examQuestion    ExamQuestion @relation(fields: [examQuestionId], references: [id])

  selectedChoiceIds String[]   @default([])
  textAnswer        String?    @db.Text

  isCorrect       Boolean?
  score           Float?
  graderNote      String?      @db.Text

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([attemptId, examQuestionId])
}

// ─── Phase E4 — Document management ──────────────────────────────────────
enum DocumentType {
  PDF
  IMAGE
  VIDEO
  SLIDE
  WORKSHEET
  AUDIO
  OTHER
}

model Document {
  id           String       @id @default(cuid())

  documentCode String?      @unique
  title        String
  description  String?      @db.Text

  type         DocumentType
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String?

  lessonId     String?
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  isPublic     Boolean      @default(false)

  tags         String[]     @default([])
  notes        String?      @db.Text

  uploadedById String?
  uploadedBy   Employee?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignmentDocs AssignmentDocument[]

  @@index([lessonId])
  @@index([type])
  @@index([isPublic])
  @@index([uploadedById])
}

// ─── Phase E5 — Assignment + Submission workflow ─────────────────────────
enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  GRADED
}

model Assignment {
  id           String           @id @default(cuid())

  title        String
  description  String           @db.Text
  instructions String?          @db.Text

  classId      String
  class        Class            @relation(fields: [classId], references: [id])
  lessonId     String?
  lesson       Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  totalPoints  Float            @default(10)

  assignedAt   DateTime         @default(now())
  dueAt        DateTime?

  allowText    Boolean          @default(true)
  allowFile    Boolean          @default(true)

  status       AssignmentStatus @default(DRAFT)

  createdById  String?
  createdBy    Employee?        @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  submissions  AssignmentSubmission[]
  documents    AssignmentDocument[]

  @@index([status, classId])
  @@index([dueAt])
  @@index([createdById])
}

model AssignmentDocument {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document   @relation(fields: [documentId], references: [id])

  createdAt    DateTime   @default(now())

  @@unique([assignmentId, documentId])
  @@index([documentId])
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])

  textAnswer   String?          @db.Text
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  mimeType     String?

  submittedAt  DateTime?
  status       SubmissionStatus @default(NOT_SUBMITTED)

  score        Float?
  feedback     String?          @db.Text
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     Employee?        @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([status, assignmentId])
  @@index([studentId])
}

// ─── Phase E7 — Audit log for generated PDF reports ──────────────────────
model ProgressReportLog {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  generatedById String?
  generatedBy   Employee? @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime  @default(now())
  sentToEmail   String?
  sentAt        DateTime?
  reportTitle   String
  metadata      Json?

  @@index([studentId, generatedAt])
  @@index([classId])
  @@index([generatedAt])
}
