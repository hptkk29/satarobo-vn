generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum GrantType {
  ALLOW
  DENY
}

enum Role {
  SUPER_ADMIN
  CENTER_MANAGER // Phase T0.1 — đổi tên từ MANAGER (quản lý cơ sở)
  HR
  SALES_CSM // Phase T0.1 — đổi tên từ SALES (tư vấn & chăm sóc học viên)
  TEACHER
  MARKETING
  ACCOUNTANT
  PARENT // Phase T0.1 — phụ huynh (portal hocvien.satarobo.vn), KHÔNG vào /admin
}

// R1-04 — nguồn hoa hồng (SR.QD.217): từ ads/admin · sale tự kiếm · giới thiệu.
enum CommissionSource {
  MARKETING_ADMIN
  SALE_SELF
  REFERRAL
}

enum LeadStatus {
  // Phase T1.1 — pipeline mở rộng (giữ giá trị cũ để back-compat)
  NEW
  ASSIGNED
  CONTACTED
  NO_ANSWER
  CONSULTING
  TRIAL_SCHEDULED
  TRIAL_ATTENDED
  AWAITING_DECISION
  ENROLLED
  NURTURING
  LOST
  DUPLICATE
  DEMO_SCHEDULED // deprecated — data đã map sang TRIAL_SCHEDULED, giữ cho back-compat
  // R7-01 (additive) — QĐ-O9
  TRIAL_IN_PROGRESS // đang học thử (lớp trải nghiệm đang diễn ra)
  REGISTERED // đã đăng ký (đã có khoản Sale ghi nhận, chưa convert)
}

/// R7-01 — trạng thái học thử của từng con trong 1 lead (LeadChild).
enum LeadChildTrialStatus {
  NONE
  SCHEDULED
  IN_PROGRESS
  ATTENDED
}

enum CourseType {
  ONLINE
  OFFLINE
  HYBRID
}

enum EnrollmentStatus {
  // Legacy (kept for back-compat with existing rows)
  ACTIVE
  CANCELLED

  // D5 workflow
  PENDING
  CONFIRMED
  STUDYING
  PAUSED
  COMPLETED
  WITHDREW
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Module QL học viên PHẦN 2 — trạng thái học bù của buổi vắng.
enum MakeupStatus {
  NONE // không cần bù (mặc định)
  NEEDS_MAKEUP // vắng cần xếp buổi bù
  MADE_UP // đã học bù xong (tính như có mặt)
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
  PAUSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

// ─── Phase 5.6 — Payment + Order enums ────────────────────────────────────

enum PaymentMethodType {
  CASH
  BANK_TRANSFER
  VNPAY
  TINGEE
  COD
  WALLET // reserved for future wallet system (Sprint defer)
}

enum OrderType {
  COURSE // offline class enrollment
  PACKAGE // CoursePackage purchase
  EXAM // exam registration
  PRODUCT // physical product (kit/sensor) — Sprint 5.10
  COMBO // bundle, defer
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED // payment confirmed, awaiting fulfillment
  COMPLETED // fulfilled (e.g., student attended class, kit delivered)
  CANCELLED // pre-COMPLETED cancellation
  REFUNDED // post-COMPLETED refund
}

enum OrderItemType {
  COURSE_ENROLLMENT // link tới Enrollment (offline class)
  COURSE_PACKAGE // link tới CoursePackage
  EXAM_REGISTRATION // link tới ExamAttempt
  PRODUCT // link tới Product (Sprint 5.10, nullable for now)
}

// ─── Phase 5.7 — Voucher enums ────────────────────────────────────────────

enum VoucherType {
  COURSE // áp dụng cho đơn type=COURSE
  PACKAGE // áp dụng cho đơn type=PACKAGE
  KIT_ROBOT // áp dụng cho product category=KIT (Sprint 5.10 ready)
  SENSOR // áp dụng cho product category=SENSOR (Sprint 5.10 ready)
  ALL // áp dụng cho bất kỳ loại đơn
}

enum VoucherDiscountKind {
  PERCENT // % giảm + max cap VND
  FIXED // tiền cố định VND
}

// ─── Phase 5.10 — Product catalog enums ───────────────────────────────────

enum ProductCategory {
  KIT_ROBOT // Bộ kit robot hoàn chỉnh
  SENSOR // Cảm biến riêng lẻ
  MISSION_BLOCK // Khối nhiệm vụ thi đấu
  ACCESSORY // Phụ kiện
  BOOK // Sách/tài liệu
  CONSUMABLE // Vật tư tiêu hao
  OTHER
}

enum ProductStatus {
  DRAFT // Soạn nháp, chưa bán
  ACTIVE // Đang bán
  PAUSED // Tạm ngưng bán
  DISCONTINUED // Ngừng kinh doanh
}

enum ProductMovementType {
  PURCHASE // Nhập hàng (+)
  SALE // Bán (-)
  ADJUSTMENT // Điều chỉnh (+/-)
  DAMAGE // Hỏng (-)
  RETURN // Trả lại từ KH (+)
  TRANSFER_IN // Chuyển từ CN khác (+)
  TRANSFER_OUT // Chuyển sang CN khác (-)
}

// ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Business ───────────────────────────────────────────────────────────

model Center {
  id           String  @id @default(cuid())
  code         String? @unique // Phase T0.2 — mã cơ sở "CS1", "CS2" cho codegen
  name         String
  slug         String  @unique
  address      String
  ward         String?
  district     String?
  city         String  @default("")
  phone        String?
  email        String?
  googleMapUrl String? @db.Text
  workingHours String?
  managerName  String?

  // Phase NHÓM 4 — geofence chấm công QR.
  latitude            Float?
  longitude           Float?
  allowedRadiusMeters Int?     @default(100)
  logoUrl             String?
  bannerUrl           String?
  description         String?  @db.Text
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users             User[]
  leads             Lead[]
  classes           Class[]
  classGroups       ClassGroup[]
  trialClasses      TrialClass[]
  students          Student[]
  studentsPreferred Student[]        @relation("StudentPreferredCenter")
  employees         Employee[]
  rooms             Room[]
  holidays          Holiday[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  inventoryAudits   InventoryAudit[]

  // Phase 5.6 — Order
  orders Order[]

  @@index([isActive])
  @@index([displayOrder])
}

// ─── A0-01 — OrgUnit tree (Doc 15 §2.1, OI-1) ───
// ROOT(SataRobo) → HO, CS1, CS2 ĐỘC LẬP NGANG HÀNG. HO KHÔNG phải cha CS1/CS2.
// Additive thuần — KHÔNG đụng Center/User.centerId hiện hữu (Phase A: centerId trỏ Center cũ).
enum OrgUnitType {
  ROOT
  HO
  CENTER
  CAMPUS
  PARTNER
  FRANCHISE
}

model OrgUnit {
  id        String      @id @default(cuid())
  type      OrgUnitType
  code      String      @unique // "SATAROBO","HO","CS1","CS2"
  name      String
  address   String? // chỉ thông tin, KHÔNG suy ra quan hệ quản lý
  parentId  String?
  parent    OrgUnit?    @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  OrgUnit[]   @relation("OrgUnitTree")
  centerId  String?     @unique // Phase A: trỏ Center cũ (chỉ type=CENTER)
  isActive  Boolean     @default(true)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type])
  @@index([parentId])
  @@index([deletedAt])
}

// ─── A0-02 — RBAC động (Doc 15 §2.2/§2.3) ───
// Role + permission + gán quyền nằm trong DB; admin cấu hình qua UI. can() v2 (A0-03)
// đọc các bảng này. KHÔNG đụng matrix tĩnh permissions.ts / User.role[] (cắt ở Phase C).
enum ScopeType {
  GLOBAL
  CENTER
  CLASS
  OWN
  CHILDREN
  ASSIGNED
}

enum AssignStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model RoleDef {
  id          String           @id @default(cuid())
  code        String           @unique // HO_ACCOUNTANT, CENTER_MANAGER...
  name        String
  isSystem    Boolean          @default(false) // SUPER_ADMIN, PARENT — không xóa/đổi code
  isActive    Boolean          @default(true)
  permissions RolePermission[]
  userRoles   UserOrgRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId    String
  action    String // validate qua ACTION_REGISTRY
  scopeType ScopeType
  role      RoleDef   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, action])
  @@index([roleId])
}

model UserOrgRole {
  userId        String
  orgUnitId     String
  roleId        String
  effectiveFrom DateTime     @default(now())
  effectiveTo   DateTime? // null = vô thời hạn
  status        AssignStatus @default(ACTIVE)
  grantedById   String // ai cấp (audit)
  createdAt     DateTime     @default(now())
  role          RoleDef      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, orgUnitId, roleId])
  @@index([userId])
  @@index([orgUnitId])
  @@index([roleId])
}

// Audit cho thay đổi role/permission/assignment (AC4). A0-06 sẽ hợp nhất AuditLog.
model RbacAuditLog {
  id              String   @id @default(cuid())
  entity          String // ROLE | PERMISSION | ASSIGNMENT
  entityId        String
  action          String // CREATE | UPDATE | DELETE | ASSIGN | REVOKE
  changedByUserId String?
  changedByName   String
  oldValues       Json?
  newValues       Json?
  reason          String
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([entity, entityId])
  @@index([changedByUserId])
  @@index([createdAt])
}

// ─── A0-06 — AuditLog HỢP NHẤT (Doc 15 §8.1) ───
// 1 bảng cho mọi module (thay 8 bảng audit cũ — giữ đọc-only). Immutable: KHÔNG
// có server action update/delete. Viewer scope theo orgUnitId + mask PII theo quyền.
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String? // null = System (cron/dispatcher)
  actorName     String // snapshot tên actor
  module        String // 'rbac','orders','employees',...
  entityType    String
  entityId      String
  action        String // CREATE/UPDATE/DELETE/STATUS_CHANGE/EXPORT/SCOPE_BYPASS...
  oldValues     Json?
  newValues     Json?
  changedFields String[]
  reason        String?
  orgUnitId     String? // để scope viewer theo cơ sở
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([orgUnitId, createdAt])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
}

// ─── A0-07 — DomainEvent outbox (Doc 15 §4.5) ───
// Ghi event TRONG transaction nghiệp vụ → dispatcher (cron) gọi handler theo type,
// idempotent + retry. Thêm consumer = 1 dòng on(), không sửa publisher.
model DomainEvent {
  id          String    @id @default(cuid())
  type        String
  payloadJson Json
  status      String    @default("PENDING") // PENDING/PROCESSING/DONE/FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  dedupeKey   String?   @unique // idempotency producer-side
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([type])
}

// ─── A0-08 — EmployeeOrgAssignment (Doc 15 §2.2, OI-6/OI-8/OI-10) ───
// Nhân sự/kiêm nhiệm/lương — KHÔNG sinh quyền (quyền chỉ từ UserOrgRole).
enum AssignmentType {
  PRIMARY
  SECONDARY
  SUPPORT
  SUBSTITUTE
  SHARED
}

model EmployeeOrgAssignment {
  id                String         @id @default(cuid())
  employeeId        String
  orgUnitId         String
  roleInOrg         String? // mô tả vai trò nghiệp vụ (KHÔNG phải RoleDef)
  assignmentType    AssignmentType
  effectiveFrom     DateTime       @default(now())
  effectiveTo       DateTime?
  status            AssignStatus   @default(ACTIVE)
  allocationPercent Int? // 0..100 — phân bổ chi phí/lương
  createdById       String
  createdAt         DateTime       @default(now())

  @@index([employeeId, status])
  @@index([orgUnitId, status])
}

// ─── R1-01 — CRM Messenger (SR.QD.217, Doc 15 §5) ───
// Page HO/CS → hội thoại → message. centerId để scopedDb cách ly (C1.4).
model FacebookPageMapping {
  id        String      @id @default(cuid())
  pageId    String      @unique
  pageName  String?
  scopeType OrgUnitType // HO | CENTER (validate ở service)
  centerId  String? // chỉ khi scopeType=CENTER
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@index([scopeType])
}

model MessengerConversation {
  id             String             @id @default(cuid())
  pageId         String
  psid           String // page-scoped user id
  parentName     String?
  phone          String?
  status         String             @default("OPEN") // OPEN/QUALIFIED/CLOSED
  centerId       String? // suy từ page mapping → scopedDb
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  firstMessageAt DateTime?
  respondedAt    DateTime?
  leadId         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       MessengerMessage[]

  @@unique([pageId, psid])
  @@index([centerId])
  @@index([status])
  @@index([leadId])
  @@index([orgUnitId])
}

model MessengerMessage {
  id              String                @id @default(cuid())
  conversationId  String
  direction       String // IN | OUT
  text            String?               @db.Text
  attachments     Json?
  externalEventId String?               @unique // idempotency webhook (R1-02 C2.4)
  sentAt          DateTime
  createdAt       DateTime              @default(now())
  conversation    MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

// R1-10 — Bảng hoa hồng theo kỳ (SR.QD.217, tiền). DRAFT→APPROVED→REOPENED.
enum CommissionStatus {
  DRAFT
  APPROVED
  REOPENED
}

model CommissionStatement {
  id           String           @id @default(cuid())
  period       String           @unique // "2026-06"
  status       CommissionStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lines        CommissionLine[]
}

model CommissionLine {
  id          String              @id @default(cuid())
  statementId String
  recipientId String // user hưởng hoa hồng
  tier        String // QC | SALE_ADMIN | SALE | QL_TT
  amount      Int // VND; âm = clawback
  isClawback  Boolean             @default(false)
  leadId      String?
  statement   CommissionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([recipientId])
}

// R6-F2 — Bản ghi LỆCH giữa can() v1 (matrix) và v2 (DB actor) khi shadow-run.
// Mục tiêu: report = 0 trong N ngày → an toàn bật RBAC_V2_ENABLED. Chỉ ghi khi LỆCH.
model RbacShadowDiff {
  id        String   @id @default(cuid())
  action    String
  userId    String
  v1        Boolean
  v2        Boolean
  targetKey String? // mô tả target (centerId/classId...) để truy vết
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// R6-B1 — Tỉ lệ hoa hồng theo kỳ trong DB (thay hằng số DEFAULT_RATES).
// Mỗi tier có chuỗi version theo effectiveFrom/To; rate hiệu lực = row phủ thời điểm
// đóng đơn. Trần Σ rate ≤ 8% enforce khi ghi. SUPER_ADMIN sửa + audit + reason.
model CommissionRateConfig {
  id            String    @id @default(cuid())
  tier          String // QC | SALE_ADMIN | SALE | QL_TT
  rate          Float // 0..1
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = đang hiệu lực
  reason        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([tier, effectiveFrom])
}

// R1-12 — Báo cáo marketing tuần/tháng (snapshot) của QL TT (SR.QD.217 C12.2).
enum ReportPeriodType {
  WEEK
  MONTH
}

model MarketingReport {
  id            String           @id @default(cuid())
  periodType    ReportPeriodType
  periodKey     String // "2026-W23" | "2026-06"
  submittedById String
  snapshot      Json
  submittedAt   DateTime         @default(now())

  @@unique([periodType, periodKey, submittedById])
  @@index([periodType, periodKey])
}

// R1-09 — Kỳ phân bổ chi phí marketing (SR.QD.217). DRAFT→CONFIRMED→REOPENED.
enum CostPeriodStatus {
  DRAFT
  CONFIRMED
  REOPENED
}

model MarketingCostPeriod {
  id            String           @id @default(cuid())
  period        String           @unique // "2026-06"
  totalQcCost   Float            @default(0)
  status        CostPeriodStatus @default(DRAFT)
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// R1-07 — Ads Insights theo ngày/kênh (SR.QD.217, CPL/CPA/ROAS). unique (date,channel).
model AdsInsightDaily {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  channel     String // "facebook" | "google" | "manual" ...
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  source      String   @default("META_API") // META_API | MANUAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, channel])
  @@index([date])
}

// R3-06 — Đồng ý dùng hình ảnh học viên (privacy-first, Doc 15 §8.3).
enum ConsentType {
  CLASS_MEDIA
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model StudentConsent {
  id        String        @id @default(cuid())
  studentId String
  type      ConsentType
  status    ConsentStatus @default(GRANTED)
  grantedAt DateTime      @default(now())
  revokedAt DateTime?
  updatedAt DateTime      @updatedAt

  @@unique([studentId, type])
  @@index([studentId])
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Room {
  id           String     @id @default(cuid())
  name         String
  code         String
  centerId     String
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center       Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  capacity     Int        @default(15)
  equipment    String[]   @default([])
  status       RoomStatus @default(ACTIVE)
  notes        String?    @db.Text
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  classes      Class[]
  trialClasses TrialClass[]

  @@unique([centerId, code])
  @@index([centerId, status])
  @@index([orgUnitId])
}

enum HolidayType {
  HOLIDAY
  MAINTENANCE
  EVENT
  OTHER
}

model Holiday {
  id        String      @id @default(cuid())
  name      String
  date      DateTime    @db.Date
  endDate   DateTime?   @db.Date
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center?     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  type      HolidayType @default(HOLIDAY)
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SALES_CSM) // Đợt 3B — vai trò CHÍNH (primary)
  roles         Role[]    @default([]) // Đợt 3B — tất cả vai trò người này giữ (union quyền)
  centerId      String?
  orgUnitId     String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ─── Per-user permission system (Phase 5.3.0) ───
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?

  // Cụm A1 — trạng thái kích hoạt tài khoản (phụ huynh tạo qua chuyển lead).
  accountStatus AccountStatus @default(ACTIVE)

  // Link 1-1 với Employee (1 user account ↔ 1 employee record)
  employeeId String?   @unique
  employee   Employee? @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  center             Center?             @relation(fields: [centerId], references: [id])
  accounts           Account[]
  children           Student[]           @relation("ParentChildren")
  assignedLeads      Lead[]              @relation("AssignedLeads")
  notes              Note[]
  teacherClass       Class[]             @relation("TeacherClasses")
  assistantClass     Class[]             @relation("AssistantClasses")
  teacherProfile     TeacherProfile?     @relation("UserTeacherProfile") // FIX 10
  shiftRegistrations ShiftRegistration[] // Đợt 3E
  teacherReviews     TeacherReview[]     @relation("TeacherReviewer") // FIX 10 — đánh giá nội bộ do user này tạo
  trialClasses       TrialClass[]        @relation("TrialTeacher")
  jobPostings        JobPosting[]

  honorsCreated      Honor[]           @relation("HonorCreatedBy")
  pageContentUpdated SitePageContent[] @relation("PageContentUpdatedBy")
  employeesCreated   Employee[]        @relation("EmployeeCreatedBy")

  permissionGrants   UserPermissionGrant[] @relation("UserPermissionGrants")
  permissionsGranted UserPermissionGrant[] @relation("UserPermissionGrantor")

  // Phase 5.4.0 — Audit log relations
  auditLogs      UserAuditLog[]            @relation("UserAuditLogs")
  grantAuditLogs PermissionGrantAuditLog[] @relation("UserGrantAudits")

  @@index([email])
  @@index([centerId])
  @@index([role])
  @@index([deletedAt])
  @@index([orgUnitId])
}

model UserPermissionGrant {
  id        String    @id @default(cuid())
  userId    String
  action    String // e.g. "leads:edit", phải match Action union trong lib/auth/permissions.ts
  grant     GrantType
  reason    String?   @db.Text
  grantedBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User @relation("UserPermissionGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantor User @relation("UserPermissionGrantor", fields: [grantedBy], references: [id])

  @@unique([userId, action])
  @@index([userId])
  @@index([grantedBy])
}

// Đợt 3D — 2 danh mục khoá học (nguồn chân lý nghiệp vụ).
enum CourseCategory {
  LUYEN_THI_ROBOSIM
  LAP_TRINH_ROBOT
}

// R6-B3 — Danh mục khoá học dạng MODEL (thêm danh mục không sửa code). 2-phase: enum
// CourseCategory + Course.category giữ; thêm Course.categoryId trỏ model. code khớp enum (T12).
model CourseCategoryDef {
  id           String   @id @default(cuid())
  code         String   @unique // khớp enum cũ khi backfill (LAP_TRINH_ROBOT...)
  name         String
  slug         String?  @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses Course[] @relation("CourseCategoryDef")
}

model Course {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  type        CourseType @default(OFFLINE)
  description String?    @db.Text
  price       Int?
  duration    Int?
  isActive    Boolean    @default(true)
  // R7-03 — phân loại độ tuổi / trình độ cho khóa dạy.
  ageRange    String? // vd "6-8 tuổi"
  level       String? // vd "Cơ bản"

  // Marketing fields (Phase 4.UI.FINAL)
  code             String? // Code ngắn cho product cards (vd. "LTR", "LTRS")
  shortDescription String? @db.Text
  priceDisplay     String? // "2,400,000đ" hoặc "Liên hệ"

  // Đợt 3D — phân loại danh mục + cờ "khoá cụ thể dùng để mở lớp/giảng dạy".
  category        CourseCategory? // null = không phải khoá dạy (vd mục landing cũ LTR/LTRS)
  // R6-B3 — danh mục dạng model (2-phase, song song enum `category`).
  categoryId      String?
  categoryDef     CourseCategoryDef? @relation("CourseCategoryDef", fields: [categoryId], references: [id])
  isTeachable     Boolean            @default(false)
  // Đợt 6 — số buổi CHUẨN (cam kết) của khoá; ưu tiên hơn đếm Curriculum lessons.
  totalSessions   Int?
  durationDisplay String? // "6 tháng" hoặc "Tuỳ chỉnh"
  studentCount    Int                @default(0)
  displayOrder    Int                @default(0)
  isPublished     Boolean            @default(true)

  thumbnail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads              Lead[]
  classes            Class[]
  enrollments        Enrollment[]
  curriculums        Curriculum[]
  discounts          CourseDiscount[] // R7-03
  trialRecommended   TrialFeedback[] @relation("TrialRecommendedCourse")

  // FIX 7 — khoá tiên quyết (cấu hình qua UI admin).
  prerequisites     CoursePrerequisite[] @relation("CoursePrereqOwner")
  requiredByCourses CoursePrerequisite[] @relation("CoursePrereqRequired")

  // FIX 10 — khoá GV dạy được.
  teacherCourses TeacherCourse[]
  completions    CourseCompletion[] @relation("CourseCompletions")

  @@index([slug])
  @@index([type])
  @@index([code])
  @@index([isPublished, displayOrder])
}

// FIX 7 — Khoá tiên quyết: khoá `courseId` yêu cầu hoàn thành `requiredCourseId`
// trước khi đăng ký. Nhiều-nhiều tự tham chiếu trên Course; admin tự thêm/xoá
// qua UI (không sửa code). 1 khoá có thể yêu cầu ≥1 khoá trước.
model CoursePrerequisite {
  id               String   @id @default(cuid())
  courseId         String
  requiredCourseId String
  course           Course   @relation("CoursePrereqOwner", fields: [courseId], references: [id], onDelete: Cascade)
  requiredCourse   Course   @relation("CoursePrereqRequired", fields: [requiredCourseId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([courseId, requiredCourseId])
  @@index([courseId])
  @@index([requiredCourseId])
}

// FIX 10 — Hồ sơ chuyên môn giáo viên (1-1 với User role TEACHER).
enum TeacherRank {
  TRAINEE
  JUNIOR
  ADVANCED
  SENIOR
  EXPERT
}

enum EmploymentType {
  FULLTIME
  PARTTIME
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model TeacherProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation("UserTeacherProfile", fields: [userId], references: [id], onDelete: Cascade)
  rank           TeacherRank    @default(TRAINEE)
  employmentType EmploymentType @default(PARTTIME)
  status         TeacherStatus  @default(ACTIVE)
  bio            String?        @db.Text

  teachableCourses TeacherCourse[]
  reviews          TeacherReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Khoá GV dạy được (n-n TeacherProfile ↔ Course).
model TeacherCourse {
  teacherProfileId String
  courseId         String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, courseId])
  @@index([courseId])
}

// Đánh giá nội bộ / dự giờ (PHẦN 6).
model TeacherReview {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  reviewerId       String?
  reviewer         User?          @relation("TeacherReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName     String
  score            Int // 1-5
  note             String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([teacherProfileId, createdAt])
}

model Lead {
  id               String     @id @default(cuid())
  parentName       String
  phone            String
  email            String?
  childName        String?
  childAge         Int?
  centerId         String?
  orgUnitId        String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  courseId         String?
  assignedToId     String?
  status           LeadStatus @default(NEW)
  source           String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  fbclid           String?
  gclid            String?
  fbp              String?
  fbc              String?
  eventId          String?    @unique
  landingPage      String?
  referrer         String?
  ipAddress        String?
  userAgent        String?    @db.Text
  consentMarketing Boolean    @default(false)
  note             String?    @db.Text
  handoverNote     String?    @db.Text // Module CRM PHẦN 3 — note bàn giao gần nhất (nổi bật)
  // Cụm A3 — ai/khi nào chuyển lead sang ĐÃ ĐĂNG KÝ.
  convertedById    String?
  convertedAt      DateTime?

  // R1-04/05 — mốc thời gian phễu SR.QD.217 (L1→L2→L3 + bàn giao + SLA).
  qualifiedAt         DateTime? // L2 — có SĐT + note
  handedAt            DateTime? // HO bàn giao về CS
  receivedConfirmedAt DateTime? // CS xác nhận tiếp nhận
  assignedAt          DateTime? // phân Sale
  firstContactAt      DateTime? // Sale liên hệ lần đầu
  commissionSource    CommissionSource? // nguồn để chia hoa hồng
  adminId             String? // Sale Admin xử lý L1→L2

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  center     Center? @relation(fields: [centerId], references: [id])
  course     Course? @relation(fields: [courseId], references: [id])
  assignedTo User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes      Note[]

  // Phase T1.2 — Activity timeline + follow-up tasks
  activities LeadActivity[]
  tasks      LeadTask[]

  // Phase T1.3 — chống trùng
  duplicates LeadDuplicate[] @relation("LeadDuplicates")

  // Phase T1.4 — học thử
  trialClasses TrialClass[]

  // Phase 5.4.0 — Audit log
  auditLogs LeadAuditLog[] @relation("LeadAuditLogs")

  // Phase 5.6 — Order
  orders            Order[]                 @relation("LeadOrders")
  assignmentHistory LeadAssignmentHistory[]

  // R7-01 — LeadChild (N con) + mốc hoạt động gần nhất cho SLA idle.
  children       LeadChild[]
  lastActivityAt DateTime? // cập nhật khi có LeadActivity; SLA lead_idle_24h đọc field này

  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@index([centerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([eventId])
  @@index([orgUnitId])
}

/// R7-01 — 1 Lead có N con. Nền cho lớp trải nghiệm (R7-02). Field phẳng cũ
/// (Lead.childName/childAge) giữ đọc-only (2-phase, KHÔNG drop).
model LeadChild {
  id                 String               @id @default(cuid())
  leadId             String
  lead               Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fullName           String
  dob                DateTime?            @db.Date
  ageYears           Int?
  gender             String?
  schoolName         String?
  gradeLevel         String?
  interestedCourseId String? // tham chiếu Course (không ràng FK cứng — additive)
  interestedCenterId String? // tham chiếu Center
  note               String?              @db.Text
  trialStatus        LeadChildTrialStatus @default(NONE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  trialEnrollments TrialEnrollment[] // R7-02

  @@index([leadId])
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  leadId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

enum StudentStatus {
  ACTIVE // Đang học
  PAUSED // Bảo lưu (tạm nghỉ)
  GRADUATED // Hoàn thành khoá học
  INACTIVE // Nghỉ học hẳn
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
  UNKNOWN
}

model Student {
  id          String    @id @default(cuid())
  name        String
  studentCode String?   @unique
  dateOfBirth DateTime?
  gender      Gender?
  phone       String?
  email       String?
  avatarUrl   String?

  // Education
  currentGrade Int?
  school       String?

  // Parent / Guardian
  // parentName + parentPhone stay nullable in the DB for the existing rows
  // (some seeded students lack them). Zod requires them at write time.
  parentName      String?
  parentPhone     String?
  parentEmail     String?
  parentRelation  String?
  parent2Name     String?
  parent2Phone    String?
  parent2Relation String?

  // Address
  address  String?
  ward     String?
  district String?
  city     String?

  // Health
  bloodType   BloodType?
  allergies   String[]   @default([])
  healthNotes String?    @db.Text

  // Sata Robo specific
  enrollmentDate     DateTime?     @db.Date
  preferredCenterId  String?
  preferredOrgUnitId String? // PR-A: song song preferredCenterId
  preferredCenter    Center?       @relation("StudentPreferredCenter", fields: [preferredCenterId], references: [id])
  notes              String?       @db.Text
  status             StudentStatus @default(ACTIVE)

  // Legacy "current center" — pre-D1 association, kept for compat.
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center? @relation(fields: [centerId], references: [id])

  // Phase T2.2 — liên kết tài khoản phụ huynh (portal "site con").
  // 1 PARENT User ↔ nhiều Student (các con). Học sinh KHÔNG có account riêng.
  parentUserId String?
  parentUser   User?   @relation("ParentChildren", fields: [parentUserId], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  enrollments           Enrollment[]
  attendances           Attendance[]
  examAttempts          ExamAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  progressReports       ProgressReportLog[]
  sessionFeedbacks      StudentSessionFeedback[] // LMS-2
  skillAssessments      StudentSkillAssessment[] // LMS-5

  // Phase 5.4.0 — Audit log
  auditLogs StudentAuditLog[] @relation("StudentAuditLogs")

  // Phase 5.6 — Order
  orders Order[] @relation("StudentOrders")

  // Phase 5.9 — Reserve history
  reserves StudentReserve[] @relation("StudentReserves")

  // Phase NHÓM 3 — yêu cầu phụ huynh
  parentRequests    ParentRequest[]          @relation("StudentParentRequests")
  makeupNeeds       MakeupNeed[]
  riskAlerts        StudentRiskAlert[]
  careTasks         StudentCareTask[]
  courseCompletions CourseCompletion[]
  transferRequests  StudentTransferRequest[]
  centerHistory     StudentCenterHistory[]
  satacoinTxns      SataCoinTransaction[]
  // P2 — nhóm lớp (cohort): 1 HV thuộc TỐI ĐA 1 nhóm.
  classGroupId      String?
  classGroup        ClassGroup?              @relation("ClassGroupStudents", fields: [classGroupId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([centerId])
  @@index([deletedAt])
  @@index([status])
  @@index([classGroupId])
  @@index([preferredCenterId])
  @@index([parentPhone])
  @@index([parentUserId])
  @@index([orgUnitId])
}

enum ClassStatus {
  PLANNED
  RECRUITING
  PENDING_APPROVAL // chờ quản lý duyệt (sau khi sale gán đủ HS)
  ACTIVE
  COMPLETED
  CANCELLED
}

// Phase T0.2 — Lớp cố định (nhóm học sinh đi cùng nhau qua nhiều khoá/năm)
enum ClassGroupStatus {
  ACTIVE
  GRADUATED
  DISBANDED
}

model ClassGroup {
  id          String           @id @default(cuid())
  code        String           @unique // CS<n>.LOP.<YY>.<seq> (auto codegen)
  displayCode String // mã ngắn admin tự đặt, hiển thị cho người dùng (vd "A1", "B2")
  name        String?
  centerId    String
  orgUnitId   String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  status      ClassGroupStatus @default(ACTIVE)
  notes       String?          @db.Text
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  center   Center    @relation(fields: [centerId], references: [id])
  classes  Class[]
  students Student[] @relation("ClassGroupStudents")

  @@index([centerId])
  @@index([status])
  @@index([deletedAt])
  @@index([orgUnitId])
}

model Class {
  id String @id @default(cuid())

  // Identity
  classCode   String? @unique
  name        String
  description String? @db.Text

  // Relations (existing target preserved: teacher → User)
  courseId     String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  classGroupId String? // Phase T0.2 — lớp cố định (nhóm đi cùng nhau qua các khoá)
  teacherId    String?
  assistantId  String?
  roomId       String?

  // Schedule
  schedule     String? // legacy free-text (e.g. "T2 T4 17:30")
  startDate    DateTime?
  endDate      DateTime?
  scheduleDays Int[]     @default([]) // 0=CN, 1=T2, ..., 6=T7
  startTime    String? // "HH:mm"
  endTime      String? // "HH:mm"

  // Capacity
  maxStudents Int @default(20)
  minStudents Int @default(5)

  // Status (new) + legacy isActive flag (kept for back-compat)
  status   ClassStatus @default(PLANNED)
  isActive Boolean     @default(true)

  // Module Quản lý lớp — workflow phê duyệt (approvedBy plain, không FK)
  submittedForApprovalAt DateTime?
  approvedAt             DateTime?
  approvedById           String?
  approvedByName         String?

  // Other
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // R7-06 — pin curriculum version lúc tạo lớp (snapshot; null = lớp cũ, helper fallback).
  curriculumId      String?
  curriculumVersion Int?

  course          Course              @relation(fields: [courseId], references: [id])
  center          Center?             @relation(fields: [centerId], references: [id])
  classGroup      ClassGroup?         @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  teacher         User?               @relation("TeacherClasses", fields: [teacherId], references: [id])
  assistant       User?               @relation("AssistantClasses", fields: [assistantId], references: [id])
  room            Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  sessions        ClassSession[]
  sessionPlans    ClassSessionPlan[] // R7-06
  exams           Exam[]
  assignments     Assignment[]
  progressReports ProgressReportLog[]
  trialClasses    TrialClass[]
  makeupNeeds     MakeupNeed[]

  // Phase 5.4.0 — Audit log
  auditLogs ClassAuditLog[] @relation("ClassAuditLogs")

  @@index([courseId])
  @@index([centerId])
  @@index([classGroupId])
  @@index([teacherId])
  @@index([deletedAt])
  @@index([status, centerId])
  @@index([courseId, status])
  @@index([roomId])
  @@index([orgUnitId])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  courseId  String
  status    EnrollmentStatus @default(ACTIVE)

  // Financial (legacy)
  tuition Int?
  paidAt  DateTime?

  // R7-03 — snapshot giá 4 thành phần (ghi tại convert/R7-05; bất biến khi đổi bảng giá).
  // `tuition` cũ giữ (2-phase); helper computeEnrollmentPrice fallback tuition khi null.
  listPrice      Int? // giá niêm yết Course tại thời điểm chốt
  discountType   String? // CourseDiscountType áp dụng (snapshot dạng string)
  discountAmount Int? // số tiền giảm thực tế
  finalPrice     Int? // phải thu sau giảm (clamp ≥ 0)

  // Legacy dates (kept for back-compat)
  startDate DateTime?
  endDate   DateTime?

  // D5 workflow timestamps
  enrolledAt  DateTime  @default(now())
  confirmedAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  // Transfer
  transferredToId String?
  transferredTo   Enrollment?  @relation("EnrollmentTransfer", fields: [transferredToId], references: [id])
  transferredFrom Enrollment[] @relation("EnrollmentTransfer")
  transferReason  String?      @db.Text

  // Other
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  auditLogs EnrollmentAuditLog[]

  // Phase 5.6 — Order item link
  orderItems OrderItem[] @relation("EnrollmentOrderItems")

  // Phase 5.9 — Reserve link (enrollment-specific reserves only; whole-student
  // reserves leave enrollmentId NULL)
  reserves StudentReserve[] @relation("EnrollmentReserves")
  payments Payment[]        @relation("EnrollmentPayments") // R7-04
  receipts Receipt[]        @relation("EnrollmentReceipts") // R7-04

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@index([classId, status])
  @@index([studentId, status])
  @@index([status, enrolledAt])
}

model EnrollmentAuditLog {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  fromStatus String
  toStatus   String

  changedByUserId String?
  changedByName   String

  reason    String? @db.Text
  extraData Json?

  createdAt DateTime @default(now())

  @@index([enrollmentId, createdAt])
}

model ClassSession {
  id      String   @id @default(cuid())
  classId String
  date    DateTime
  topic   String?
  notes   String?  @db.Text

  // Phase E6 — link session to curriculum lesson for progress tracking
  lessonId    String?
  lessonNotes String? @db.Text
  // R7-06 — trỏ tới ClassSessionPlan (kế hoạch buổi của lớp); lessonId cũ giữ 2-phase.
  planId      String?

  // LMS-3 — quy trình sau buổi + checklist
  status            SessionStatus @default(SCHEDULED)
  startedAt         DateTime?
  completedAt       DateTime?
  // Chuẩn bị phòng học (Module QL lớp phần 3)
  ckClean           Boolean       @default(false)
  ckEquipment       Boolean       @default(false)
  ckKit             Boolean       @default(false)
  ckAttendance      Boolean       @default(false)
  ckLessonConfirmed Boolean       @default(false)
  ckFeedback        Boolean       @default(false)
  ckMedia           Boolean       @default(false)
  ckHomework        Boolean       @default(false)
  ckIncident        Boolean       @default(false)
  incidentNote      String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class            Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson           Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  plan             ClassSessionPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  attendances      Attendance[]
  studentFeedbacks StudentSessionFeedback[] // LMS-2

  @@index([classId])
  @@index([date])
  @@index([lessonId])
  @@index([planId])
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED // R7-06 — hủy buổi (không xóa); buổi bù sinh cuối lịch
}

/// R7-03 — loại ưu đãi theo khóa (áp toàn hệ thống, KHÔNG per-center).
enum CourseDiscountType {
  AMOUNT // giảm số tiền tuyệt đối (VND)
  PERCENT // giảm theo %
  SCHOLARSHIP // học bổng (PERCENT đặc biệt, có điều kiện)
  PROGRAM // ưu đãi chương trình (combo/đợt)
}

// LMS-5 — Hồ sơ năng lực robotics.
enum SkillLevel {
  NEED_SUPPORT
  BASIC
  GOOD
  EXCELLENT
}

enum RoboticsSkill {
  MECH_ASSEMBLY
  ALGORITHM
  PROGRAMMING
  SENSOR
  MOTOR_CONTROL
  PROBLEM_SOLVING
  TEAMWORK
  PRESENTATION
  CREATIVITY
  COMPETITION_READY
}

model StudentSkillAssessment {
  id           String        @id @default(cuid())
  studentId    String
  skill        RoboticsSkill
  level        SkillLevel
  note         String?
  assessedById String
  assessedAt   DateTime      @default(now())
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, skill])
}

// LMS-2 — nhận xét RIÊNG từng học sinh mỗi buổi (GV viết, PH xem con mình).
model StudentSessionFeedback {
  id             String       @id @default(cuid())
  classSessionId String
  studentId      String
  comment        String       @db.Text
  rating         Int? // 1-5 tuỳ chọn
  createdById    String // GV
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([studentId])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?

  // Module QL học viên PHẦN 2 — vắng có cấu trúc.
  makeupStatus    MakeupStatus @default(NONE)
  makeupSessionId String? // buổi đã học bù (set khi MADE_UP) — cột phẳng, không FK
  absenceReason   String?      @db.Text // lý do phụ huynh xin vắng

  // Commit 5 — mốc đã gửi thông báo điểm danh cho phụ huynh (chống gửi trùng).
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([studentId, makeupStatus])
}

// ─── Content & Marketing ─────────────────────────────────────────────────────

model PageContent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     Json
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

enum ExperienceLevel {
  ENTRY // Mới ra trường, không yêu cầu kinh nghiệm
  JUNIOR // 1-2 năm
  MID // 3-5 năm
  SENIOR // 5+ năm
  EXPERT // Chuyên gia 10+ năm
}

model JobPosting {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  department       String?
  location         String?
  type             String?
  description      String           @db.Text
  workingHours     String?
  experienceLevel  ExperienceLevel?
  responsibilities String[]         @default([])
  requirements     String[]         @default([])
  benefits         String[]         @default([])
  salary           String?
  salaryMin        Int?
  salaryMax        Int?
  salaryNote       String?
  openings         Int              @default(1)
  status           JobStatus        @default(OPEN)
  authorId         String?
  contactEmail     String?
  contactPhone     String?
  closesAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  author       User?            @relation(fields: [authorId], references: [id])
  applications JobApplication[]

  @@index([slug])
  @@index([status])
  @@index([department])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  name        String
  email       String
  phone       String
  cvUrl       String?
  coverLetter String?           @db.Text
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([email])
}

model MarketingConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================
// COURSE PACKAGES (Phase 4.UI.RESET.2 PART D3)
// Sata1-Sata8 + Combo packages — children of Course "laptrinhrobot"
// ============================================
model CoursePackage {
  id               String  @id @default(cuid())
  slug             String  @unique
  code             String
  name             String
