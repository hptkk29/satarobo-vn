  slug           String    @unique
  title          String
  excerpt        String    @db.Text
  content        String    @db.Text
  coverImage     String?
  category       String?
  tags           String[]
  isPublished    Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  publishedAt    DateTime?
  displayOrder   Int       @default(0)
  seoTitle       String?
  seoDescription String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
}

// ============================================
// HALL OF FAME — VINH DANH NHÂN SỰ
// ============================================

enum HonorCategory {
  SPARK
  GROWTH
  IMPACT
  GRAND_CHAMPION
}

model Honor {
  id   String @id @default(cuid())
  slug String @unique

  // Link sang Employee (source of truth cho thông tin nhân sự)
  // Tạm thời nullable để migration backfill xong mới enforce NOT NULL ở Phase 4.7.1
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Snapshot lúc trao giải (override Employee data hiện tại nếu cần)
  jobTitleAtTime String?
  yearsAtTime    Int?

  // DEPRECATED: Giữ tạm để code cũ rollback an toàn, sẽ drop ở Phase 4.7.1
  // Code mới đọc qua honor.employee.fullName / jobTitle / avatarUrl
  fullName       String?
  jobTitle       String?
  avatarUrl      String?
  yearsAtCompany Int?

  category     HonorCategory
  awardName    String
  awardedAt    DateTime
  awardQuarter String?

  story        String  @db.Text
  shortBio     String? @db.VarChar(280)
  pullQuote    String? @db.VarChar(500)
  achievements String? @db.Text

  isFeatured   Boolean @default(false)
  isPublished  Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("HonorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isFeatured])
  @@index([isPublished, displayOrder])
  @@index([employeeId])
}

model TimelineItem {
  id              String   @id @default(cuid())
  occurredAt      DateTime
  title           String
  description     String   @db.Text
  coverImageUrl   String?
  relatedHonorIds String?
  isPublished     Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, occurredAt])
}

model SitePageContent {
  id           String   @id @default(cuid())
  pageKey      String
  contentKey   String
  contentValue String   @db.Text
  updatedAt    DateTime @updatedAt
  updatedById  String?
  updatedBy    User?    @relation("PageContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([pageKey, contentKey])
  @@index([pageKey])
}

// ============================================
// EMPLOYEE MODULE
// ============================================

enum Department {
  BAN_GIAM_DOC
  DAO_TAO
  MARKETING
  KINH_DOANH
  IT
  HANH_CHANH_NHAN_SU
  KE_TOAN
  // Phase 4.7 extension
  TUYEN_SINH
  GIAO_VU
  GIANG_DAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractType {
  FULLTIME
  PARTTIME
  INTERN
  FREELANCE
  // Phase 4.7 extension — Vietnam labor law contract types
  THU_VIEC
  CHINH_THUC_XAC_DINH
  CHINH_THUC_KHONG_XAC_DINH
}

enum EmploymentStatus {
  ACTIVE // Đang làm
  ON_LEAVE // Tạm nghỉ (sản, ốm dài)
  RESIGNED // Đã nghỉ tự nguyện
  TERMINATED // Bị cho nghỉ
}

model Employee {
  id String @id @default(cuid())

  // Tier 1: cơ bản
  employeeCode String     @unique
  fullName     String
  jobTitle     String
  department   Department
  avatarUrl    String?
  email        String?    @unique
  joinedAt     DateTime?
  bio          String?    @db.Text
  isActive     Boolean    @default(true)
  isPublic     Boolean    @default(false)
  displayOrder Int        @default(0)

  // Tier 2: HR cơ bản
  phone        String?
  dateOfBirth  DateTime?
  gender       Gender?
  contractType ContractType?
  salaryRank   Int?
  salaryLevel  Int?

  // Phase 4.7 — additional Tier 2 HR fields
  endDate          DateTime? // Ngày kết thúc HĐ (cho hợp đồng có thời hạn)
  bhxhBase         Float? // Mức lương đóng BHXH
  address          String?
  emergencyContact String? // Tên - Quan hệ - SĐT
  notes            String?   @db.Text

  // Phase C1 — extended HR fields
  nationalId     String? // CCCD / CMND
  status         EmploymentStatus @default(ACTIVE)
  subjects       String[]         @default([]) // Môn dạy (mainly for GIANG_DAY / DAO_TAO)
  certifications String[]         @default([]) // Chứng chỉ chuyên môn

  // Cơ sở làm việc
  centerId String?
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  // Self-relation: quản lý trực tiếp
  managerId    String?
  manager      Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeManager")

  // CEO flag (chỉ 1 employee được isCEO=true tại 1 thời điểm)
  isCEO Boolean @default(false)

  // Meta
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Relations
  honors             Honor[]
  userAccount        User?                  @relation("UserEmployee")
  roleAuditLogs      RoleAuditLog[]
  authoredQuestions  Question[]             @relation("QuestionAuthor")
  createdExams       Exam[]                 @relation("ExamCreator")
  gradedAttempts     ExamAttempt[]          @relation("AttemptGrader")
  uploadedDocuments  Document[]             @relation("DocumentUploader")
  createdAssignments Assignment[]           @relation("AssignmentCreator")
  gradedSubmissions  AssignmentSubmission[] @relation("SubmissionGrader")
  generatedReports   ProgressReportLog[]    @relation("ReportGenerator")
  performedMovements StockMovement[]        @relation("MovementPerformer")
  performedAudits    InventoryAudit[]       @relation("AuditPerformer")

  @@index([department])
  @@index([isActive])
  @@index([isPublic])
  @@index([isCEO])
  @@index([status])
}

// Audit trail for User.role changes scoped to one Employee (the linked
// userAccount's role). Stored as String (not Role enum) so the log
// stays readable if the enum ever shifts. Cascade on Employee delete.
model RoleAuditLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  fromRole String
  toRole   String

  changedByUserId String? // nullable — defensive if the auditor User row gets removed
  changedByName   String // snapshot so the trail is human-readable even after deletion

  reason String? @db.Text

  createdAt DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([createdAt])
}

// ─── Phase 4.UI.FIX.2 ─────────────────────────────────────────────────────
// Học cụ Robotics ZMROBO — 3 bộ kit (Alpha / Beta / Intelligence Storm).
// Specs/features/highlights là JSON để giữ schema linh hoạt.
model ZMRoboKit {
  id   String @id @default(cuid())
  slug String @unique

  brand            String  @default("ZMROBO")
  series           String
  code             String?
  title            String
  subtitle         String
  shortDescription String  @db.Text
  description      String  @db.Text

  priceDisplay String  @default("Liên hệ tư vấn")
  isAvailable  Boolean @default(true)

  specs      Json
  features   Json
  highlights Json

  mainImage     String   @default("")
  galleryImages String[]

  sourceUrl String?

  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 5.10 — Product catalog link
  products Product[]

  @@index([slug])
  @@index([isPublished, displayOrder])
}

// ─── Phase E1 ─────────────────────────────────────────────────────────────
// Curriculum (Giáo trình) chứa Lesson (Bài học). Tách rời khỏi Course để
// course (protected) giữ metadata, còn syllabus có thể update qua versions.
model Curriculum {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  version     Int     @default(1)
  name        String
  description String? @db.Text

  isActive Boolean          @default(true)
  status   CurriculumStatus @default(ACTIVE) // LMS-1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, version])
  @@index([courseId, isActive])
}

enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Lesson {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  order Int

  title       String
  description String? @db.Text
  content     String? @db.Text

  duration   Int      @default(90)
  objectives String[] @default([])
  materials  String[] @default([]) // LMS-1: dùng làm "Thiết bị cần chuẩn bị"

  notes String? @db.Text

  // LMS-1 — giáo án chi tiết
  teacherGuide       String? @db.Text // hướng dẫn giảng dạy
  expectedOutput     String? @db.Text // kết quả mong đợi
  homeworkDefault    String? @db.Text // bài tập mặc định
  assessmentCriteria String? @db.Text // tiêu chí đánh giá

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions     Question[]
  exams         Exam[]
  documents     Document[]
  assignments   Assignment[]
  classSessions ClassSession[]

  @@unique([curriculumId, order])
  @@index([curriculumId])
}

// ─── Phase E2 ─────────────────────────────────────────────────────────────
// Question bank with 5 types. Choice (cascade) only used by MULTIPLE_CHOICE
// + TRUE_FALSE; correctAnswer used by SHORT_ANSWER / CODE / ESSAY.
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  CODE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Question {
  id String @id @default(cuid())

  questionCode String?      @unique
  type         QuestionType
  text         String       @db.Text
  explanation  String?      @db.Text

  difficulty QuestionDifficulty @default(MEDIUM)
  tags       String[]           @default([])

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  // For SHORT_ANSWER / CODE / ESSAY
  correctAnswer String? @db.Text

  // For MULTIPLE_CHOICE / TRUE_FALSE
  choices Choice[]

  examQuestions ExamQuestion[]

  authorId String?
  author   Employee? @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  isPublic Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([type, difficulty])
  @@index([authorId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  order     Int
  text      String  @db.Text
  isCorrect Boolean @default(false)

  @@unique([questionId, order])
}

// ─── Phase E3 — Exam workflow ────────────────────────────────────────────
enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  REVIEWED
}

model Exam {
  id String @id @default(cuid())

  examCode    String? @unique
  title       String
  description String? @db.Text

  classId  String?
  class    Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  durationMinutes  Int     @default(60)
  totalPoints      Float   @default(10)
  passingScore     Float   @default(5)
  shuffleQuestions Boolean @default(false)
  shuffleChoices   Boolean @default(false)

  openAt  DateTime?
  closeAt DateTime?

  status ExamStatus @default(DRAFT)

  createdById String?
  createdBy   Employee? @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([status, classId])
  @@index([lessonId])
  @@index([createdById])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  order  Int
  points Float @default(1)

  answers ExamAnswer[]

  @@unique([examId, order])
  @@unique([examId, questionId])
  @@index([examId])
}

model ExamAttempt {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  status     AttemptStatus @default(IN_PROGRESS)
  totalScore Float?
  passed     Boolean?

  gradedById String?
  gradedBy   Employee? @relation("AttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  feedback   String?   @db.Text

  answers ExamAnswer[]

  // Phase 5.6 — Order item link
  orderItems OrderItem[] @relation("ExamOrderItems")

  @@unique([examId, studentId])
  @@index([status, examId])
  @@index([studentId])
}

model ExamAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id])

  selectedChoiceIds String[] @default([])
  textAnswer        String?  @db.Text

  isCorrect  Boolean?
  score      Float?
  graderNote String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, examQuestionId])
}

// ─── Phase E4 — Document management ──────────────────────────────────────
enum DocumentType {
  PDF
  IMAGE
  VIDEO
  SLIDE
  WORKSHEET
  AUDIO
  OTHER
}

model Document {
  id String @id @default(cuid())

  documentCode String? @unique
  title        String
  description  String? @db.Text

  type     DocumentType
  fileUrl  String
  fileName String
  fileSize Int
  mimeType String?

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  isPublic Boolean @default(false)

  tags  String[] @default([])
  notes String?  @db.Text

  uploadedById String?
  uploadedBy   Employee? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentDocs AssignmentDocument[]

  @@index([lessonId])
  @@index([type])
  @@index([isPublic])
  @@index([uploadedById])
}

// ─── Phase E5 — Assignment + Submission workflow ─────────────────────────
enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  GRADED
}

model Assignment {
  id String @id @default(cuid())

  title        String
  description  String  @db.Text
  instructions String? @db.Text

  classId  String
  class    Class   @relation(fields: [classId], references: [id])
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  totalPoints Float @default(10)

  assignedAt DateTime  @default(now())
  dueAt      DateTime?

  allowText Boolean @default(true)
  allowFile Boolean @default(true)

  status AssignmentStatus @default(DRAFT)

  createdById String?
  createdBy   Employee? @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions AssignmentSubmission[]
  documents   AssignmentDocument[]

  @@index([status, classId])
  @@index([dueAt])
  @@index([createdById])
}

model AssignmentDocument {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document   @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([assignmentId, documentId])
  @@index([documentId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])

  textAnswer String? @db.Text
  fileUrl    String?
  fileName   String?
  fileSize   Int?
  mimeType   String?

  submittedAt DateTime?
  status      SubmissionStatus @default(NOT_SUBMITTED)

  score      Float?
  feedback   String?   @db.Text
  gradedAt   DateTime?
  gradedById String?
  gradedBy   Employee? @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([status, assignmentId])
  @@index([studentId])
}

// ─── Phase E7 — Audit log for generated PDF reports ──────────────────────
model ProgressReportLog {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  generatedById String?
  generatedBy   Employee? @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime  @default(now())
  sentToEmail   String?
  sentAt        DateTime?
  reportTitle   String
  metadata      Json?

  @@index([studentId, generatedAt])
  @@index([classId])
  @@index([generatedAt])
}

// ─── Phase F — Inventory ─────────────────────────────────────────────────
enum InventoryCategory {
  MAINBOARD
  SENSOR
  MOTOR
  BATTERY
  MECHANICAL
  WIRE
  TOOL
  CONSUMABLE
  ROBOSIM
  OTHER
}

model InventoryItem {
  id String @id @default(cuid())

  itemCode    String  @unique
  name        String
  description String? @db.Text

  category InventoryCategory @default(OTHER)
  unit     String            @default("Cái")

  pricePerUnit Float?
  supplier     String?

  defaultMinThreshold Int @default(5)

  imageUrl String?
  tags     String[] @default([])

  isActive Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances   StockBalance[]
  movements  StockMovement[]
  auditItems InventoryAuditItem[] @relation("AuditedItem")

  @@index([category, isActive])
}

model StockBalance {
  id       String        @id @default(cuid())
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  centerId String
  center   Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)

  quantity     Int  @default(0)
  reserved     Int  @default(0)
  minThreshold Int?

  lastReceiptAt DateTime?
  lastIssueAt   DateTime?

  updatedAt DateTime @updatedAt

  @@unique([itemId, centerId])
  @@index([centerId, quantity])
}

// ─── Phase F2 — Stock movement workflow ──────────────────────────────────
enum StockMovementType {
  RECEIPT // Nhập kho từ supplier
  ISSUE // Xuất kho cho lớp / sự kiện / hỏng
  TRANSFER_OUT // Chuyển đi cơ sở khác
  TRANSFER_IN // Nhận từ cơ sở khác
  ADJUSTMENT_INCREASE // Kiểm kê thừa
  ADJUSTMENT_DECREASE // Kiểm kê thiếu
}

model StockMovement {
  id String @id @default(cuid())

  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id])
  centerId String
  center   Center        @relation(fields: [centerId], references: [id])

  type     StockMovementType
  quantity Int

  // TRANSFER pair link (OUT ↔ IN)
  transferPairId String?
  transferPair   StockMovement?  @relation("TransferPair", fields: [transferPairId], references: [id])
  transferOf     StockMovement[] @relation("TransferPair")

  // Free-form reference linking
  referenceType String?
  referenceId   String?
  referenceNote String?

  // Pricing snapshot (RECEIPT only)
  unitPrice Float?
  totalCost Float?

  performedById String?
  performedBy   Employee? @relation("MovementPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  performedAt   DateTime  @default(now())
  notes         String?   @db.Text

  auditItem InventoryAuditItem? @relation("AuditMovement")

  @@index([itemId, centerId, performedAt])
  @@index([centerId, performedAt])
  @@index([type, performedAt])
  @@index([transferPairId])
}

// ─── Phase F4 — Inventory audit (kiểm kê) ────────────────────────────────
enum InventoryAuditStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryAudit {
  id        String  @id @default(cuid())
  auditCode String? @unique
  centerId  String
  center    Center  @relation(fields: [centerId], references: [id])

  status InventoryAuditStatus @default(DRAFT)

  // Snapshot stats (filled on submit)
  totalItems     Int @default(0)
  totalAdjusted  Int @default(0)
  totalIncreases Int @default(0)
  totalDecreases Int @default(0)

  performedById String?
  performedBy   Employee? @relation("AuditPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  performedAt   DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryAuditItem[]

  @@index([centerId, performedAt])
  @@index([status])
}

model InventoryAuditItem {
  id      String         @id @default(cuid())
  auditId String
  audit   InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemId  String
  item    InventoryItem  @relation("AuditedItem", fields: [itemId], references: [id])

  previousQty Int
  actualQty   Int
  delta       Int

  reason String? @db.Text

  // Link to the ADJUSTMENT movement generated on submit (null in DRAFT).
  movementId String?        @unique
  movement   StockMovement? @relation("AuditMovement", fields: [movementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([auditId, itemId])
  @@index([itemId])
}

// =============================================================================
// Phase 5.4.0 — Audit log foundation (5 domain-specific models)
// =============================================================================
// Follow pattern from RoleAuditLog + EnrollmentAuditLog: FK Cascade to target
// entity, nullable changedByUserId (defensive — no FK), changedByName snapshot
// for human-readable history forever, reason Text + metadata Json for extensibility.
// String action field (not enum) for consistency with existing pattern.
// =============================================================================

model UserAuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DISABLE" | "ENABLE" | "PASSWORD_RESET" | "ROLE_CHANGE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

model PermissionGrantAuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserGrantAudits", fields: [userId], references: [id], onDelete: Cascade)

  // grant snapshot — no FK because grant can be removed (REMOVE action)
  grantId   String?
  actionKey String // e.g. "users:manage"

  action String // "ADD" | "UPDATE" | "REMOVE"

  changedByUserId String?
  changedByName   String

  oldGrant String? // "ALLOW" | "DENY" | null (on ADD)
  newGrant String? // "ALLOW" | "DENY" | null (on REMOVE)

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

model LeadAuditLog {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation("LeadAuditLogs", fields: [leadId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DELETE" | "ASSIGN" | "STATUS_CHANGE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Lead Activity + Task (Phase T1.2) ───────────────────────────────────────

enum LeadActivityType {
  CALL
  MESSAGE
  NOTE
  STATUS_CHANGE
  EMAIL
}

enum LeadTaskStatus {
  OPEN
  DONE
  SKIPPED
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String
  type      LeadActivityType
  content   String           @db.Text
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
}

model LeadTask {
  id             String         @id @default(cuid())
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedToName String?
  title          String
  description    String?        @db.Text
  dueAt          DateTime
  completedAt    DateTime?
  status         LeadTaskStatus @default(OPEN)
  createdAt      DateTime       @default(now())

  @@index([leadId])
  @@index([assignedToId, status, dueAt])
  @@index([status, dueAt])
}

// Phase T1.3 — log lần submit trùng SĐT (đã chặn tạo lead mới)
model LeadDuplicate {
  id             String   @id @default(cuid())
  primaryLeadId  String
  primaryLead    Lead     @relation("LeadDuplicates", fields: [primaryLeadId], references: [id], onDelete: Cascade)
  duplicatePhone String
  source         String?
  matchedAt      DateTime @default(now())

  @@index([primaryLeadId])
  @@index([duplicatePhone])
}

model ClassAuditLog {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation("ClassAuditLogs", fields: [classId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DELETE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([classId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

model StudentAuditLog {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation("StudentAuditLogs", fields: [studentId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DELETE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// =============================================================================
// Phase 5.6.0 — Payment + Order foundation
// =============================================================================
// Order is polymorphic via OrderItem.type (COURSE/PACKAGE/EXAM/PRODUCT).
// Customer info snapshotted on Order (immutable per order — no Parent model yet).
// VND-only Int storage. No Decimal, no multi-currency.
// Status workflow enforced at app layer via lib/orders/status.ts.
// =============================================================================

model PaymentMethod {
  id          String            @id @default(cuid())
  code        String            @unique // "CASH", "BANK_TRANSFER", "VNPAY", "TINGEE"
  name        String
  type        PaymentMethodType
  image       String?
  description String?           @db.Text

  // Allowed-for flags (match SataWorld pattern)
  canBuyCourse  Boolean @default(true)
  canBuyPackage Boolean @default(true)
  canBuyExam    Boolean @default(true)
  canBuyProduct Boolean @default(false) // Sprint 5.10
  canDeposit    Boolean @default(false) // wallet topup — reserved

  // Bank account info (BANK_TRANSFER only)
  bankName          String?
  bankBranch        String?
  bankAccountNumber String?
  bankAccountName   String?

  // Gateway config (VNPAY/TINGEE only) — defer Sprint 5.6.5
  gatewayConfig Json?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  // Phase 5.6.1 — Audit log
  auditLogs PaymentMethodAuditLog[]

  @@index([code])
  @@index([isActive, displayOrder])
}

model Order {
  id     String      @id @default(cuid())
  code   String      @unique // "ORD-260521-000001"
  type   OrderType
  status OrderStatus @default(DRAFT)

  // Customer snapshot (immutable per order)
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String? @db.Text
  customerWard    String?
  customerCity    String?

  // Optional links
  studentId String?
  student   Student? @relation("StudentOrders", fields: [studentId], references: [id])

  leadId String?
  lead   Lead?   @relation("LeadOrders", fields: [leadId], references: [id])

  centerId String?
  center   Center? @relation(fields: [centerId], references: [id])

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  // Amounts (VND, Int)
  subtotal       Int @default(0)
  discountAmount Int @default(0)
  shippingFee    Int @default(0)
  totalAmount    Int @default(0)

  // Voucher (Sprint 5.7 — nullable, no FK yet)
  voucherCode String?

  // Payment proof / external refs
  bankReference String?
  gatewayTxnId  String?
  paidAt        DateTime?

  // Confirmation by staff
  confirmedByUserId String?
  confirmedAt       DateTime?

  customerNote String? @db.Text
  internalNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  history OrderStatusHistory[]

  // Sprint 5.7 — Voucher
  voucherRedemption VoucherRedemption? @relation("OrderVoucherRedemption")

  @@index([code])
  @@index([status])
  @@index([type, status])
  @@index([studentId])
  @@index([leadId])
  @@index([centerId, createdAt])
  @@index([createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    OrderItemType

  // Polymorphic refs (only one non-null per row, by type)
  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentOrderItems", fields: [enrollmentId], references: [id])

  packageId String?
  package   CoursePackage? @relation(fields: [packageId], references: [id])

  examAttemptId String?
  examAttempt   ExamAttempt? @relation("ExamOrderItems", fields: [examAttemptId], references: [id])

  // Phase 5.10.1 — FK to Product (SetNull on product delete)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Item display snapshot (immutable)
  itemName        String
  itemDescription String? @db.Text

  // Pricing (VND, Int)
  quantity   Int @default(1)
  unitPrice  Int
  totalPrice Int

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([type])
  @@index([enrollmentId])
  @@index([packageId])
  @@index([examAttemptId])
  @@index([productId])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus
  toStatus   OrderStatus

  changedByUserId String? // no FK, defensive (consistent with audit log pattern)
  changedByName   String

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// Phase 5.6.1 — PaymentMethod audit log
model PaymentMethodAuditLog {
  id              String        @id @default(cuid())
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "ENABLE" | "DISABLE"

  changedByUserId String? // no FK, defensive
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([paymentMethodId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Phase 5.7 — Voucher foundation ───────────────────────────────────────
// 5 types (COURSE/PACKAGE/KIT_ROBOT/SENSOR/ALL) × 2 discount kinds
// (PERCENT + max cap, FIXED). KIT_ROBOT/SENSOR can't apply until Sprint 5.10
// adds Product model — created here to lock the schema shape early.

model Voucher {
  id           String              @id @default(cuid())
  code         String              @unique // "OPENING2026", "SATA8_LAUNCH"
  name         String // "Giảm 20% khai trương 2026"
  description  String?             @db.Text
  type         VoucherType
  discountKind VoucherDiscountKind

  // Discount values — one of two non-null depending on discountKind
  discountPercent Int? // 1-100 (when PERCENT)
  discountAmount  Int? // VND (when FIXED)
  maxDiscount     Int? // cap VND (only when PERCENT)
  minOrderValue   Int  @default(0)

  // Usage limits
  quantity          Int? // null = unlimited
  usedCount         Int  @default(0)
  usageLimitPerUser Int  @default(1)

  // Validity
  validFrom  DateTime
  validUntil DateTime
  isActive   Boolean  @default(true)

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  redemptions VoucherRedemption[]
  auditLogs   VoucherAuditLog[]

  @@index([code])
  @@index([type, isActive, validFrom, validUntil])
  @@index([createdAt])
}

model VoucherRedemption {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  orderId String @unique // 1 order = 1 voucher max
  order   Order  @relation("OrderVoucherRedemption", fields: [orderId], references: [id], onDelete: Cascade)

  customerPhone String // snapshot for per-user limit check
  customerId    String? // future: User account link (no FK, defensive)

  discountApplied Int // VND actual discount snapshot

  redeemedAt DateTime @default(now())

  @@index([voucherId, redeemedAt])
  @@index([customerPhone, voucherId])
}

model VoucherAuditLog {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  action          String // CREATE | UPDATE | ENABLE | DISABLE
  changedByUserId String? // no FK, defensive
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([voucherId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Phase 5.9 — Student lifecycle: reserve history ───────────────────────
// Multiple reserve periods per student. enrollmentId NULL = áp dụng cho mọi
// active enrollment của học viên (whole-student reserve). Actor info được
// snapshot (không FK) để giữ audit trail dù user gốc bị xoá.

model StudentReserve {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation("StudentReserves", fields: [studentId], references: [id], onDelete: Cascade)

  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentReserves", fields: [enrollmentId], references: [id], onDelete: SetNull)

  reason        String    @db.Text
  startedAt     DateTime  @default(now())
  expectedEndAt DateTime?
  endedAt       DateTime?
  endReason     String?   @db.Text

  // Actor snapshots — no FK (defensive)
  createdByUserId String?
  createdByName   String
  endedByUserId   String?
  endedByName     String?

  // Denormalised flag (= endedAt is null) for fast queries.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, isActive])
  @@index([studentId, startedAt])
  @@index([startedAt])
  @@index([endedAt])
}

// ─── Phase 5.10 — Product catalog (sales/rental SKU layer) ────────────────
// Distinct from ZMRoboKit (marketing catalog). Product = sellable SKU with
// inventory + pricing + audit trail. Global stockOnHand for v1; per-center
// stock deferred. Optional zmroboKitId link for kit products that match a
// public marketing entry.

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  description String? @db.Text

  category ProductCategory
  status   ProductStatus   @default(DRAFT)

  // Pricing (VND, Int)
  salePrice           Int
  costPrice           Int? // internal-only
  rentalPricePerMonth Int?

  // Stock (global v1)
  stockOnHand  Int @default(0)
  minThreshold Int @default(0)

  // Display
  imageUrls String[] @default([])

  // Optional link to public ZMRoboKit marketing entry
  zmroboKitId String?
  zmroboKit   ZMRoboKit? @relation(fields: [zmroboKitId], references: [id], onDelete: SetNull)

  attributes Json?
  notes      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements ProductMovement[]
  auditLogs ProductAuditLog[]

  // Phase 5.10.1 — order item references
  orderItems OrderItem[]

  @@index([category, status])
  @@index([status])
  @@index([sku])
}

model ProductMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     ProductMovementType
  quantity Int // signed: + for in, - for out

  reason String? @db.Text

  // Optional link (filled when type = SALE in Phase 5.10.1)
  orderId String?

  // Stock snapshots (denormalised for audit)
  stockBeforeMovement Int
  stockAfterMovement  Int

  createdByUserId String?
  createdByName   String

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type])
  @@index([orderId])
}

model ProductAuditLog {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  action String // CREATE | UPDATE | DELETE | STATUS_CHANGE

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  changedByUserId String?
  changedByName   String

  reason String? @db.Text

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// ─── Email System (Phase 5.13.0) ─────────────────────────────────────────────

enum EmailTemplateTrigger {
  ORDER_CONFIRMATION
  PAYMENT_RECEIPT
  RESERVATION_NOTICE
  WITHDRAWAL_NOTICE
  RENEWAL_REMINDER
  CLASS_REMINDER
  MANUAL
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model EmailTemplate {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String? @db.Text

  trigger  EmailTemplateTrigger
  isActive Boolean              @default(true)

  subject  String
  bodyText String @db.Text
  bodyHtml String @db.Text

  availableVariables String[] @default([])

  fromName String?
  replyTo  String?

  sentCount  Int       @default(0)
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs EmailLog[]

  @@index([trigger, isActive])
  @@index([code])
}

model EmailLog {
  id String @id @default(cuid())

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  toEmail  String
  toName   String?
  subject  String
  bodyText String  @db.Text
  bodyHtml String  @db.Text

  status        EmailLogStatus @default(PENDING)
  resendId      String?
  failureReason String?        @db.Text

  contextType String?
  contextId   String?

  triggeredByUserId String?
  triggeredByName   String?
  triggerType       String

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([templateId, createdAt])
  @@index([toEmail, createdAt])
  @@index([contextType, contextId])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ─── Counter (Phase T0.2) ────────────────────────────────────────────────────
// Atomic sequence generator cho mã định danh CS<n>.<LOAI>.<YY>.<seq>.
// key dạng "<LOAI>:<centerCode>:<yy>" (vd "HV:CS1:26") — seq reset theo năm.
model Counter {
  id        String   @id @default(cuid())
  key       String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Trial Class + Webhook (Phase T1.4) ──────────────────────────────────────

enum TrialClassStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  MISSED
  POSTPONED
  ENROLLED
  REJECTED
}

enum ChildGrasp {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
}

model TrialClass {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  centerId    String?
  center      Center?          @relation(fields: [centerId], references: [id])
  classId     String?
  class       Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  roomId      String?
  room        Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     User?            @relation("TrialTeacher", fields: [teacherId], references: [id])
  scheduledAt DateTime
  status      TrialClassStatus @default(SCHEDULED)
  attendedAt  DateTime?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  feedback TrialFeedback?

  @@index([leadId])
  @@index([centerId, scheduledAt])
  @@index([status, scheduledAt])
}

model TrialFeedback {
  id                  String      @id @default(cuid())
  trialClassId        String      @unique
  trialClass          TrialClass  @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  childEnjoyed        Boolean?
  childGrasp          ChildGrasp?
  teacherSuggestion   String?     @db.Text
  parentFeedback      String?     @db.Text
  recommendedCourseId String?
  recommendedCourse   Course?     @relation("TrialRecommendedCourse", fields: [recommendedCourseId], references: [id], onDelete: SetNull)
  createdAt           DateTime    @default(now())
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

model WebhookDelivery {
  id           String        @id @default(cuid())
  source       String // "facebook" | "zalo" | "google-form"
  externalId   String?
  payload      Json
  status       WebhookStatus @default(RECEIVED)
  receivedAt   DateTime      @default(now())
  processedAt  DateTime?
  errorMessage String?       @db.Text
  retryCount   Int           @default(0)

  @@index([source, externalId])
  @@index([status, receivedAt])
}

// ─── Notification (Phase NHÓM 3) ─────────────────────────────────────────────
// Thông báo cho phụ huynh. Target theo audience. centerId/classId là cột phẳng
// (không FK) để giữ migration nhỏ — portal match theo studentId/classId của con.
enum NotificationAudience {
  ALL_PARENTS
  CENTER
  CLASS
}

model Notification {
  id          String               @id @default(cuid())
  title       String
  body        String               @db.Text
  audience    NotificationAudience @default(ALL_PARENTS)
  centerId    String?
  classId     String?
  isPublished Boolean              @default(true)
  publishedAt DateTime?            @default(now())
  createdById String?
  createdByName String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([audience, isPublished])
  @@index([centerId])
  @@index([classId])
  @@index([createdAt])
}

// ─── ParentRequest (Phase NHÓM 3) ────────────────────────────────────────────
// Yêu cầu của phụ huynh: báo vắng / học bù / chuyển lớp / chuyển cơ sở / bảo lưu.
enum ParentRequestType {
  ABSENCE
  MAKEUP
  TRANSFER_CLASS
  TRANSFER_CENTER
  RESERVE
  OTHER
}

enum ParentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ParentRequest {
  id            String              @id @default(cuid())
  studentId     String
  student       Student             @relation("StudentParentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  parentUserId  String?
  type          ParentRequestType
  content       String              @db.Text
  preferredDate DateTime?
  // Module QL học viên PHẦN 3 — buổi xin vắng (báo vắng ABSENCE); cột phẳng, không FK
  sessionId     String?
  status        ParentRequestStatus @default(PENDING)
  response      String?             @db.Text
  handledById   String?
  handledByName String?
  handledAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([studentId])
  @@index([status, createdAt])
  @@index([parentUserId])
}

// ─── ParentFeedback (Phase NHÓM 3) ───────────────────────────────────────────
// Phụ huynh đánh giá (sao + nội dung). studentId là cột phẳng (không FK).
model ParentFeedback {
  id           String   @id @default(cuid())
  parentUserId String?
  parentName   String?
  studentId    String?
  studentName  String?
  rating       Int // 1-5
  content      String   @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([studentId])
}

// ─── Media (Phase NHÓM 3) ────────────────────────────────────────────────────
// Ảnh lớp học: GV upload (PENDING) → CENTER_MANAGER duyệt → phụ huynh xem ảnh
// APPROVED có tag con mình. classId/studentId là cột phẳng (không FK).
enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClassSessionMedia {
  id             String            @id @default(cuid())
  classId        String
  fileUrl        String
  fileName       String?
  caption        String?           @db.Text
  status         MediaStatus       @default(PENDING)
  uploadedById   String?
  uploadedByName String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())

  tags MediaStudentTag[]

  @@index([classId, status])
  @@index([status, createdAt])
}

model MediaStudentTag {
  id        String            @id @default(cuid())
  mediaId   String
  media     ClassSessionMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  studentId String

  @@unique([mediaId, studentId])
  @@index([studentId])
}

// ─── Employee QR attendance (Phase NHÓM 4) ───────────────────────────────────
// Chấm công bằng QR xoay (HMAC time-window, không cần lưu QR). EmployeeCheckin
// ghi check-in/out + GPS + geofence theo Center. userId là cột phẳng (no FK).
enum CheckinType {
  CHECK_IN
  CHECK_OUT
}

// Đợt 3E — đăng ký ca làm việc (3 ca/ngày).
enum WorkShift {
  CA_SANG
  CA_CHIEU
  CA_TOI
}

enum ShiftRegStatus {
  REGISTERED
  LEAVE_REQUESTED
  APPROVED
}

model ShiftRegistration {
  id        String         @id @default(cuid())
  userId    String
  centerId  String?
  date      DateTime       @db.Date // 1 record / nhân viên / ngày
  shifts    WorkShift[]
  status    ShiftRegStatus @default(REGISTERED)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([centerId, date])
  @@index([userId, date])
}

// Module Quản lý lớp phần 4 — checklist mở/đóng cơ sở theo ngày.
model CenterDayChecklist {
  id       String   @id @default(cuid())
  centerId String
  date     DateTime @db.Date

  // Đầu ngày
  openPower       Boolean @default(false)
  openDevices     Boolean @default(false)
  openRoomsReady  Boolean @default(false)
  openCleanCommon Boolean @default(false)
  openSecurity    Boolean @default(false)
  // Cuối ngày
  closePower    Boolean @default(false)
  closeDevices  Boolean @default(false)
  closeLock     Boolean @default(false)
  closeKpiBoard Boolean @default(false)
  closeSafety   Boolean @default(false)
  closeHandover Boolean @default(false)

  note      String?  @db.Text
  byUserId  String?
  updatedAt DateTime @updatedAt

  @@unique([centerId, date])
  @@index([centerId, date])
}

model EmployeeCheckin {
  id             String      @id @default(cuid())
  userId         String
  userName       String?
  centerId       String?
  type           CheckinType
  checkedAt      DateTime    @default(now())
  latitude       Float?
  longitude      Float?
  distanceMeters Int?
  withinGeofence Boolean     @default(true)
  qrToken        String?
  createdAt      DateTime    @default(now())

  @@unique([userId, type, qrToken])
  @@index([userId, checkedAt])
  @@index([centerId, checkedAt])
}
