  notes              String?       @db.Text
  status             StudentStatus @default(ACTIVE)

  // Legacy "current center" — pre-D1 association, kept for compat.
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center? @relation(fields: [centerId], references: [id])

  // Phase T2.2 — liên kết tài khoản phụ huynh (portal "site con").
  // 1 PARENT User ↔ nhiều Student (các con). Học sinh KHÔNG có account riêng.
  parentUserId String?
  parentUser   User?   @relation("ParentChildren", fields: [parentUserId], references: [id], onDelete: SetNull)

  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  enrollments           Enrollment[]
  attendances           Attendance[]
  examAttempts          ExamAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  progressReports       ProgressReportLog[]
  sessionFeedbacks      StudentSessionFeedback[] // LMS-2
  skillAssessments      StudentSkillAssessment[] // LMS-5

  // Phase 5.4.0 — Audit log
  auditLogs StudentAuditLog[] @relation("StudentAuditLogs")

  // Phase 5.6 — Order
  orders Order[] @relation("StudentOrders")

  // Phase 5.9 — Reserve history
  reserves StudentReserve[] @relation("StudentReserves")

  // LMS-15 — thread nhắn tin 2 chiều

  // Phase NHÓM 3 — yêu cầu phụ huynh
  parentRequests    ParentRequest[]           @relation("StudentParentRequests")
  makeupNeeds       MakeupNeed[]
  riskAlerts        StudentRiskAlert[]
  careTasks         StudentCareTask[]
  courseCompletions CourseCompletion[]
  transferRequests  StudentTransferRequest[]
  centerHistory     StudentCenterHistory[]
  satacoinTxns      SataCoinTransaction[]
  birthdayGreetings StudentBirthdayGreeting[]
  // P2 — nhóm lớp (cohort): 1 HV thuộc TỐI ĐA 1 nhóm.
  classGroupId      String?
  classGroup        ClassGroup?               @relation("ClassGroupStudents", fields: [classGroupId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([centerId])
  @@index([deletedAt])
  @@index([status])
  @@index([classGroupId])
  @@index([preferredCenterId])
  @@index([parentPhone])
  @@index([parentUserId])
  @@index([orgUnitId])
  // IDX-3: trang students count+findMany order createdAt DESC paginated dưới scope centerId.
  @@index([centerId, createdAt])
}

enum ClassStatus {
  PLANNED
  RECRUITING
  PENDING_APPROVAL // chờ quản lý duyệt (sau khi sale gán đủ HS)
  ACTIVE
  COMPLETED
  CANCELLED
}

// Phase T0.2 — Lớp cố định (nhóm học sinh đi cùng nhau qua nhiều khoá/năm)
enum ClassGroupStatus {
  ACTIVE
  GRADUATED
  DISBANDED
}

model ClassGroup {
  id          String           @id @default(cuid())
  code        String           @unique // CS<n>.LOP.<YY>.<seq> (auto codegen)
  displayCode String // mã ngắn admin tự đặt, hiển thị cho người dùng (vd "A1", "B2")
  name        String?
  centerId    String
  orgUnitId   String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  status      ClassGroupStatus @default(ACTIVE)
  notes       String?          @db.Text
  deletedAt   DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  center   Center    @relation(fields: [centerId], references: [id])
  classes  Class[]
  students Student[] @relation("ClassGroupStudents")

  @@index([centerId])
  @@index([status])
  @@index([deletedAt])
  @@index([orgUnitId])
}

model Class {
  id String @id @default(cuid())

  // Identity
  classCode   String? @unique
  name        String
  description String? @db.Text

  // Relations (existing target preserved: teacher → User)
  courseId     String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  classGroupId String? // Phase T0.2 — lớp cố định (nhóm đi cùng nhau qua các khoá)
  teacherId    String?
  assistantId  String?
  roomId       String?

  // Schedule
  schedule     String? // legacy free-text (e.g. "T2 T4 17:30")
  startDate    DateTime? @db.Timestamptz(6)
  endDate      DateTime? @db.Timestamptz(6)
  scheduleDays Int[]     @default([]) // 0=CN, 1=T2, ..., 6=T7
  // BGĐ 31/07 — 2-phase: startTime/endTime là giờ CHUNG cả tuần (giữ nguyên cho lớp
  // cũ + làm fallback). Lớp có ca KHÁC GIỜ theo thứ (vd 17h30-T2 & 08h-T6) dùng
  // scheduleSlots; đọc qua helper lib/classes/slots.ts (KHÔNG đọc trực tiếp 2 field này).
  startTime    String? // "HH:mm"
  endTime      String? // "HH:mm"

  // Capacity
  maxStudents Int @default(20)
  minStudents Int @default(5)

  // Status (new) + legacy isActive flag (kept for back-compat)
  status   ClassStatus @default(PLANNED)
  isActive Boolean     @default(true)

  // Module Quản lý lớp — workflow phê duyệt (approvedBy plain, không FK)
  submittedForApprovalAt DateTime? @db.Timestamptz(6)
  approvedAt             DateTime? @db.Timestamptz(6)
  approvedById           String?
  approvedByName         String?

  // Other
  notes     String?   @db.Text
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  // R7-06 — pin curriculum version lúc tạo lớp (snapshot; null = lớp cũ, helper fallback).
  curriculumId      String?
  curriculumVersion Int?

  course          Course               @relation(fields: [courseId], references: [id])
  center          Center?              @relation(fields: [centerId], references: [id])
  classGroup      ClassGroup?          @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  teacher         User?                @relation("TeacherClasses", fields: [teacherId], references: [id])
  assistant       User?                @relation("AssistantClasses", fields: [assistantId], references: [id])
  room            Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  sessions        ClassSession[]
  sessionPlans    ClassSessionPlan[] // R7-06
  scheduleSlots   ClassScheduleSlot[] // BGĐ 31/07 — giờ học riêng theo từng thứ
  schedulePhases  ClassSchedulePhase[] // 07/08 — kế hoạch lịch nhiều giai đoạn
  exams           Exam[]
  assignments     Assignment[]
  progressReports ProgressReportLog[]
  trialClasses    TrialClass[]
  makeupNeeds     MakeupNeed[]

  // Phase 5.4.0 — Audit log
  auditLogs ClassAuditLog[] @relation("ClassAuditLogs")

  @@index([courseId])
  @@index([centerId])
  @@index([classGroupId])
  @@index([teacherId])
  @@index([deletedAt])
  @@index([status, centerId])
  @@index([courseId, status])
  @@index([roomId])
  @@index([orgUnitId])
}

// BGĐ 31/07 — GIỜ HỌC RIÊNG THEO TỪNG THỨ (lớp 2 ca khác giờ: 17h30-T2 & 08h-T6).
// 2-phase: lớp KHÔNG có slot → dùng Class.startTime/endTime chung như trước.
// Mỗi thứ tối đa 1 ca (lớp không học 2 ca cùng 1 thứ).
model ClassScheduleSlot {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  weekday   Int // 0=CN, 1=T2, ..., 6=T7
  startTime String // "HH:mm"
  endTime   String? // "HH:mm"

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([classId, weekday])
  @@index([classId])
}

// ═══ KẾ HOẠCH LỊCH HỌC NHIỀU GIAI ĐOẠN (07/08/2026) ══════════════════════════
//
// VÌ SAO: `ClassScheduleSlot` có `@@unique([classId, weekday])` và KHÔNG có chiều
// thời gian ⇒ 1 lớp chỉ biểu diễn được ĐÚNG MỘT lịch cho cả vòng đời. Thực tế lớp
// đổi nhịp giữa khoá (tháng 7 học 2 buổi/tuần, tháng 8 còn 1 buổi/tuần) hoặc đổi
// giờ theo mùa — trước đây phải sửa lịch lớp rồi bấm "dời buổi", làm mất lịch cũ và
// không lưu được kế hoạch tương lai.
//
// QUY ƯỚC: kế hoạch là NGUỒN SỰ THẬT của lịch. `Class.scheduleDays/startTime/endTime`
// + `ClassScheduleSlot` trở thành BẢN SAO DẪN XUẤT của giai đoạn đang hiệu lực hôm
// nay (giữ cho ~40 chỗ đọc lịch kiểu cũ — site GV, PDF, soát trùng — không phải sửa
// một lượt). Đồng bộ ở `syncLegacyScheduleFromPhases` (lib/classes/phases-service.ts).
// Lớp chưa có giai đoạn nào → toàn hệ thống chạy y như trước (2-phase, không vỡ).
model ClassSchedulePhase {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// Thứ tự hiển thị; luôn được ghi lại theo effectiveFrom tăng dần khi lưu.
  order Int @default(0)

  /// Ngày bắt đầu áp dụng — 00:00 GIỜ VN (dựng bằng parseVnYmd/vnDateAt, KHÔNG
  /// dùng z.coerce.date vì nó cho nửa đêm UTC = 07:00 VN, ăn mất buổi sáng).
  effectiveFrom DateTime  @db.Timestamptz(6)
  /// Ngày kết thúc, TÍNH CẢ ngày này (00:00 giờ VN). null = giai đoạn mở, kéo dài
  /// tới khi đủ số buổi của khoá. Chỉ giai đoạn CUỐI được để null.
  effectiveTo   DateTime? @db.Timestamptz(6)

  note String?

  slots ClassSchedulePhaseSlot[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([classId, effectiveFrom])
}

/// Giờ học của MỘT thứ trong MỘT giai đoạn. Khác `ClassScheduleSlot` ở chỗ unique
/// gắn theo giai đoạn, nên "T2 tháng 7 lúc 17h30" và "T2 tháng 8 lúc 08h00" cùng tồn tại.
model ClassSchedulePhaseSlot {
  id      String             @id @default(cuid())
  phaseId String
  phase   ClassSchedulePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  weekday   Int // 0=CN, 1=T2, ..., 6=T7
  startTime String // "HH:mm"
  endTime   String? // "HH:mm"

  @@unique([phaseId, weekday])
  @@index([phaseId])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  courseId  String
  status    EnrollmentStatus @default(ACTIVE)
  // FL3-02 — centerId denormalized từ class. ĐÃ flip vào SCOPED_MODELS (db-scope.ts);
  // mọi write set centerId + backfill migration 20260624010000. scopedDb cách ly theo cơ sở.
  centerId  String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  // R7-06 — truy vết enrollment ⇽ LeadChild nguồn khi convert per-child (additive,
  // nullable; SetNull để không chặn xoá lead). Enrollment tạo trực tiếp → null.
  leadChildId String?
  // T3.2 (QĐ-7) — SALE PHỤ TRÁCH học viên trong lớp này. Backfill từ
  // Lead.assignedToId khi convert; sửa tay ở màn HS của lớp. SetNull khi user nghỉ.
  saleId      String?

  // Financial (legacy)
  tuition Int?
  paidAt  DateTime? @db.Timestamptz(6)

  // R7-03 — snapshot giá 4 thành phần (ghi tại convert/R7-05; bất biến khi đổi bảng giá).
  // `tuition` cũ giữ (2-phase); helper computeEnrollmentPrice fallback tuition khi null.
  listPrice      Int? // giá niêm yết Course tại thời điểm chốt
  discountType   String? // CourseDiscountType áp dụng (snapshot dạng string)
  discountAmount Int? // số tiền giảm thực tế
  finalPrice     Int? // phải thu sau giảm (clamp ≥ 0)

  // Legacy dates (kept for back-compat)
  startDate DateTime? @db.Timestamptz(6)
  endDate   DateTime? @db.Timestamptz(6)

  // D5 workflow timestamps
  enrolledAt  DateTime  @default(now()) @db.Timestamptz(6)
  confirmedAt DateTime? @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  endedAt     DateTime? @db.Timestamptz(6)

  // Transfer
  transferredToId String?
  transferredTo   Enrollment?  @relation("EnrollmentTransfer", fields: [transferredToId], references: [id])
  transferredFrom Enrollment[] @relation("EnrollmentTransfer")
  transferReason  String?      @db.Text

  // BGĐ 31/07 — TÁI TỤC: ghi danh mới trỏ về ghi danh KHOÁ TRƯỚC của cùng HV.
  // isRenewal (hoa hồng C10.3: tái tục KHÔNG hưởng 4 tầng) suy từ field này ≠ null.
  renewedFromEnrollmentId String?
  renewedFrom             Enrollment?  @relation("EnrollmentRenewal", fields: [renewedFromEnrollmentId], references: [id], onDelete: SetNull)
  renewals                Enrollment[] @relation("EnrollmentRenewal")

  // Other
  notes String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6) // FIX-C3 — soft-delete tài chính (read filter deletedAt: null)

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class      @relation(fields: [classId], references: [id])
  course    Course     @relation(fields: [courseId], references: [id])
  leadChild LeadChild? @relation(fields: [leadChildId], references: [id], onDelete: SetNull)
  sale      User?      @relation("EnrollmentSale", fields: [saleId], references: [id], onDelete: SetNull)

  auditLogs EnrollmentAuditLog[]

  // Phase 5.6 — Order item link
  orderItems OrderItem[] @relation("EnrollmentOrderItems")

  // Phase 5.9 — Reserve link (enrollment-specific reserves only; whole-student
  // reserves leave enrollmentId NULL)
  reserves       StudentReserve[]      @relation("EnrollmentReserves")
  payments       Payment[]             @relation("EnrollmentPayments") // R7-04
  receipts       Receipt[]             @relation("EnrollmentReceipts") // R7-04
  refundRequests RefundRequest[] // W3-1
  messages       ConversationMessage[] // LMS-15 — nhắn 2 chiều PH↔GV

  // FIX-C3 (B2b) — KHÔNG @@unique đầy đủ: soft-delete cần cho ghi danh lại cùng
  // (HS×lớp) sau khi xóa mềm. Ràng buộc duy nhất chỉ áp row CÒN SỐNG qua PARTIAL
  // unique index `WHERE "deletedAt" IS NULL` (trong migration — Prisma không model
  // được partial unique → sẽ báo drift khi `migrate dev`, GIỮ migration tay).
  @@index([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@index([classId, status])
  @@index([studentId, status])
  @@index([status, enrolledAt])
  @@index([saleId]) // T3.2 — lọc "học viên của sale X"
  @@index([centerId])
  @@index([leadChildId])
  @@index([renewedFromEnrollmentId])
  @@index([orgUnitId])
}

model EnrollmentAuditLog {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  fromStatus String
  toStatus   String

  changedByUserId String?
  changedByName   String

  reason    String? @db.Text
  extraData Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([enrollmentId, createdAt])
}

model ClassSession {
  id      String   @id @default(cuid())
  classId String
  date    DateTime @db.Timestamptz(6)
  topic   String?
  notes   String?  @db.Text

  // Phase E6 — link session to curriculum lesson for progress tracking
  lessonId    String?
  lessonNotes String? @db.Text
  // R7-06 — trỏ tới ClassSessionPlan (kế hoạch buổi của lớp); lessonId cũ giữ 2-phase.
  planId      String?
  // W2-4b — phòng học theo TỪNG BUỔI (để soát trùng phòng per-session); khác actualRoomId (ghi sau-thực-tế).
  roomId      String?
  // FL3-02 — centerId denormalized từ class. ĐÃ flip vào SCOPED_MODELS (db-scope.ts);
  // mọi write set centerId + backfill migration 20260624010000. scopedDb cách ly theo cơ sở.
  centerId    String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId   String?

  // LMS-3 — quy trình sau buổi + checklist
  status            SessionStatus @default(SCHEDULED)
  startedAt         DateTime?     @db.Timestamptz(6)
  completedAt       DateTime?     @db.Timestamptz(6)
  // Chuẩn bị phòng học (Module QL lớp phần 3)
  ckClean           Boolean       @default(false)
  ckEquipment       Boolean       @default(false)
  ckKit             Boolean       @default(false)
  ckAttendance      Boolean       @default(false)
  ckLessonConfirmed Boolean       @default(false)
  ckFeedback        Boolean       @default(false)
  ckMedia           Boolean       @default(false)
  ckHomework        Boolean       @default(false)
  ckIncident        Boolean       @default(false)
  incidentNote      String?       @db.Text

  // R7-07 — "Hoàn tất buổi": dữ liệu thực tế + nhận xét lớp (khôi phục sau merge main→erd-fix-p0).
  actualTeacherId     String?
  actualRoomId        String?
  // P5/T11 — dạy thay/đổi phòng cấp buổi (kế hoạch trước buổi; persist thay vì chỉ audit).
  substituteTeacherId String?
  substituteRoomId    String?
  actualStartAt       DateTime? @db.Timestamptz(6)
  actualEndAt         DateTime? @db.Timestamptz(6)
  classComment        String?   @db.Text
  completedById       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class            Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson           Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  plan             ClassSessionPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  room             Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  attendances      Attendance[]
  studentFeedbacks StudentSessionFeedback[] // LMS-2
  skillAssessments StudentSkillAssessment[] // W4b — đánh giá kỹ năng gắn buổi
  assignments      Assignment[] // Parity 18/08 — bài tập/kiểm tra gắn buổi

  @@index([classId])
  @@index([date])
  @@index([lessonId])
  @@index([planId])
  @@index([roomId])
  @@index([centerId])
  @@index([orgUnitId])
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED // R7-06 — hủy buổi (không xóa); buổi bù sinh cuối lịch
}

/// R7-03 — loại ưu đãi theo khóa (áp toàn hệ thống, KHÔNG per-center).
enum CourseDiscountType {
  AMOUNT // giảm số tiền tuyệt đối (VND)
  PERCENT // giảm theo %
  SCHOLARSHIP // học bổng (PERCENT đặc biệt, có điều kiện)
  PROGRAM // ưu đãi chương trình (combo/đợt)
}

// LMS-5 — Hồ sơ năng lực robotics.
enum SkillLevel {
  NEED_SUPPORT
  BASIC
  GOOD
  EXCELLENT
}

enum RoboticsSkill {
  MECH_ASSEMBLY
  ALGORITHM
  PROGRAMMING
  SENSOR
  MOTOR_CONTROL
  PROBLEM_SOLVING
  TEAMWORK
  PRESENTATION
  CREATIVITY
  COMPETITION_READY
}

model StudentSkillAssessment {
  id             String        @id @default(cuid())
  studentId      String
  skill          RoboticsSkill
  level          SkillLevel
  note           String?
  assessedById   String
  assessedAt     DateTime      @default(now()) @db.Timestamptz(6)
  // W4b/LMS-17 — gắn đánh giá kỹ năng vào buổi/bài (tùy chọn; null = đánh giá tổng).
  classSessionId String?
  lessonId       String?
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)
  lesson         Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([studentId, skill])
  @@index([classSessionId])
}

// LMS-2 — nhận xét RIÊNG từng học sinh mỗi buổi (GV viết, PH xem con mình).
model StudentSessionFeedback {
  id             String       @id @default(cuid())
  classSessionId String
  studentId      String
  // Phiếu nhận xét buổi (site GV): comment giữ tương thích cũ (nay nullable — phiếu
  // rubric-only không bắt buộc văn xuôi). projectName + notes(4 mục) + rubric(9 tiêu
  // chí 1-5) là dữ liệu phiếu mở rộng (lib/lms/session-eval-rubric).
  comment        String?      @db.Text
  rating         Int? // 1-5 tuỳ chọn (đường sao cũ — /teacher/nhan-xet)
  projectName    String? // tên dự án buổi
  notes          Json? // { knowledge, skill, attitude, proposal }
  rubric         Json? // { criterionId: level 1-5 }
  createdById    String // GV
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([studentId])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  // LMS-18 (W5f phase A) — centerId denormalized (backfill từ session→class). Phase A:
  // SCOPE_EXEMPT (chưa flip), cách ly vẫn qua classId IN scopedClassIds như cũ.
  centerId  String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  // Module QL học viên PHẦN 2 — vắng có cấu trúc.
  makeupStatus    MakeupStatus @default(NONE)
  makeupSessionId String? // buổi đã học bù (set khi MADE_UP) — cột phẳng, không FK
  absenceReason   String?      @db.Text // lý do phụ huynh xin vắng

  // Commit 5 — mốc đã gửi thông báo điểm danh cho phụ huynh (chống gửi trùng).
  notifiedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([studentId, makeupStatus])
  @@index([centerId])
  @@index([orgUnitId])
}

