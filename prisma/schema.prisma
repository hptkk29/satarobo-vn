  priceOriginal  Int?
  priceEarlyBird Int?
  priceMember    Int?

  features   Json?
  highlights Json?
  curriculum Json?

  badge        String?
  color        String?
  displayOrder Int     @default(0)
  isPublished  Boolean @default(false)
