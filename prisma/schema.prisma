// =============================================================================
// Phase 5.6.0 — Payment + Order foundation
// =============================================================================
// Order is polymorphic via OrderItem.type (COURSE/PACKAGE/EXAM/PRODUCT).
// Customer info snapshotted on Order (immutable per order — no Parent model yet).
// VND-only Int storage. No Decimal, no multi-currency.
// Status workflow enforced at app layer via lib/orders/status.ts.
// =============================================================================

model PaymentMethod {
  id          String            @id @default(cuid())
  code        String            @unique // "CASH", "BANK_TRANSFER", "VNPAY", "TINGEE"
  name        String
  type        PaymentMethodType
  image       String?
  description String?           @db.Text

  // Allowed-for flags (match SataWorld pattern)
  canBuyCourse  Boolean @default(true)
  canBuyPackage Boolean @default(true)
  canBuyExam    Boolean @default(true)
  canBuyProduct Boolean @default(false) // Sprint 5.10
  canDeposit    Boolean @default(false) // wallet topup — reserved

  // ─── Tài khoản nhận tiền (chỉ BANK_TRANSFER) ─────────────────────────────
  // ⚠️ 31/08/2026 — 4 cột này TỪNG là dữ liệu chết (không đường tiền nào đọc), nay là
  // NGUỒN SỰ THẬT DUY NHẤT: mã QR gửi phụ huynh dựng từ đây. Kho cũ
  // `IntegrationConfig` khoá `VIETQR:<centerId>` đã NGỪNG là nơi khai (màn /admin/tich-hop
  // gỡ khối đó) và chỉ còn là đường LÙI cho dữ liệu cũ — xem lib/payments/vietqr.ts.
  //
  // Vì tài khoản gắn vào PHƯƠNG THỨC (không phải vào cơ sở), một cơ sở có thể khai nhiều
  // tài khoản bằng cách tạo nhiều phương thức chuyển khoản (vd Vietcombank + MB).
  bankBin           String? // mã ngân hàng 6 số chuẩn VietQR (970415 = Vietinbank)
  bankName          String?
  bankBranch        String?
  bankAccountNumber String?
  bankAccountName   String?

  // Gateway config (VNPAY/TINGEE only) — defer Sprint 5.6.5
  gatewayConfig Json?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  // ─── Thanh toán theo cơ sở (30/08/2026) ──────────────────────────────────
  // `centerId = NULL` nghĩa là PHƯƠNG THỨC DÙNG CHUNG cho mọi cơ sở (tiền mặt,
  // cổng online…), KHÔNG phải "chưa gán". Đây là lý do PaymentMethod phải khai ở
  // CẢ HAI nơi trong lib/db-scope.ts: `SCOPED_MODELS` (để cách ly) và
  // `NULL_IS_GLOBAL_MODELS` (để dòng dùng chung không bị `centerId IN (...)` ẩn mất
  // khỏi chính người cấp cơ sở — bỏ sót là form tạo đơn hiện danh sách RỖNG).
  //
  // ⚠️ `code` VẪN @unique TOÀN CỤC — cố ý không đổi sang @@unique([code, centerId]):
  //   (a) đổi khoá unique là ALTER trên bảng đang có dữ liệu prod (luật cứng #4),
  //   (b) 5 chỗ đang gọi `where: { code }` (3 file seed + 2 chỗ trong _actions) sẽ
  //       vỡ typecheck, và
  //   (c) Postgres coi NULL là khác nhau nên ("BANK_TRANSFER", NULL) vẫn chèn được
  //       hai lần ⇒ khoá ghép KHÔNG chặn được đúng ca cần chặn.
  // Quy ước thay thế: phương thức riêng của cơ sở đặt mã có hậu tố cơ sở
  // (`BANK_CS1`, `BANK_CS2` — đúng thứ prisma/seed-uat/01-nen.ts đã làm sẵn).
  centerId String?
  // Restrict (KHÔNG phải SetNull mặc định của Prisma cho quan hệ optional): xoá cơ sở
  // mà để null lại là biến phương thức RIÊNG của cơ sở đó thành DÙNG CHUNG — tài khoản
  // ngân hàng của một cơ sở đã đóng bỗng hiện ra cho mọi cơ sở còn lại.
  center   Center? @relation(fields: [centerId], references: [id], onDelete: Restrict)

  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4). Tự điền qua
  // lib/org/dual-write.ts nhờ khai PaymentMethod trong BACKFILL_SPECS.
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  orders Order[]

  // Phase 5.6.1 — Audit log
  auditLogs PaymentMethodAuditLog[]

  @@index([code])
  @@index([isActive, displayOrder])
  @@index([centerId, isActive, displayOrder])
  @@index([orgUnitId])
}

model Order {
  id     String      @id @default(cuid())
  code   String      @unique // "ORD-260521-000001"
  type   OrderType
  status OrderStatus @default(DRAFT)

  // Customer snapshot (immutable per order)
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String? @db.Text
  customerWard    String?
  customerCity    String?
  customerCccd    String? // FIX lead→payment→enroll (M0) — CCCD người mua (snapshot đơn)

  // Optional links
  studentId String?
  student   Student? @relation("StudentOrders", fields: [studentId], references: [id])

  leadId String?
  lead   Lead?   @relation("LeadOrders", fields: [leadId], references: [id])

  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center? @relation(fields: [centerId], references: [id])

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  // Amounts (VND, Int)
  subtotal       Int @default(0)
  discountAmount Int @default(0)
  shippingFee    Int @default(0)
  totalAmount    Int @default(0)

  // Voucher (Sprint 5.7 — nullable, no FK yet)
  voucherCode String?

  // Payment proof / external refs
  bankReference String?
  gatewayTxnId  String?
  paidAt        DateTime? @db.Timestamptz(6)

  // Confirmation by staff
  // 31/08/2026 — NGƯỜI TẠO ĐƠN (cột danh sách /admin/orders).
  //
  // Cột TRẦN, KHÔNG quan hệ Prisma — theo đúng lối của `confirmedByUserId` ngay dưới,
  // `Payment.recordedById`, `installmentRequestedById`…: xoá/vô hiệu một nhân sự không
  // được kéo theo hay chặn đơn hàng. Tra tên bằng một query `user.findMany` ở tầng đọc
  // (khuôn mẫu: `queryPayments` trong admin/payments/_actions.ts).
  //
  // ⚠️ Đơn TẠO TRƯỚC ngày này để NULL vĩnh viễn: không có nguồn nào suy ngược ra người
  // tạo (AuditLog chưa từng ghi sự kiện tạo đơn — đo trên DB: chỉ có DISCOUNT_APPROVED).
  // Danh sách hiển thị "—" cho nhóm đó, KHÔNG đoán bừa.
  createdById String?

  confirmedByUserId String?
  confirmedAt       DateTime? @db.Timestamptz(6)

  // FIX lead→payment→enroll (M0/C4) — duyệt kế hoạch thanh toán 2 đợt.
  // null = không có kế hoạch 2 đợt cần duyệt.
  installmentApprovalStatus InstallmentApprovalStatus?
  installmentRequestedById  String?
  installmentApprovedById   String?
  installmentApprovedAt     DateTime?                  @db.Timestamptz(6)
  installmentRejectReason   String?                    @db.Text

  // BGĐ 31/07 — GIẢM GIÁ do nhân viên nhập tay: nhập theo % hoặc số tiền, BẮT BUỘC
  // giải trình, Quản lý cơ sở duyệt trước khi đơn được xác nhận. Giảm giá từ VOUCHER
  // (chính sách đã duyệt sẵn) KHÔNG đi qua luồng này → discountApprovalStatus = null.
  discountPercent        Int? // 1..100 khi nhập theo %; null = nhập số tiền tuyệt đối
  discountReason         String?                 @db.Text
  discountApprovalStatus DiscountApprovalStatus?
  discountRequestedById  String?
  discountApprovedById   String?
  discountApprovedAt     DateTime?               @db.Timestamptz(6)
  discountRejectReason   String?                 @db.Text

  customerNote String? @db.Text
  internalNote String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6) // FIX-C3 — soft-delete tài chính (read filter deletedAt: null)

  items   OrderItem[]
  history OrderStatusHistory[]

  // Sprint 5.7 — Voucher
  voucherRedemption VoucherRedemption? @relation("OrderVoucherRedemption")

  // Commit 4 — thanh toán tối đa 2 đợt
  installments    OrderInstallment[]
  payments        Payment[]          @relation("OrderPayments") // R7-04
  // 03/08 — sổ thu theo ĐỢT (PaymentRequest) + sổ phân bổ. Chạy SONG SONG với
  // OrderInstallment/Payment cho tới khi shadow-compare sạch (cờ PAYMENT_LEDGER_V2).
  paymentRequests PaymentRequest[]

  @@index([code])
  @@index([status])
  @@index([type, status])
  @@index([studentId])
  @@index([leadId])
  @@index([centerId, createdAt])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([orgUnitId])
  // IDX-4: cron order-debt-reminder (getOverdueOrders: status=PENDING + createdAt<cutoff
  // ORDER createdAt) + admin order lists filter status. status+createdAt phục vụ filter+sort.
  @@index([status, createdAt])
}

// Commit 4 — lịch thanh toán tối đa 2 đợt cho 1 Order.
enum InstallmentStatus {
  PENDING
  PAID
}

// FIX lead→payment→enroll (M0/C4) — trạng thái duyệt kế hoạch thanh toán 2 đợt.
enum InstallmentApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// BGĐ 31/07 — trạng thái duyệt GIẢM GIÁ nhập tay (Quản lý cơ sở duyệt).
enum DiscountApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model OrderInstallment {
  id             String            @id @default(cuid())
  orderId        String
  soDot          Int // 1 hoặc 2
  amount         Int
  status         InstallmentStatus @default(PENDING)
  dueDate        DateTime?         @db.Timestamptz(6)
  paidAt         DateTime?         @db.Timestamptz(6)
  recordedById   String?
  // R7-04 — số ngày nhắc trước hạn (QĐ-O7); null → đọc SystemSetting default 14.
  reminderDays   Int?
  // Mốc nhắc công nợ gần nhất (chống spam — 1 nhắc/ngày).
  lastReminderAt DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict) // FIX-C3

  @@unique([orderId, soDot])
  @@index([status, dueDate])
}

model OrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict) // FIX-C3
  type    OrderItemType

  // Polymorphic refs (only one non-null per row, by type)
  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentOrderItems", fields: [enrollmentId], references: [id])

  packageId String?
  package   CoursePackage? @relation(fields: [packageId], references: [id])

  examAttemptId String?
  examAttempt   ExamAttempt? @relation("ExamOrderItems", fields: [examAttemptId], references: [id])

  // Phase 5.10.1 — FK to Product (SetNull on product delete)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Item display snapshot (immutable)
  itemName        String
  itemDescription String? @db.Text

  // Pricing (VND, Int)
  quantity   Int @default(1)
  unitPrice  Int
  totalPrice Int

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([orderId])
  @@index([type])
  @@index([enrollmentId])
  @@index([packageId])
  @@index([examAttemptId])
  @@index([productId])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict) // FIX-C3

  fromStatus OrderStatus
  toStatus   OrderStatus

  changedByUserId String? // no FK, defensive (consistent with audit log pattern)
  changedByName   String

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// Phase 5.6.1 — PaymentMethod audit log
model PaymentMethodAuditLog {
  id              String        @id @default(cuid())
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "ENABLE" | "DISABLE"

  changedByUserId String? // no FK, defensive
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([paymentMethodId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Phase 5.7 — Voucher foundation ───────────────────────────────────────
// 5 types (COURSE/PACKAGE/KIT_ROBOT/SENSOR/ALL) × 2 discount kinds
// (PERCENT + max cap, FIXED). KIT_ROBOT/SENSOR can't apply until Sprint 5.10
// adds Product model — created here to lock the schema shape early.

model Voucher {
  id           String              @id @default(cuid())
  code         String              @unique // "OPENING2026", "SATA8_LAUNCH"
  name         String // "Giảm 20% khai trương 2026"
  description  String?             @db.Text
  type         VoucherType
  discountKind VoucherDiscountKind

  // Discount values — one of two non-null depending on discountKind
  discountPercent Int? // 1-100 (when PERCENT)
  discountAmount  Int? // VND (when FIXED)
  maxDiscount     Int? // cap VND (only when PERCENT)
  minOrderValue   Int  @default(0)

  // Usage limits
  quantity          Int? // null = unlimited
  usedCount         Int  @default(0)
  usageLimitPerUser Int  @default(1)

  // Validity
  validFrom  DateTime @db.Timestamptz(6)
  validUntil DateTime @db.Timestamptz(6)
  isActive   Boolean  @default(true)

  // Audit
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  createdByUserId String?

  redemptions VoucherRedemption[]
  auditLogs   VoucherAuditLog[]

  @@index([code])
  @@index([type, isActive, validFrom, validUntil])
  @@index([createdAt])
}

model VoucherRedemption {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  orderId String @unique // 1 order = 1 voucher max
  order   Order  @relation("OrderVoucherRedemption", fields: [orderId], references: [id], onDelete: Cascade)

  customerPhone String // snapshot for per-user limit check
  customerId    String? // future: User account link (no FK, defensive)

  discountApplied Int // VND actual discount snapshot

  redeemedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([voucherId, redeemedAt])
  @@index([customerPhone, voucherId])
}

model VoucherAuditLog {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  action          String // CREATE | UPDATE | ENABLE | DISABLE
  changedByUserId String? // no FK, defensive
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([voucherId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Phase 5.9 — Student lifecycle: reserve history ───────────────────────
// Multiple reserve periods per student. enrollmentId NULL = áp dụng cho mọi
// active enrollment của học viên (whole-student reserve). Actor info được
// snapshot (không FK) để giữ audit trail dù user gốc bị xoá.

model StudentReserve {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation("StudentReserves", fields: [studentId], references: [id], onDelete: Cascade)

  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentReserves", fields: [enrollmentId], references: [id], onDelete: SetNull)

  reason        String    @db.Text
  startedAt     DateTime  @default(now()) @db.Timestamptz(6)
  expectedEndAt DateTime? @db.Timestamptz(6)
  endedAt       DateTime? @db.Timestamptz(6)
  endReason     String?   @db.Text

  // Actor snapshots — no FK (defensive)
  createdByUserId String?
  createdByName   String
  endedByUserId   String?
  endedByName     String?

  // Denormalised flag (= endedAt is null) for fast queries.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([studentId, isActive])
  @@index([studentId, startedAt])
  @@index([startedAt])
  @@index([endedAt])
}

// ─── Phase 5.10 — Product catalog (sales/rental SKU layer) ────────────────
// Distinct from ZMRoboKit (marketing catalog). Product = sellable SKU with
// inventory + pricing + audit trail. Global stockOnHand for v1; per-center
// stock deferred. Optional zmroboKitId link for kit products that match a
// public marketing entry.

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  description String? @db.Text

  category ProductCategory
  status   ProductStatus   @default(DRAFT)

  // Pricing (VND, Int)
  salePrice           Int
  costPrice           Int? // internal-only
  rentalPricePerMonth Int?

  // Stock (global v1)
  stockOnHand  Int @default(0)
  minThreshold Int @default(0)

  // Display
  imageUrls String[] @default([])

  // Optional link to public ZMRoboKit marketing entry
  zmroboKitId String?
  zmroboKit   ZMRoboKit? @relation(fields: [zmroboKitId], references: [id], onDelete: SetNull)

  attributes Json?
  notes      String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  movements ProductMovement[]
  auditLogs ProductAuditLog[]

  // Phase 5.10.1 — order item references
  orderItems OrderItem[]

  // G2 — sản phẩm dự kiến của lead (loại đơn = Sản phẩm).
  expectedByLeads Lead[] @relation("LeadExpectedProduct")

  @@index([category, status])
  @@index([status])
  @@index([sku])
}

model ProductMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     ProductMovementType
  quantity Int // signed: + for in, - for out

  reason String? @db.Text

  // Optional link (filled when type = SALE in Phase 5.10.1)
  orderId String?

  // Stock snapshots (denormalised for audit)
  stockBeforeMovement Int
  stockAfterMovement  Int

  createdByUserId String?
  createdByName   String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([productId, createdAt])
  @@index([type])
  @@index([orderId])
}

model ProductAuditLog {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  action String // CREATE | UPDATE | DELETE | STATUS_CHANGE

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  changedByUserId String?
  changedByName   String

  reason String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([productId, createdAt])
}

// ─── Email System (Phase 5.13.0) ─────────────────────────────────────────────

enum EmailTemplateTrigger {
  ORDER_CONFIRMATION
  PAYMENT_RECEIPT
  RESERVATION_NOTICE
  WITHDRAWAL_NOTICE
  RENEWAL_REMINDER
  CLASS_REMINDER
  MANUAL
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model EmailTemplate {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String? @db.Text

  trigger  EmailTemplateTrigger
  isActive Boolean              @default(true)

  subject  String
  bodyText String @db.Text
  bodyHtml String @db.Text

  availableVariables String[] @default([])

  fromName String?
  replyTo  String?

  sentCount  Int       @default(0)
  lastSentAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  logs EmailLog[]

  @@index([trigger, isActive])
  @@index([code])
}

model EmailLog {
  id String @id @default(cuid())

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  toEmail  String
  toName   String?
  subject  String
  bodyText String  @db.Text
  bodyHtml String  @db.Text

  status        EmailLogStatus @default(PENDING)
  resendId      String?
  failureReason String?        @db.Text

  contextType String?
  contextId   String?

  triggeredByUserId String?
  triggeredByName   String?
  triggerType       String

  sentAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([templateId, createdAt])
  @@index([toEmail, createdAt])
  @@index([contextType, contextId])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ─── Counter (Phase T0.2) ────────────────────────────────────────────────────
// Atomic sequence generator cho mã định danh CS<n>.<LOAI>.<YY>.<seq>.
// key dạng "<LOAI>:<centerCode>:<yy>" (vd "HV:CS1:26") — seq reset theo năm.
model Counter {
  id        String   @id @default(cuid())
  key       String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

// ─── Trial Class + Webhook (Phase T1.4) ──────────────────────────────────────

enum TrialClassStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  MISSED
  POSTPONED
  ENROLLED
  REJECTED
}

enum ChildGrasp {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
}

model TrialClass {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  centerId    String?
  orgUnitId   String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center      Center?          @relation(fields: [centerId], references: [id])
  classId     String?
  class       Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  roomId      String?
  room        Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     User?            @relation("TrialTeacher", fields: [teacherId], references: [id])
  scheduledAt DateTime         @db.Timestamptz(6)
  status      TrialClassStatus @default(SCHEDULED)
  attendedAt  DateTime?        @db.Timestamptz(6)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  feedback TrialFeedback?

  @@index([leadId])
  @@index([centerId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([orgUnitId])
}

model TrialFeedback {
  id                  String      @id @default(cuid())
  trialClassId        String      @unique
  trialClass          TrialClass  @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  childEnjoyed        Boolean?
  childGrasp          ChildGrasp?
  teacherSuggestion   String?     @db.Text
  parentFeedback      String?     @db.Text
  recommendedCourseId String?
  recommendedCourse   Course?     @relation("TrialRecommendedCourse", fields: [recommendedCourseId], references: [id], onDelete: SetNull)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

model WebhookDelivery {
  id           String        @id @default(cuid())
  source       String // "facebook" | "zalo" | "google-form"
  externalId   String?
  payload      Json
  status       WebhookStatus @default(RECEIVED)
  receivedAt   DateTime      @default(now()) @db.Timestamptz(6)
  processedAt  DateTime?     @db.Timestamptz(6)
  errorMessage String?       @db.Text
  retryCount   Int           @default(0)

  @@index([source, externalId])
  @@index([status, receivedAt])
}

// ─── Notification (Phase NHÓM 3) ─────────────────────────────────────────────
// Thông báo cho phụ huynh. Target theo audience. centerId/classId là cột phẳng
// (không FK) để giữ migration nhỏ — portal match theo studentId/classId của con.
enum NotificationAudience {
  ALL_PARENTS
  CENTER
  CLASS
  STUDENT // Đợt 6 #7 — gửi cho 1 học viên/phụ huynh cụ thể
}

// Module nhắc việc PHẦN 3 — thông báo CHUÔNG cho NHÂN VIÊN (per-user, có đọc/chưa).
// Khác Notification (broadcast phụ huynh). dedupeKey chống tạo trùng cùng 1 việc.
// ─── Giờ làm việc (Q-C, 19/08/2026) ─────────────────────────────────────────────
// Chủ dự án chốt: giờ làm việc do QUẢN TRỊ KHAI TRÊN WEB, không sửa code — và "sau này các vai
// sẽ có giờ khác nhau". Vì vậy bảng này có sẵn cả hai chiều: theo ĐƠN VỊ và theo VAI.
//
// Vì sao là bảng mới chứ không phải một key JSON trong SystemSetting:
//  · Ma trận (đơn vị × vai × 7 thứ) nhét vào một ô JSON thì màn cấu hình hiện tại là Textarea
//    JSON thô — người vận hành phải gõ tay JSON lồng nhau, sai một dấu phẩy là mất cả cấu hình.
//  · Quyền `settings:edit` đang là SUPER_ADMIN-only + `scopable:false`, nên quản lý cơ sở không
//    thể tự khai giờ cơ sở mình. Bảng riêng cho phép gắn một permission scopable riêng.
//  · `WorkShiftConfig` sẵn có KHÔNG dùng lại được: nó không có chiều thứ-trong-tuần (mà Sata Robo
//    nghỉ Thứ Hai, mở T3–CN), không có chiều vai, và bản thân nó đang mồ côi — không app code nào
//    đọc, giờ ca thật vẫn hardcode ở lib/shifts.ts. Xây lên nó là dựng nguồn sự thật thứ ba.
//
// ⚠️ DÙNG SENTINEL "*" THAY CHO NULL cho `orgUnitId`/`roleCode`. Postgres coi mọi NULL là khác
// nhau trong UNIQUE, nên để null thì "luật mặc định toàn hệ thống cho Thứ Ba" có thể tồn tại
// nhiều bản trùng mà DB không hề chặn. Sentinel làm `@@unique` hoạt động đúng nghĩa.
model WorkingHourRule {
  id String @id @default(cuid())

  // OrgUnit.id, hoặc "*" = luật mặc định toàn hệ thống. Luật Nền Hệ thống #3: bảng mới có dữ
  // liệu theo đơn vị dùng orgUnitId, KHÔNG thêm centerId mới.
  orgUnitId String @default("*")

  // RoleDef.code, hoặc "*" = áp cho mọi vai. Chiều này CÓ SẴN từ đầu để lúc cần khai giờ riêng
  // cho một vai thì chỉ thêm dữ liệu, không phải migrate lần nữa.
  roleCode String @default("*")

  // 0 = Chủ nhật … 6 = Thứ Bảy — khớp Date.getDay() để không phải quy đổi ở chỗ dùng.
  weekday Int

  // "HH:mm" giờ Việt Nam. null khi nghỉ cả ngày.
  openTime  String?
  closeTime String?

  // Nghỉ cả ngày (Sata Robo nghỉ Thứ Hai).
  isClosed Boolean @default(false)

  note          String?
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@unique([orgUnitId, roleCode, weekday])
  @@index([orgUnitId])
}

model StaffNotification {
  id        String    @id @default(cuid())
  userId    String
  category  String // = PendingTaskType (loại việc)
  title     String
  body      String    @db.Text
  href      String?
  dedupeKey String // duy nhất theo user → chống trùng
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  // ─── Notification v2 (kế hoạch docs/notification, 19/08/2026) ────────────────
  // Bổ sung THUẦN THÊM CỘT, không đổi/bỏ cột nào (luật Nền Hệ thống #4). Giá trị do
  // `lib/notifications/catalog.ts` quyết ở đường ghi — đừng set tay ở nơi gọi.

  // 1 trong 5 nhóm: action_required | parent_message | new_task | due_date | system.
  groupKey String @default("system")

  // 1 = khẩn (P1) · 2 = thường (P2) · 3 = tham khảo (P3) — quyết thứ tự sắp xếp + viền đỏ badge.
  priority Int @default(2)

  // "Đã nhìn thấy" — set khi mục hiện trong panel. TÁCH BẠCH với `readAt` ("đã đọc"): mở
  // panel KHÔNG được làm badge về 0 (rủi ro T4 của PRD). Chủ dự án chốt 19/08 rằng mốc đọc
  // ĐƯỢC dùng cho đánh giá nhân sự ⇒ hai mốc này là dữ liệu có hệ quả, chỉ ghi một lần,
  // không được đè lại.
  seenAt DateTime? @db.Timestamptz(6)

  // Đối tượng đích — dựng deep-link + thu hồi thông báo khi đối tượng bị xoá.
  entityType String?
  entityId   String?

  // Số sự kiện đã gộp vào mục này ("5 tin nhắn mới").
  aggregateCount Int @default(1)

  // Quá mốc này thì không đếm vào badge nữa (nhắc quá hạn, thông báo hết thời sự).
  expiresAt DateTime? @db.Timestamptz(6)

  // ACTIVE | EXPIRED (hết hạn / đối tượng đã xoá) | REVOKED (mất quyền xem).
  state String @default("ACTIVE")

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  // Đường đọc chính của chuông: đếm badge + liệt kê panel theo trạng thái.
  @@index([userId, state, readAt, createdAt(sort: Desc)])
  // Đếm chưa đọc theo từng nhóm cho hàng chip lọc.
  @@index([userId, groupKey, readAt])
}

model Notification {
  id            String               @id @default(cuid())
  title         String
  body          String               @db.Text
  audience      NotificationAudience @default(ALL_PARENTS)
  centerId      String?
  orgUnitId     String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  classId       String?
  studentId     String? // Đợt 6 #7 — target 1 học viên (audience=STUDENT)
  isPublished   Boolean              @default(true)
  publishedAt   DateTime?            @default(now()) @db.Timestamptz(6)
  createdById   String?
  createdByName String?
  // R7-17 — khoá chống trùng cho thông báo sinh từ DomainEvent (null = announcement thủ công).
  dedupeKey     String?              @unique
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  @@index([audience, isPublished])
  @@index([centerId])
  @@index([classId])
  @@index([studentId])
  @@index([createdAt])
  @@index([orgUnitId])
}

// ─── ParentRequest (Phase NHÓM 3) ────────────────────────────────────────────
// Yêu cầu của phụ huynh: báo vắng / học bù / chuyển lớp / chuyển cơ sở / bảo lưu.
enum ParentRequestType {
  ABSENCE
  MAKEUP
  TRANSFER_CLASS
  TRANSFER_CENTER
  RESERVE
  OTHER
  CONSENT_CHANGE // R7-05 AC5 — PH yêu cầu đổi consent ảnh sau convert (có log)
}

enum ParentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ParentRequest {
  id            String              @id @default(cuid())
  studentId     String
  student       Student             @relation("StudentParentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  parentUserId  String?
  type          ParentRequestType
  content       String              @db.Text
  preferredDate DateTime?           @db.Timestamptz(6)
  // Module QL học viên PHẦN 3 — buổi xin vắng (báo vắng ABSENCE); cột phẳng, không FK
  sessionId     String?
  status        ParentRequestStatus @default(PENDING)
  response      String?             @db.Text
  handledById   String?
  handledByName String?
  handledAt     DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)

  @@index([studentId])
  @@index([status, createdAt])
  @@index([parentUserId])
}

// ─── ParentFeedback (Phase NHÓM 3) ───────────────────────────────────────────
// Phụ huynh đánh giá (sao + nội dung). studentId là cột phẳng (không FK).
model ParentFeedback {
  id            String    @id @default(cuid())
  parentUserId  String?
  parentName    String?
  studentId     String?
  studentName   String?
  rating        Int // 1-5
  content       String    @db.Text
  // P1-g — admin phản hồi lại đánh giá (tuỳ chọn).
  adminResponse String?   @db.Text
  respondedById String?
  respondedAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([studentId])
}

// ─── Media (Phase NHÓM 3) ────────────────────────────────────────────────────
// Ảnh lớp học: GV upload (PENDING) → CENTER_MANAGER duyệt → phụ huynh xem ảnh
// APPROVED có tag con mình. classId/studentId là cột phẳng (không FK).
enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
  // DRAFT = kho ảnh — GV upload cả loạt, CHƯA chọn gửi PH; không hiện portal,
  // không vào hàng duyệt (reviewMedia chặn). Đặt CUỐI khớp thứ tự ALTER TYPE ADD VALUE.
  DRAFT
}

model ClassSessionMedia {
  id             String      @id @default(cuid())
  classId        String
  fileUrl        String
  fileName       String?
  caption        String?     @db.Text
  status         MediaStatus @default(PENDING)
  // Ảnh chung cả lớp (đánh dấu rõ ràng): mọi PH có con đang học lớp này đều xem
  // được. KHÁC với "không gắn thẻ" — ảnh không tag & không phải class-wide vẫn
  // ẩn với PH (giữ bất biến C6.2 trong lib/lms/media-consent.ts).
  isClassWide    Boolean     @default(false)
  // R7-09 — gắn ảnh vào BUỔI cụ thể + ngày chụp (scalar, fallback mức lớp nếu null).
  classSessionId String?
  takenAt        DateTime?
  uploadedById   String?
  uploadedByName String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?   @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  tags MediaStudentTag[]

  @@index([classId, status])
  @@index([status, createdAt])
  @@index([classSessionId])
}

// R7-14 — auto-giao bài khi "Hoàn tất buổi". 1 bản ghi / (buổi × bài thi × HV);
// unique đảm bảo idempotent khi event session.taught replay. ID phẳng (soft-ref).
enum HomeworkAssignmentStatus {
  ASSIGNED
  SUBMITTED
  GRADED
  MISSED
}

model HomeworkAssignment {
  id             String                   @id @default(cuid())
  classSessionId String
  examId         String
  studentId      String
  dueAt          DateTime?
  status         HomeworkAssignmentStatus @default(ASSIGNED)
  assignMode     String? // NOW / DEFER / CUSTOM_DUE
  assignedById   String?
  assignedAt     DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([classSessionId, examId, studentId])
  @@index([studentId])
  @@index([examId])
  @@index([classSessionId])
}

model MediaStudentTag {
  id        String            @id @default(cuid())
  mediaId   String
  media     ClassSessionMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  studentId String

  @@unique([mediaId, studentId])
  @@index([studentId])
}

// ─── Employee QR attendance (Phase NHÓM 4) ───────────────────────────────────
// Chấm công bằng QR xoay (HMAC time-window, không cần lưu QR). EmployeeCheckin
// ghi check-in/out + GPS + geofence theo Center. userId là cột phẳng (no FK).
enum CheckinType {
  CHECK_IN
  CHECK_OUT
}

// Đợt 3E — đăng ký ca làm việc (3 ca/ngày).
enum WorkShift {
  CA_SANG
  CA_CHIEU
  CA_TOI
}

// R6-B2 — Ca làm việc cấu hình trong DB (per-center giờ/dung sai). 2-phase: enum WorkShift
// giữ nguyên để back-compat; check-in đọc giờ/tolerance từ đây. code khớp enum cũ (T12).
model WorkShiftConfig {
  id        String  @id @default(cuid())
  centerId  String? // null = mặc định toàn hệ thống
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  code             String // CA_SANG | CA_CHIEU | CA_TOI (khớp enum cũ)
  name             String
  startTime        String // "08:00"
  endTime          String // "11:30"
  toleranceMinutes Int      @default(15)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@unique([centerId, code])
  @@index([centerId, isActive])
  @@index([orgUnitId])
}

enum ShiftRegStatus {
  REGISTERED
  LEAVE_REQUESTED
  APPROVED
}

model ShiftRegistration {
  id        String         @id @default(cuid())
  userId    String
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date      DateTime       @db.Date // 1 record / nhân viên / ngày
  shifts    WorkShift[]
  status    ShiftRegStatus @default(REGISTERED)
  note      String?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([centerId, date])
  @@index([userId, date])
  @@index([orgUnitId])
}

// Module Chấm công PHẦN 4 — yêu cầu chỉnh công + log chỉnh sửa.
enum AdjustStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimesheetAdjustmentRequest {
  id             String       @id @default(cuid())
  userId         String // người xin chỉnh
  centerId       String? // cơ sở (để quản lý lọc phạm vi)
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date           DateTime     @db.Date
  reason         String       @db.Text // lý do / giải trình
  requested      String? // nội dung đề nghị (vd giờ vào/ra đúng)
  status         AdjustStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?    @db.Timestamptz(6)
  reviewNote     String?      @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId, date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

// Log mọi lần chỉnh bản ghi công (ai, khi nào, từ→đến, lý do).
model TimesheetEditLog {
  id           String   @id @default(cuid())
  userId       String // chủ bản ghi công
  date         DateTime @db.Date
  field        String // "CHECK_IN" | "CHECK_OUT"
  fromValue    String? // giờ cũ (ISO) hoặc null
  toValue      String? // giờ mới (ISO)
  reason       String?  @db.Text
  editedById   String?
  editedByName String?
  requestId    String? // gắn yêu cầu chỉnh công (nếu duyệt từ yêu cầu)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, date])
  @@index([createdAt])
}

// Đơn từ GV (site giáo viên): 10 loại / 3 nhóm. GV gửi → PENDING → CENTER_MANAGER cơ sở
// duyệt/từ chối (scope theo centerId). Plain-string FK theo pattern TimesheetAdjustmentRequest
// (không relation — app resolve tên khi cần). Không tự sinh side-effect (chỉ trạng thái).
enum WorkRequestKind {
  CLASS_CHANGE // Đổi lớp dạy
  SUB_TEACH // Dạy thay
  CLASS_OFF // Nghỉ buổi dạy
  SHIFT_SWAP // Đổi ca
  OT // Tăng ca
  LATE_EARLY // Đi muộn / Về sớm
  TIMESHEET_FIX // Chỉnh công
  LEAVE // Nghỉ phép
  REMOTE // Làm từ xa
  BUSINESS_TRIP // Đi công tác
}

enum WorkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WorkRequest {
  id          String  @id @default(cuid())
  requesterId String // User (GV gửi đơn)
  centerId    String? // cơ sở của GV (scope duyệt CENTER_MANAGER)
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId   String?

  kind           WorkRequestKind
  status         WorkRequestStatus @default(PENDING)
  fromDate       DateTime?         @db.Date // ngày / từ ngày (đơn theo ngày)
  toDate         DateTime?         @db.Date // đến ngày (đơn khoảng)
  startTime      String? // "HH:mm"
  endTime        String? // "HH:mm"
  hours          Float? // OT tự tính / chỉnh công
  className      String? // tên lớp (snapshot, đơn liên quan lớp)
  classId        String? // link lớp (tuỳ chọn)
  targetUserId   String? // người dạy thay / nhận ca
  targetShiftId  String? // ca muốn đổi (ShiftRegistration id)
  detail         String? // meta phụ (nơi đến, hình thức muộn/sớm, người nhận…)
  reason         String            @db.Text // lý do (bắt buộc)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?         @db.Timestamptz(6)
  reviewNote     String?           @db.Text
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  @@index([requesterId, status])
  @@index([centerId, status, createdAt])
  @@index([orgUnitId])
}

// Module Quản lý lớp phần 4 — checklist mở/đóng cơ sở theo ngày.
model CenterDayChecklist {
  id        String   @id @default(cuid())
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date      DateTime @db.Date

  // Đầu ngày
  openPower       Boolean @default(false)
  openDevices     Boolean @default(false)
  openRoomsReady  Boolean @default(false)
  openCleanCommon Boolean @default(false)
  openSecurity    Boolean @default(false)
  // Cuối ngày
  closePower      Boolean @default(false)
  closeDevices    Boolean @default(false)
  closeLock       Boolean @default(false)
  closeKpiBoard   Boolean @default(false)
  closeSafety     Boolean @default(false)
  closeHandover   Boolean @default(false)

  note      String?  @db.Text
  byUserId  String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([centerId, date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

model EmployeeCheckin {
  id             String      @id @default(cuid())
  userId         String
  userName       String?
  centerId       String?
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  type           CheckinType
  checkedAt      DateTime    @default(now()) @db.Timestamptz(6)
  latitude       Float?
  longitude      Float?
  distanceMeters Int?
  withinGeofence Boolean     @default(true)
  qrToken        String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([userId, type, qrToken])
  @@index([userId, checkedAt])
  @@index([centerId, checkedAt])
  @@index([orgUnitId])
}

// ─── Cụm A1 — OTP service + kích hoạt tài khoản ─────────────────────────────

enum AccountStatus {
  PENDING_ACTIVATION // tài khoản phụ huynh mới tạo — chờ kích hoạt qua OTP
  ACTIVE
  DISABLED
}

enum OtpChannel {
  EMAIL
  SMS // QĐ-H 30/07: bỏ hẳn SMS brandname — giữ value vì enum Postgres không xoá được, KHÔNG dùng
  ZALO // AUTH-SĐT P3 — kênh ZNS (otp-provider cắm ở P4)
  // AUTH-SĐT P6 — mã cấp TẠI QUẦY khi ZNS chết: hệ thống KHÔNG gửi đi đâu cả,
  // nhân viên đọc mã cho phụ huynh. Tách riêng để /admin/otp-logs và SLO không
  // đếm nhầm nó là tin đã gửi (và để soát được ai cấp tay, bao nhiêu lần).
  OFFLINE
}

enum OtpPurpose {
  ACTIVATION
  RESET
  CHANGE_CONTACT
}

// 1 yêu cầu OTP. LƯU CODE DẠNG HASH (HMAC) — không lưu plain.
model OtpRequest {
  id          String     @id @default(cuid())
  target      String // email hoặc SĐT nhận OTP
  channel     OtpChannel @default(EMAIL)
  purpose     OtpPurpose
  codeHash    String // HMAC-SHA256(secret, code)
  expiresAt   DateTime   @db.Timestamptz(6)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  verifiedAt  DateTime?  @db.Timestamptz(6)
  consumedAt  DateTime?  @db.Timestamptz(6) // đã dùng để hoàn tất nghiệp vụ (set mật khẩu…)
  userId      String? // tài khoản liên quan (nếu có)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  deliveries OtpDeliveryLog[]

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
}

// Log mỗi lần gửi OTP qua provider.
model OtpDeliveryLog {
  id           String     @id @default(cuid())
  otpRequestId String
  otpRequest   OtpRequest @relation(fields: [otpRequestId], references: [id], onDelete: Cascade)
  channel      OtpChannel
  target       String
  provider     String // "resend" | "speedsms" | …
  status       String // "SENT" | "FAILED"
  error        String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([otpRequestId])
  @@index([target, createdAt])
}

// ─── Cụm A2 — Email tự động (queue + worker/cron) ───────────────────────────

enum EmailQueueStatus {
  PENDING
  SENT
  FAILED
}

// Hàng đợi email — KHÔNG gửi trực tiếp trong transaction nghiệp vụ; worker/cron
// xử lý + retry. templateKey = EmailTemplate.code (render qua template) hoặc dùng
// subject/body inline khi không có template.
model EmailQueue {
  id          String           @id @default(cuid())
  toEmail     String
  toName      String?
  templateKey String? // EmailTemplate.code để render; null = inline
  subject     String? // inline fallback (nếu không có template)
  bodyText    String?          @db.Text
  bodyHtml    String?          @db.Text
  payload     Json // biến render (vars)
  status      EmailQueueStatus @default(PENDING)
  attempts    Int              @default(0)
  maxAttempts Int              @default(3)
  error       String?          @db.Text
  contextType String?
  contextId   String?
  scheduledAt DateTime         @default(now()) @db.Timestamptz(6)
  sentAt      DateTime?        @db.Timestamptz(6)
  emailLogId  String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  @@index([status, scheduledAt])
  @@index([contextType, contextId])
  @@index([createdAt])
}

// ─── Cụm B1 — MakeupNeed: nhu cầu học bù ────────────────────────────────────

enum MakeupNeedStatus {
  PENDING // mới phát sinh, chờ xếp buổi bù
  SCHEDULED // đã gắn buổi bù
  COMPLETED // đã học bù xong
  CANCELLED
}

model MakeupNeed {
  id              String           @id @default(cuid())
  studentId       String
  classId         String
  centerId        String? // để lọc theo cơ sở
  orgUnitId       String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  missedSessionId String // buổi đã lỡ
  missedLessonId  String? // lesson của buổi lỡ
  status          MakeupNeedStatus @default(PENDING)
  makeupSessionId String? // buổi được xếp để bù
  note            String?          @db.Text
  createdById     String?
  scheduledById   String?
  completedAt     DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, missedSessionId])
  @@index([studentId, status])
  @@index([centerId, status])
  @@index([classId])
  @@index([orgUnitId])
}

// ─── Cụm B2 — Cảnh báo rủi ro học viên + task chăm sóc ──────────────────────

enum RiskAlertType {
  CONSECUTIVE_ABSENCE // nghỉ 2 buổi liên tiếp
  HIGH_ABSENCE // nghỉ quá ngưỡng
  MISSED_SUBMISSIONS // không nộp bài nhiều lần
  NEEDS_SUPPORT // GV đánh dấu cần hỗ trợ nhiều lần
  NEARING_END_NO_RENEWAL // sắp hết khoá chưa tái đăng ký
  OVERDUE_PAYMENT // công nợ quá hạn
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  RESOLVED
  ESCALATED
}

model StudentRiskAlert {
  id           String        @id @default(cuid())
  studentId    String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  type         RiskAlertType
  severity     RiskSeverity  @default(MEDIUM)
  status       RiskStatus    @default(OPEN)
  detail       String?       @db.Text
  resolvedById String?
  resolvedAt   DateTime?     @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careTasks StudentCareTask[]

  @@index([studentId, status])
  @@index([centerId, status])
  // Idempotent: 1 alert OPEN / loại / học viên (tạo lại sau khi resolve thì cần key khác — dùng app logic).
  @@index([orgUnitId])
}

enum CareTaskStatus {
  OPEN
  DONE
  CANCELLED
}

model StudentCareTask {
  id           String         @id @default(cuid())
  studentId    String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  assignedToId String? // SALES_CSM phụ trách
  riskAlertId  String?
  title        String
  description  String?        @db.Text
  dueAt        DateTime       @db.Timestamptz(6)
  status       CareTaskStatus @default(OPEN)
  completedAt  DateTime?      @db.Timestamptz(6)
  createdById  String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  riskAlert StudentRiskAlert? @relation(fields: [riskAlertId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt])
  @@index([centerId, status])
  @@index([studentId])
  @@index([orgUnitId])
}

/// Sinh nhật học viên — sổ cái MỘT dòng cho MỘT lần sinh nhật của MỘT học viên.
///
/// Vì sao cần bảng riêng thay vì mượn StudentCareTask: cron chạy mỗi ngày, không có
/// khoá chống trùng thì mỗi sáng đẻ thêm một việc + gửi lại một tin ZNS mất tiền. Khoá
/// `@@unique([studentId, year])` là chỗ chặn đó, đồng thời là nơi giữ trạng thái ZNS
/// (StudentCareTask không có chỗ lưu) để tra "phụ huynh có nhận được lời chúc không".
///
/// ⚠️ CHỈ tạo dòng cho học viên ĐANG HỌC và TÌM ĐƯỢC buổi tổ chức. HV chưa xếp lớp /
/// lớp đã kết thúc → bỏ qua hoàn toàn (chủ dự án chốt 06/08/2026): không việc, không tin.
model StudentBirthdayGreeting {
  id           String   @id @default(cuid())
  studentId    String
  /// Năm dương lịch của lần sinh nhật này — nửa còn lại của khoá chống trùng.
  year         Int
  /// Ngày sinh nhật quy về năm `year`, lưu UTC-midnight — CÙNG quy ước với
  /// Student.dateOfBirth (mọi đường ghi đều ép Date.UTC), nên so ngày không lệch múi giờ.
  birthdayDate DateTime @db.Timestamptz(6)
  centerId     String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId    String?

  /// Buổi học được chọn để tổ chức (buổi đúng hôm sinh nhật, hoặc buổi liền trước).
  celebrationSessionId String?
  /// Ngày của buổi tổ chức — nhân bản ra đây để lọc "sắp tới hạn" không phải join ClassSession.
  celebrationDate      DateTime? @db.Timestamptz(6)

  /// Đã đẩy thông báo cho Sale/QLCS/GV chưa — chống dội chuông mỗi lần cron chạy lại.
  staffNotifiedAt DateTime? @db.Timestamptz(6)
  /// Nhân sự bấm "Đã chúc" trên /admin/sinh-nhat.
  celebratedAt    DateTime? @db.Timestamptz(6)
  celebratedById  String?

  /// Kết quả gửi ZNS. NULL = chưa gửi. SIMULATED = có creds nhưng ZALO_LIVE tắt ⇒
  /// phụ huynh KHÔNG nhận gì (xem lib/zalo/provider.ts) — đừng đọc nhầm là đã gửi.
  znsStatus String? // SENT | SIMULATED | SKIPPED | FAILED
  znsLogId  String? // → ZaloMessageLog.id
  znsSentAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, year])
  @@index([centerId, birthdayDate])
  @@index([celebrationDate])
  @@index([birthdayDate])
  @@index([orgUnitId])
}

// ─── Cụm B3 — Khảo sát / NPS ────────────────────────────────────────────────

enum SurveyMilestone {
  AFTER_TRIAL
  AFTER_3_SESSIONS
  MID_COURSE
  END_COURSE
  AFTER_COMPLAINT
  GENERAL
}

enum SurveyQuestionType {
  NPS // 0-10
  RATING // 1-5
  TEXT
}

model Survey {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  milestone   SurveyMilestone @default(GENERAL)
  isActive    Boolean         @default(true)
  centerId    String? // null = mọi cơ sở
  orgUnitId   String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  createdById String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([isActive, milestone])
  @@index([centerId])
  @@index([orgUnitId])
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  surveyId String
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String             @db.Text
  type     SurveyQuestionType @default(RATING)
  order    Int                @default(0)

  @@index([surveyId, order])
}

// 1 lần phụ huynh trả lời. Gắn center/class/teacher/csm → cơ sở KPI CSKH.
model SurveyResponse {
  id           String   @id @default(cuid())
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentId    String?
  parentUserId String?
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  classId      String?
  teacherId    String?
  csmId        String? // SALES_CSM phụ trách
  npsScore     Int? // 0-10
  comment      String?  @db.Text
  answers      Json? // {questionId: value}
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  // Chống trả lời trùng 1 survey cho 1 con (double-submit TOCTOU ở portal).
  // studentId NULL không bị ràng buộc (Postgres coi NULL là distinct).
  @@unique([surveyId, studentId])
  @@index([surveyId, createdAt])
  @@index([centerId, createdAt])
  @@index([csmId])
  @@index([teacherId])
  @@index([orgUnitId])
}

// ─── Cụm B4 — Hoàn thành khoá + chứng chỉ ───────────────────────────────────

model CourseCompletion {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  classId         String?
  completedAt     DateTime @default(now()) @db.Timestamptz(6)
  finalAssessment String?  @db.Text // GV đánh giá cuối khoá
  finalGrade      String? // điểm/xếp loại cuối khoá
  certificateCode String   @unique // CERT-YYMMDD-XXXX
  nextCourseId    String? // gợi ý khoá tiếp theo
  createdById     String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation("CourseCompletions", fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// Đề xuất hoàn thành khoá (site GV): GV đề xuất → CENTER_MANAGER cơ sở duyệt → tạo
// CourseCompletion. Plain-string FK (pattern WorkRequest). GV chỉ ĐỀ XUẤT (không tự
// xác nhận hoàn thành — quyền completions:manage vẫn ở trung tâm).
enum CourseCompletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CourseCompletionRequest {
  id           String  @id @default(cuid())
  enrollmentId String
  studentId    String
  courseId     String
  centerId     String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId    String?

  requesterId    String // GV đề xuất
  status         CourseCompletionRequestStatus @default(PENDING)
  nextCourseId   String? // lộ trình chuyển cấp đề xuất
  note           String?                       @db.Text
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?                     @db.Timestamptz(6)
  reviewNote     String?                       @db.Text
  createdAt      DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @db.Timestamptz(6)

  @@index([enrollmentId, status])
  @@index([centerId, status])
  @@index([requesterId, status])
  @@index([orgUnitId])
}

// =============================================================================
// Cụm C1 — Chuyển lớp / chuyển cơ sở (StudentTransferRequest + lịch sử cơ sở)
// =============================================================================

enum TransferRequestStatus {
  PENDING // chờ duyệt
  APPROVED // đã chuyển
  REJECTED
  WAITLISTED // chưa có lớp đích phù hợp → chờ
  CANCELLED
}

model StudentTransferRequest {
  id            String                @id @default(cuid())
  studentId     String
  fromClassId   String? // lớp hiện tại
  fromCenterId  String?
  toClassId     String? // lớp đích (null nếu waitlist)
  toCenterId    String?
  status        TransferRequestStatus @default(PENDING)
  reason        String?               @db.Text
  note          String?               @db.Text // ghi chú khi duyệt/từ chối
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?             @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([status])
  @@index([toCenterId])
}

model StudentCenterHistory {
  id        String    @id @default(cuid())
  studentId String
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  fromDate  DateTime  @default(now()) @db.Timestamptz(6)
  toDate    DateTime? @db.Timestamptz(6) // null = đang ở cơ sở này
  reason    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([centerId])
  @@index([orgUnitId])
}

// =============================================================================
// Cụm C2 — Lịch sử phân công lead (bàn giao khi sale nghỉ)
// =============================================================================

model LeadAssignmentHistory {
  id           String   @id @default(cuid())
  leadId       String
  fromUserId   String? // sale cũ
  toUserId     String? // sale mới
  assignedById String? // người thực hiện bàn giao
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([fromUserId])
  @@index([toUserId])
}

// =============================================================================
// Cụm C3 — Rubric chấm bài robotics (6 tiêu chí, 4 mức)
// =============================================================================

enum RubricCriterion {
  ANALYSIS // Phân tích vấn đề
  DESIGN // Thiết kế & lắp ráp
  PROGRAMMING // Lập trình
  TESTING // Kiểm thử & gỡ lỗi
  CREATIVITY // Sáng tạo
  PRESENTATION // Trình bày & hợp tác
}

enum RubricLevel {
  NEED_SUPPORT // 1 — cần hỗ trợ
  BASIC // 2 — cơ bản
  GOOD // 3 — tốt
  EXCELLENT // 4 — xuất sắc
}

model SubmissionRubricScore {
  id           String          @id @default(cuid())
  submissionId String
  criterion    RubricCriterion
  level        RubricLevel
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterion])
  @@index([submissionId])
}

// =============================================================================
// Cụm C4 — SataCoin (điểm thưởng nội bộ). KHÔNG blockchain. Sổ cái BẤT BIẾN:
// điều chỉnh = ghi giao dịch đảo (reversal). Số dư = tổng amount.
// =============================================================================

enum SataCoinTxType {
  EARN // cộng coin (thưởng)
  SPEND // trừ coin (đổi quà)
  ADJUST // điều chỉnh thủ công (+/-)
  REVERSAL // đảo 1 giao dịch trước đó
}

model SataCoinTransaction {
  id           String         @id @default(cuid())
  studentId    String
  amount       Int // dương = cộng, âm = trừ
  type         SataCoinTxType
  reason       String // mã/lý do (vd "ATTENDANCE", "REDEEM_GIFT")
  note         String?        @db.Text
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  ruleCode     String? // rule áp dụng (nếu có)
  reversedTxId String?        @unique // trỏ tới giao dịch bị đảo (1-1)
  createdById  String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([centerId])
  @@index([orgUnitId])
}

model SataCoinRule {
  id        String  @id @default(cuid())
  code      String  @unique // ATTENDANCE, ASSIGNMENT_GOOD, ...
  label     String
  amount    Int // coin cộng khi áp rule
  isActive  Boolean @default(true)
  centerId  String? // null = áp mọi cơ sở
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([orgUnitId])
}

// R7-17 (PR3) — Cấu hình quy tắc Satacoin (PENDING — QĐ-O10/O20). SCHEMA-ONLY:
// migrate được + seed rỗng, KHÔNG code đọc runtime, KHÔNG UI cho tới khi TGĐ ban
// hành bảng quy đổi. behaviorKey = hành vi; points = điểm; cap ngày/tổng; source =
// nguồn phát sinh; active mặc định false (trơ). Không centerId → không qua scopedDb.
enum CoinRuleSource {
  HOMEWORK_RESULT // kết quả bài tập
  TEACHER_EVAL_DONE // hoàn tất đánh giá GV
  CENTER_SURVEY_DONE // hoàn tất khảo sát trung tâm
}

model CoinRuleConfig {
  id          String         @id @default(cuid())
  behaviorKey String         @unique // khóa hành vi (vd HOMEWORK_PASSED)
  points      Int // điểm cộng
  dailyCap    Int? // trần điểm/ngày (null = không trần)
  totalCap    Int? // trần điểm tổng (null = không trần)
  source      CoinRuleSource
  active      Boolean        @default(false) // trơ tới khi ban hành
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// =============================================================================
// R7-11/R7-12 — SCORM: gói bài giảng giải nén lên R2 private + player có bảo vệ.
// Giải nén qua DB-backed job (DomainEvent outbox A0-07) vì Vercel serverless
// không giữ tiến trình dài. Flag SCORM_ENABLED gate menu/route. Không centerId
// (gắn buổi qua lessonId) → không qua scopedDb.
// =============================================================================

enum ScormVersion {
  SCORM_12 // SCORM 1.2
  SCORM_2004
}

enum ScormPackageStatus {
  UPLOADING // đang upload (zip/pdf) lên R2 (presigned)
  PROCESSING // job đang giải nén + đọc manifest (chỉ SCORM)
  FAILED // job lỗi (xem error) — resume được
  TESTING // giải nén xong, Đào tạo xem thử trước publish
  PUBLISHED // đã phát hành, GV mở được
  ARCHIVED // bản cũ (không xóa vật lý trong R7)
}

// Loại giáo án/học liệu mỗi buổi: gói SCORM (.zip giải nén) hoặc 1 file PDF (slide).
// Cả 2 hiển thị chung 1 khung trình chiếu (slider) ở "Tài liệu lớp tôi".
enum LessonMaterialKind {
  SCORM
  PDF
}

model ScormPackage {
  id                String             @id @default(cuid())
  lessonId          String // gắn buổi (FK)
  name              String
  // Loại học liệu: SCORM (giải nén + manifest) hoặc PDF (slide render bằng pdf.js).
  kind              LessonMaterialKind @default(SCORM)
  scormVersion      ScormVersion? // đọc từ manifest sau khi giải nén (chỉ SCORM)
  storagePrefix     String // prefix R2 `scorm/{packageId}/`
  uploadKey         String? // key R2 của zip gốc đã upload
  launchUrl         String? // đường dẫn launch (tương đối trong prefix)
  sizeBytes         Int? // tổng kích thước
  fileCount         Int? // số entry đã giải nén
  status            ScormPackageStatus @default(UPLOADING)
  version           Int                @default(1) // version per lesson
  isActiveForLesson Boolean            @default(false) // chỉ 1 active/buổi
  entryCursor       Int                @default(0) // con trỏ entry để job resume (idempotent)
  error             String? // lý do FAILED
  uploadedById      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  accessLogs ScormAccessLog[]
  attempts   ScormAttempt[] // LMS-14 — theo dõi GV giảng (KHÔNG ghi điểm HV)

  // 1 active duy nhất mỗi buổi: PARTIAL unique `(lessonId) WHERE isActiveForLesson`
  // tạo bằng raw SQL trong migration (Prisma không khai báo partial index native).

  /// EL-03 — bài học nội bộ kiểu SCORM. Cột khai từ GƐ1, khoá bằng validator tới GƐ4.
  trnLessons TrnLesson[] @relation("TrnLessonScorm")

  @@index([lessonId])
  @@index([status])
}

// LMS-14 — Theo dõi GIÁO VIÊN hoàn thành GIẢNG tài liệu SCORM (delivery tracking).
// LEARNER = GV/staff đang xem để giảng, KHÔNG phải HV (HV không xem SCORM — yêu cầu chốt).
// KHÔNG nối học bạ HV. Lưu cmi (SCORM 1.2 runtime) để resume + ghi nhận đã giảng.
enum ScormCompletion {
  NOT_ATTEMPTED
  INCOMPLETE
  COMPLETED
  PASSED
  FAILED
  BROWSED
}

model ScormAttempt {
  id             String          @id @default(cuid())
  packageId      String
  package        ScormPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId         String // GV/staff (người giảng) — KHÔNG phải studentId
  classSessionId String? // buổi giảng (nếu mở từ buổi); null = xem ngoài buổi
  completion     ScormCompletion @default(NOT_ATTEMPTED) // map từ cmi.core.lesson_status
  scoreRaw       Float? // cmi.core.score.raw (self-check của GV, không phải điểm HV)
  lessonLocation String?         @db.Text // cmi.core.lesson_location (bookmark)
  suspendData    String?         @db.Text // cmi.suspend_data (resume)
  totalTimeSec   Int             @default(0) // tổng thời gian tích lũy (giây)
  sessionCount   Int             @default(0) // số lần mở
  lastAccessedAt DateTime        @default(now()) @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  @@index([packageId])
  @@index([userId])
  @@index([classSessionId])
}

model ScormAccessLog {
  id             String   @id @default(cuid())
  packageId      String
  classSessionId String? // buổi GV mở (nếu mở theo lớp)
  userId         String // ai mở
  openedAt       DateTime @default(now())
  ip             String?

  package ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, openedAt])
  @@index([userId])
}

// NOTE(reconcile FixLMS→main): bản ScormAttempt ghi-điểm-HV của FixLMS (LMS-14)
// đã GỠ — D4 theo MAIN (R7-12 tracking GV, KHÔNG ghi điểm HV). Xem model ScormAttempt ở trên.

// =============================================================================
// Cụm C5 — Zalo OA/ZNS adapter (SKELETON). Tắt an toàn khi thiếu credential →
// fallback email, không phá hệ thống. Log mọi lần gửi.
// =============================================================================

enum ZaloMessageStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // chưa cấu hình credential → bỏ qua (fallback email)
}

model ZaloMessageLog {
  id                String            @id @default(cuid())
  toPhone           String?
  templateKey       String?
  payload           Json              @default("{}")
  status            ZaloMessageStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?           @db.Text
  fallbackEmailed   Boolean           @default(false)
