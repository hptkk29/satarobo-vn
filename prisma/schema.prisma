// =============================================================================
// Cụm C6 — MISA AMIS sync (SKELETON) + IntegrationLog/IntegrationConfig chung.
// Bật/tắt qua config; KHÔNG push API thật khi tắt hoặc thiếu credential.
// =============================================================================

enum IntegrationStatus {
  PENDING
  SUCCESS
  SKIPPED // tắt hoặc thiếu credential → bỏ qua, không lỗi
  FAILED
}

enum IntegrationDirection {
  PUSH
  PULL
}

model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String   @unique // "MISA"
  isEnabled Boolean  @default(false)
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model IntegrationLog {
  id              String               @id @default(cuid())
  provider        String // "MISA"
  direction       IntegrationDirection @default(PUSH)
  action          String // "PUSH_INVOICE", "PUSH_PAYMENT", ...
  status          IntegrationStatus    @default(PENDING)
  requestPayload  Json                 @default("{}")
  responsePayload Json?
  errorMessage    String?              @db.Text
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)

  @@index([provider, status, createdAt])
}

// ───────────────────────────────────────────────────────────────────────────
// R6-A — Cấu hình hệ thống 2 tầng (Flexibility & Hardening).
// Resolve giá trị: CenterSetting (theo OrgUnit) → SystemSetting (GLOBAL) →
// default trong code (registry lib/settings/registry.ts). Key phải có schema
// trong registry mới được ghi (validate Zod). Mọi thay đổi ghi AuditLog.
// ───────────────────────────────────────────────────────────────────────────
/// Tham số vận hành toàn hệ thống (GLOBAL). Chỉ SUPER_ADMIN sửa.
model SystemSetting {
  key           String   @id // khớp key registry, vd "student.nearEndThreshold"
  valueJson     Json
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
}

/// Override tham số theo cơ sở (OrgUnit). CENTER_MANAGER cơ sở đó / SUPER_ADMIN sửa.
model CenterSetting {
  orgUnitId     String // OrgUnit.id (cơ sở áp dụng)
  key           String // khớp key registry, phải centerOverridable=true
  valueJson     Json
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@id([orgUnitId, key])
  @@index([key])
