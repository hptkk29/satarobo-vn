// ─── Notification (Phase NHÓM 3) ─────────────────────────────────────────────
// Thông báo cho phụ huynh. Target theo audience. centerId/classId là cột phẳng
// (không FK) để giữ migration nhỏ — portal match theo studentId/classId của con.
enum NotificationAudience {
  ALL_PARENTS
  CENTER
  CLASS
  STUDENT // Đợt 6 #7 — gửi cho 1 học viên/phụ huynh cụ thể
}

// Module nhắc việc PHẦN 3 — thông báo CHUÔNG cho NHÂN VIÊN (per-user, có đọc/chưa).
// Khác Notification (broadcast phụ huynh). dedupeKey chống tạo trùng cùng 1 việc.
model StaffNotification {
  id        String    @id @default(cuid())
  userId    String
  category  String // = PendingTaskType (loại việc)
  title     String
  body      String    @db.Text
  href      String?
  dedupeKey String // duy nhất theo user → chống trùng
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Notification {
  id            String               @id @default(cuid())
  title         String
  body          String               @db.Text
  audience      NotificationAudience @default(ALL_PARENTS)
  centerId      String?
  orgUnitId     String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  classId       String?
  studentId     String? // Đợt 6 #7 — target 1 học viên (audience=STUDENT)
  isPublished   Boolean              @default(true)
  publishedAt   DateTime?            @default(now())
  createdById   String?
  createdByName String?
  // R7-17 — khoá chống trùng cho thông báo sinh từ DomainEvent (null = announcement thủ công).
  dedupeKey   String?              @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([audience, isPublished])
  @@index([centerId])
  @@index([classId])
  @@index([studentId])
  @@index([createdAt])
  @@index([orgUnitId])
}

// ─── ParentRequest (Phase NHÓM 3) ────────────────────────────────────────────
// Yêu cầu của phụ huynh: báo vắng / học bù / chuyển lớp / chuyển cơ sở / bảo lưu.
enum ParentRequestType {
  ABSENCE
  MAKEUP
  TRANSFER_CLASS
  TRANSFER_CENTER
  RESERVE
  OTHER
  CONSENT_CHANGE // R7-05 AC5 — PH yêu cầu đổi consent ảnh sau convert (có log)
}

enum ParentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ParentRequest {
  id            String              @id @default(cuid())
  studentId     String
  student       Student             @relation("StudentParentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  parentUserId  String?
  type          ParentRequestType
  content       String              @db.Text
  preferredDate DateTime?
  // Module QL học viên PHẦN 3 — buổi xin vắng (báo vắng ABSENCE); cột phẳng, không FK
  sessionId     String?
  status        ParentRequestStatus @default(PENDING)
  response      String?             @db.Text
  handledById   String?
  handledByName String?
  handledAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([studentId])
  @@index([status, createdAt])
  @@index([parentUserId])
}

// ─── ParentFeedback (Phase NHÓM 3) ───────────────────────────────────────────
// Phụ huynh đánh giá (sao + nội dung). studentId là cột phẳng (không FK).
model ParentFeedback {
  id            String    @id @default(cuid())
  parentUserId  String?
  parentName    String?
  studentId     String?
  studentName   String?
  rating        Int // 1-5
  content       String    @db.Text
  // P1-g — admin phản hồi lại đánh giá (tuỳ chọn).
  adminResponse String?   @db.Text
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([studentId])
}

// ─── Media (Phase NHÓM 3) ────────────────────────────────────────────────────
// Ảnh lớp học: GV upload (PENDING) → CENTER_MANAGER duyệt → phụ huynh xem ảnh
// APPROVED có tag con mình. classId/studentId là cột phẳng (không FK).
enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClassSessionMedia {
  id             String      @id @default(cuid())
  classId        String
  fileUrl        String
  fileName       String?
  caption        String?           @db.Text
  status         MediaStatus       @default(PENDING)
  // Ảnh chung cả lớp (đánh dấu rõ ràng): mọi PH có con đang học lớp này đều xem
  // được. KHÁC với "không gắn thẻ" — ảnh không tag & không phải class-wide vẫn
  // ẩn với PH (giữ bất biến C6.2 trong lib/lms/media-consent.ts).
  isClassWide    Boolean           @default(false)
  uploadedById   String?
  uploadedByName String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  createdAt      DateTime    @default(now())

  tags MediaStudentTag[]

  @@index([classId, status])
  @@index([status, createdAt])
}

model MediaStudentTag {
  id        String            @id @default(cuid())
  mediaId   String
  media     ClassSessionMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  studentId String

  @@unique([mediaId, studentId])
  @@index([studentId])
}

// ─── Employee QR attendance (Phase NHÓM 4) ───────────────────────────────────
// Chấm công bằng QR xoay (HMAC time-window, không cần lưu QR). EmployeeCheckin
// ghi check-in/out + GPS + geofence theo Center. userId là cột phẳng (no FK).
enum CheckinType {
  CHECK_IN
  CHECK_OUT
}

// Đợt 3E — đăng ký ca làm việc (3 ca/ngày).
enum WorkShift {
  CA_SANG
  CA_CHIEU
  CA_TOI
}

// R6-B2 — Ca làm việc cấu hình trong DB (per-center giờ/dung sai). 2-phase: enum WorkShift
// giữ nguyên để back-compat; check-in đọc giờ/tolerance từ đây. code khớp enum cũ (T12).
model WorkShiftConfig {
  id               String   @id @default(cuid())
  centerId         String? // null = mặc định toàn hệ thống
  code             String // CA_SANG | CA_CHIEU | CA_TOI (khớp enum cũ)
  name             String
  startTime        String // "08:00"
  endTime          String // "11:30"
  toleranceMinutes Int      @default(15)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([centerId, code])
  @@index([centerId, isActive])
}

enum ShiftRegStatus {
  REGISTERED
  LEAVE_REQUESTED
  APPROVED
}

model ShiftRegistration {
  id        String         @id @default(cuid())
  userId    String
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date      DateTime       @db.Date // 1 record / nhân viên / ngày
  shifts    WorkShift[]
  status    ShiftRegStatus @default(REGISTERED)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([centerId, date])
  @@index([userId, date])
  @@index([orgUnitId])
}

// Module Chấm công PHẦN 4 — yêu cầu chỉnh công + log chỉnh sửa.
enum AdjustStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimesheetAdjustmentRequest {
  id             String       @id @default(cuid())
  userId         String // người xin chỉnh
  centerId       String? // cơ sở (để quản lý lọc phạm vi)
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date           DateTime     @db.Date
  reason         String       @db.Text // lý do / giải trình
  requested      String? // nội dung đề nghị (vd giờ vào/ra đúng)
  status         AdjustStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([userId, date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

// Log mọi lần chỉnh bản ghi công (ai, khi nào, từ→đến, lý do).
model TimesheetEditLog {
  id           String   @id @default(cuid())
  userId       String // chủ bản ghi công
  date         DateTime @db.Date
  field        String // "CHECK_IN" | "CHECK_OUT"
  fromValue    String? // giờ cũ (ISO) hoặc null
  toValue      String? // giờ mới (ISO)
  reason       String?  @db.Text
  editedById   String?
  editedByName String?
  requestId    String? // gắn yêu cầu chỉnh công (nếu duyệt từ yêu cầu)
  createdAt    DateTime @default(now())

  @@index([userId, date])
  @@index([createdAt])
}

// Module Quản lý lớp phần 4 — checklist mở/đóng cơ sở theo ngày.
model CenterDayChecklist {
  id        String   @id @default(cuid())
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date      DateTime @db.Date

  // Đầu ngày
  openPower       Boolean @default(false)
  openDevices     Boolean @default(false)
  openRoomsReady  Boolean @default(false)
  openCleanCommon Boolean @default(false)
  openSecurity    Boolean @default(false)
  // Cuối ngày
  closePower      Boolean @default(false)
  closeDevices    Boolean @default(false)
  closeLock       Boolean @default(false)
  closeKpiBoard   Boolean @default(false)
  closeSafety     Boolean @default(false)
  closeHandover   Boolean @default(false)

  note      String?  @db.Text
  byUserId  String?
  updatedAt DateTime @updatedAt

  @@unique([centerId, date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

model EmployeeCheckin {
  id             String      @id @default(cuid())
  userId         String
  userName       String?
  centerId       String?
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  type           CheckinType
  checkedAt      DateTime    @default(now())
  latitude       Float?
  longitude      Float?
  distanceMeters Int?
  withinGeofence Boolean     @default(true)
  qrToken        String?
  createdAt      DateTime    @default(now())

  @@unique([userId, type, qrToken])
  @@index([userId, checkedAt])
  @@index([centerId, checkedAt])
  @@index([orgUnitId])
}

// ─── Cụm A1 — OTP service + kích hoạt tài khoản ─────────────────────────────

enum AccountStatus {
  PENDING_ACTIVATION // tài khoản phụ huynh mới tạo — chờ kích hoạt qua OTP
  ACTIVE
  DISABLED
}

enum OtpChannel {
  EMAIL
  SMS // TODO: chưa dùng (chưa đăng ký brandname) — provider abstraction chừa sẵn
}

enum OtpPurpose {
  ACTIVATION
  RESET
  CHANGE_CONTACT
}

// 1 yêu cầu OTP. LƯU CODE DẠNG HASH (HMAC) — không lưu plain.
model OtpRequest {
  id          String     @id @default(cuid())
  target      String // email hoặc SĐT nhận OTP
  channel     OtpChannel @default(EMAIL)
  purpose     OtpPurpose
  codeHash    String // HMAC-SHA256(secret, code)
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  verifiedAt  DateTime?
  consumedAt  DateTime? // đã dùng để hoàn tất nghiệp vụ (set mật khẩu…)
  userId      String? // tài khoản liên quan (nếu có)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  deliveries OtpDeliveryLog[]

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
}

// Log mỗi lần gửi OTP qua provider.
model OtpDeliveryLog {
  id           String     @id @default(cuid())
  otpRequestId String
  otpRequest   OtpRequest @relation(fields: [otpRequestId], references: [id], onDelete: Cascade)
  channel      OtpChannel
  target       String
  provider     String // "resend" | "speedsms" | …
  status       String // "SENT" | "FAILED"
  error        String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([otpRequestId])
  @@index([target, createdAt])
}

// ─── Cụm A2 — Email tự động (queue + worker/cron) ───────────────────────────

enum EmailQueueStatus {
  PENDING
  SENT
  FAILED
}

// Hàng đợi email — KHÔNG gửi trực tiếp trong transaction nghiệp vụ; worker/cron
// xử lý + retry. templateKey = EmailTemplate.code (render qua template) hoặc dùng
// subject/body inline khi không có template.
model EmailQueue {
  id          String           @id @default(cuid())
  toEmail     String
  toName      String?
  templateKey String? // EmailTemplate.code để render; null = inline
  subject     String? // inline fallback (nếu không có template)
  bodyText    String?          @db.Text
  bodyHtml    String?          @db.Text
  payload     Json // biến render (vars)
  status      EmailQueueStatus @default(PENDING)
  attempts    Int              @default(0)
  maxAttempts Int              @default(3)
  error       String?          @db.Text
  contextType String?
  contextId   String?
  scheduledAt DateTime         @default(now())
  sentAt      DateTime?
  emailLogId  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, scheduledAt])
  @@index([contextType, contextId])
  @@index([createdAt])
}

// ─── Cụm B1 — MakeupNeed: nhu cầu học bù ────────────────────────────────────

enum MakeupNeedStatus {
  PENDING // mới phát sinh, chờ xếp buổi bù
  SCHEDULED // đã gắn buổi bù
  COMPLETED // đã học bù xong
  CANCELLED
}

model MakeupNeed {
  id              String           @id @default(cuid())
  studentId       String
  classId         String
  centerId        String? // để lọc theo cơ sở
  orgUnitId       String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  missedSessionId String // buổi đã lỡ
  missedLessonId  String? // lesson của buổi lỡ
  status          MakeupNeedStatus @default(PENDING)
  makeupSessionId String? // buổi được xếp để bù
  note            String?          @db.Text
  createdById     String?
  scheduledById   String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, missedSessionId])
  @@index([studentId, status])
  @@index([centerId, status])
  @@index([classId])
  @@index([orgUnitId])
}

// ─── Cụm B2 — Cảnh báo rủi ro học viên + task chăm sóc ──────────────────────

enum RiskAlertType {
  CONSECUTIVE_ABSENCE // nghỉ 2 buổi liên tiếp
  HIGH_ABSENCE // nghỉ quá ngưỡng
  MISSED_SUBMISSIONS // không nộp bài nhiều lần
  NEEDS_SUPPORT // GV đánh dấu cần hỗ trợ nhiều lần
  NEARING_END_NO_RENEWAL // sắp hết khoá chưa tái đăng ký
  OVERDUE_PAYMENT // công nợ quá hạn
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  RESOLVED
  ESCALATED
}

model StudentRiskAlert {
  id           String        @id @default(cuid())
  studentId    String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  type         RiskAlertType
  severity     RiskSeverity  @default(MEDIUM)
  status       RiskStatus    @default(OPEN)
  detail       String?       @db.Text
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careTasks StudentCareTask[]

  @@index([studentId, status])
  @@index([centerId, status])
  // Idempotent: 1 alert OPEN / loại / học viên (tạo lại sau khi resolve thì cần key khác — dùng app logic).
  @@index([orgUnitId])
}

enum CareTaskStatus {
  OPEN
  DONE
  CANCELLED
}

model StudentCareTask {
  id           String         @id @default(cuid())
  studentId    String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  assignedToId String? // SALES_CSM phụ trách
  riskAlertId  String?
  title        String
  description  String?        @db.Text
  dueAt        DateTime
  status       CareTaskStatus @default(OPEN)
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  riskAlert StudentRiskAlert? @relation(fields: [riskAlertId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt])
  @@index([centerId, status])
  @@index([studentId])
  @@index([orgUnitId])
}

// ─── Cụm B3 — Khảo sát / NPS ────────────────────────────────────────────────

enum SurveyMilestone {
  AFTER_TRIAL
  AFTER_3_SESSIONS
  MID_COURSE
  END_COURSE
  AFTER_COMPLAINT
  GENERAL
}

enum SurveyQuestionType {
  NPS // 0-10
  RATING // 1-5
  TEXT
}

model Survey {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  milestone   SurveyMilestone @default(GENERAL)
  isActive    Boolean         @default(true)
  centerId    String? // null = mọi cơ sở
  orgUnitId   String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([isActive, milestone])
  @@index([centerId])
  @@index([orgUnitId])
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  surveyId String
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String             @db.Text
  type     SurveyQuestionType @default(RATING)
  order    Int                @default(0)

  @@index([surveyId, order])
}

// 1 lần phụ huynh trả lời. Gắn center/class/teacher/csm → cơ sở KPI CSKH.
model SurveyResponse {
  id           String   @id @default(cuid())
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentId    String?
  parentUserId String?
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  classId      String?
  teacherId    String?
  csmId        String? // SALES_CSM phụ trách
  npsScore     Int? // 0-10
  comment      String?  @db.Text
  answers      Json? // {questionId: value}
  createdAt    DateTime @default(now())

  @@index([surveyId, createdAt])
  @@index([centerId, createdAt])
  @@index([csmId])
  @@index([teacherId])
  @@index([orgUnitId])
}

// ─── Cụm B4 — Hoàn thành khoá + chứng chỉ ───────────────────────────────────

model CourseCompletion {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  classId         String?
  completedAt     DateTime @default(now())
  finalAssessment String?  @db.Text // GV đánh giá cuối khoá
  finalGrade      String? // điểm/xếp loại cuối khoá
  certificateCode String   @unique // CERT-YYMMDD-XXXX
  nextCourseId    String? // gợi ý khoá tiếp theo
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation("CourseCompletions", fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// =============================================================================
// Cụm C1 — Chuyển lớp / chuyển cơ sở (StudentTransferRequest + lịch sử cơ sở)
// =============================================================================

enum TransferRequestStatus {
  PENDING // chờ duyệt
  APPROVED // đã chuyển
  REJECTED
  WAITLISTED // chưa có lớp đích phù hợp → chờ
  CANCELLED
}

model StudentTransferRequest {
  id            String                @id @default(cuid())
  studentId     String
  fromClassId   String? // lớp hiện tại
  fromCenterId  String?
  toClassId     String? // lớp đích (null nếu waitlist)
  toCenterId    String?
  status        TransferRequestStatus @default(PENDING)
  reason        String?               @db.Text
  note          String?               @db.Text // ghi chú khi duyệt/từ chối
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([status])
  @@index([toCenterId])
}

model StudentCenterHistory {
  id        String    @id @default(cuid())
  studentId String
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  fromDate  DateTime  @default(now())
  toDate    DateTime? // null = đang ở cơ sở này
  reason    String?
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([centerId])
  @@index([orgUnitId])
}

// =============================================================================
// Cụm C2 — Lịch sử phân công lead (bàn giao khi sale nghỉ)
// =============================================================================

model LeadAssignmentHistory {
  id           String   @id @default(cuid())
  leadId       String
  fromUserId   String? // sale cũ
  toUserId     String? // sale mới
  assignedById String? // người thực hiện bàn giao
  reason       String?  @db.Text
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([fromUserId])
  @@index([toUserId])
}

// =============================================================================
// Cụm C3 — Rubric chấm bài robotics (6 tiêu chí, 4 mức)
// =============================================================================

enum RubricCriterion {
  ANALYSIS // Phân tích vấn đề
  DESIGN // Thiết kế & lắp ráp
  PROGRAMMING // Lập trình
  TESTING // Kiểm thử & gỡ lỗi
  CREATIVITY // Sáng tạo
  PRESENTATION // Trình bày & hợp tác
}

enum RubricLevel {
  NEED_SUPPORT // 1 — cần hỗ trợ
  BASIC // 2 — cơ bản
  GOOD // 3 — tốt
  EXCELLENT // 4 — xuất sắc
}

model SubmissionRubricScore {
  id           String          @id @default(cuid())
  submissionId String
  criterion    RubricCriterion
  level        RubricLevel
  createdAt    DateTime        @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterion])
  @@index([submissionId])
}

// =============================================================================
// Cụm C4 — SataCoin (điểm thưởng nội bộ). KHÔNG blockchain. Sổ cái BẤT BIẾN:
// điều chỉnh = ghi giao dịch đảo (reversal). Số dư = tổng amount.
// =============================================================================

enum SataCoinTxType {
  EARN // cộng coin (thưởng)
  SPEND // trừ coin (đổi quà)
  ADJUST // điều chỉnh thủ công (+/-)
  REVERSAL // đảo 1 giao dịch trước đó
}

model SataCoinTransaction {
  id           String         @id @default(cuid())
  studentId    String
  amount       Int // dương = cộng, âm = trừ
  type         SataCoinTxType
  reason       String // mã/lý do (vd "ATTENDANCE", "REDEEM_GIFT")
  note         String?        @db.Text
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  ruleCode     String? // rule áp dụng (nếu có)
  reversedTxId String?        @unique // trỏ tới giao dịch bị đảo (1-1)
  createdById  String?
  createdAt    DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([centerId])
  @@index([orgUnitId])
}

model SataCoinRule {
  id        String   @id @default(cuid())
  code      String   @unique // ATTENDANCE, ASSIGNMENT_GOOD, ...
  label     String
  amount    Int // coin cộng khi áp rule
  isActive  Boolean  @default(true)
  centerId  String? // null = áp mọi cơ sở
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Cụm C5 — Zalo OA/ZNS adapter (SKELETON). Tắt an toàn khi thiếu credential →
// fallback email, không phá hệ thống. Log mọi lần gửi.
// =============================================================================

enum ZaloMessageStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // chưa cấu hình credential → bỏ qua (fallback email)
}

model ZaloMessageLog {
  id                String            @id @default(cuid())
  toPhone           String?
  templateKey       String?
  payload           Json              @default("{}")
  status            ZaloMessageStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?           @db.Text
  fallbackEmailed   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
}

// =============================================================================
// Cụm C6 — MISA AMIS sync (SKELETON) + IntegrationLog/IntegrationConfig chung.
// Bật/tắt qua config; KHÔNG push API thật khi tắt hoặc thiếu credential.
// =============================================================================

enum IntegrationStatus {
  PENDING
  SUCCESS
  SKIPPED // tắt hoặc thiếu credential → bỏ qua, không lỗi
  FAILED
}

enum IntegrationDirection {
  PUSH
  PULL
}

model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String   @unique // "MISA"
  isEnabled Boolean  @default(false)
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model IntegrationLog {
  id              String               @id @default(cuid())
  provider        String // "MISA"
  direction       IntegrationDirection @default(PUSH)
  action          String // "PUSH_INVOICE", "PUSH_PAYMENT", ...
  status          IntegrationStatus    @default(PENDING)
  requestPayload  Json                 @default("{}")
  responsePayload Json?
  errorMessage    String?              @db.Text
  createdAt       DateTime             @default(now())

  @@index([provider, status, createdAt])
}

// ───────────────────────────────────────────────────────────────────────────
// R6-A — Cấu hình hệ thống 2 tầng (Flexibility & Hardening).
// Resolve giá trị: CenterSetting (theo OrgUnit) → SystemSetting (GLOBAL) →
// default trong code (registry lib/settings/registry.ts). Key phải có schema
// trong registry mới được ghi (validate Zod). Mọi thay đổi ghi AuditLog.
// ───────────────────────────────────────────────────────────────────────────
/// Tham số vận hành toàn hệ thống (GLOBAL). Chỉ SUPER_ADMIN sửa.
model SystemSetting {
  key           String   @id // khớp key registry, vd "student.nearEndThreshold"
  valueJson     Json
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

/// Override tham số theo cơ sở (OrgUnit). CENTER_MANAGER cơ sở đó / SUPER_ADMIN sửa.
model CenterSetting {
  orgUnitId     String // OrgUnit.id (cơ sở áp dụng)
  key           String // khớp key registry, phải centerOverridable=true
  valueJson     Json
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@id([orgUnitId, key])
  @@index([key])
}

// ─── Marketing content (hardcode remediation Đợt 5) ──────────────────────────
// Chuyển nội dung marketing tĩnh (components/legacy-*/_data/*) sang DB để CMS hoá.

enum PromotionKind {
  PRIMARY // ưu đãi chính (có CTA + details bullet)
  SECONDARY // chính sách phụ (referral/sibling/team — có condition + note)
}

/// Ưu đãi/khuyến mãi hiển thị trang khoá học. Nguồn cũ: _data/promotions.ts.
model Promotion {
  id          String        @id @default(cuid())
  slug        String        @unique // "early-bird", "combo", "installment"...
  kind        PromotionKind @default(PRIMARY)
  title       String
  highlight   String
  description String        @db.Text
  details     String[]      @default([]) // PRIMARY: bullet list
  cta         String? // PRIMARY: nhãn nút
  target      String? // PRIMARY: anchor/target
  condition   String?       @db.Text // SECONDARY: điều kiện
  note        String?       @db.Text // SECONDARY: ghi chú
  icon        String // tên icon lucide
  featured    Boolean       @default(false)
  courseSlug  String? // giới hạn theo landing (laptrinhrobot/luyenthirobosim); null = chung

  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive, displayOrder])
  @@index([courseSlug, isActive])
}

/// Cảm nhận phụ huynh/học viên. Nguồn cũ: _data/testimonials.ts.
model Testimonial {
  id          String  @id @default(cuid())
  name        String
  role        String // "Phụ huynh bạn Duy Tùng" / "Học sinh lớp 4"
  location    String  @default("Đà Nẵng")
  rating      Int     @default(5)
  avatar      String // chữ cái viết tắt "NA"
  avatarColor String // class gradient tailwind hoặc mã hex nền avatar
  content     String  @db.Text
  videoId     String? // YouTube id video cảm nhận (nếu có)
  courseSlug  String? // landing áp dụng: laptrinhrobot/luyenthirobosim/home; null = chung

  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseSlug, isPublished, displayOrder])
}

// ─── R7-03 — Ưu đãi theo khóa ────────────────────────────────────────────────
/// Ưu đãi/học bổng cấu hình theo Course (áp toàn hệ thống, KHÔNG per-center — QĐ-9).
model CourseDiscount {
  id         String             @id @default(cuid())
  courseId   String
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type       CourseDiscountType
  value      Int // AMOUNT: VND; PERCENT/SCHOLARSHIP: %; PROGRAM: tùy note
  note       String?
  conditions String?            @db.Text
  active     Boolean            @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([courseId, active])
}

// ─── R7-06 — Kế hoạch buổi học theo lớp (snapshot từ curriculum pin) ──────────
/// Kế hoạch từng buổi của 1 lớp, sao từ Lesson của curriculum version pin lúc tạo lớp.
/// Reorder/ghi chú sửa ở đây — KHÔNG đụng Lesson gốc (AC4).
model ClassSessionPlan {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  seq         Int // số thứ tự buổi gốc theo curriculum
  lessonId    String? // tham chiếu Lesson nguồn (snapshot; không ràng FK cứng)
  customTitle String?
  note        String?  @db.Text
  order       Int      @default(0) // thứ tự hiển thị (cho phép reorder)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions ClassSession[]

  @@index([classId, order])
}

// ═══ R7-04 — Payment 2 tầng + Receipt ════════════════════════════════════════
enum PaymentSaleStatus {
  RECORDED // Sale ghi nhận đã thu
  COLLECT_CONFIRMED // Sale xác nhận thực thu (chuẩn bị bàn giao kế toán)
}

enum PaymentAccountantStatus {
  PENDING // chờ kế toán
  CONFIRMED // kế toán xác nhận (giảm công nợ, sinh Receipt)
  REJECTED // kế toán từ chối (bắt buộc reason)
  REFUNDED // hoàn (bút toán âm, không xóa gốc)
  ADJUSTED // bản điều chỉnh (trỏ adjustmentOfId)
}

enum ReceiptStatus {
  ACTIVE
  VOID // thu hồi khi khoản bị reject sau khi đã sinh receipt
}

/// R7-04 — khoản thanh toán 2 tầng (Sale ghi nhận ↔ Kế toán xác nhận). Center-scoped.
model Payment {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentPayments", fields: [enrollmentId], references: [id], onDelete: SetNull)
  amount       Int
  method       String // tiền mặt / chuyển khoản / ... (id hoặc nhãn)
  paidDate     DateTime
  evidenceUrl  String?
  note         String? @db.Text

  saleStatus       PaymentSaleStatus       @default(RECORDED)
  accountantStatus PaymentAccountantStatus @default(PENDING)
  recordedById     String?
  confirmedById    String?
  confirmedAt      DateTime?
  rejectReason     String? @db.Text

  adjustmentOfId String?
  adjustmentOf   Payment?  @relation("PaymentAdjustment", fields: [adjustmentOfId], references: [id], onDelete: SetNull)
  adjustments    Payment[] @relation("PaymentAdjustment")

  centerId  String? // cách ly cơ sở (scopedDb)
  receipts  Receipt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([enrollmentId])
  @@index([centerId])
  @@index([accountantStatus])
}

/// R7-04 — phiếu thu per Enrollment (nhiều phiếu), sinh khi kế toán CONFIRMED.
model Receipt {
  id           String        @id @default(cuid())
  code         String        @unique // RCP-{CENTER}-{YY}-{SEQ}
  enrollmentId String
  enrollment   Enrollment    @relation("EnrollmentReceipts", fields: [enrollmentId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  issuedById   String?
  issuedAt     DateTime      @default(now())
  status       ReceiptStatus @default(ACTIVE)

  @@index([enrollmentId])
  @@index([paymentId])
}

// ═══ R7-02 — Lớp trải nghiệm N buổi ══════════════════════════════════════════
enum TrialClassV2Status {
  OPEN
  RUNNING
  COMPLETED
  CANCELLED
}

enum TrialSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TrialEnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum TrialAttendanceStatus {
  PRESENT
  ABSENT
}

/// R7-02 — cấu hình số buổi lớp trải nghiệm (Đào tạo cấu hình, QĐ-O10).
model TrialProgramConfig {
  id           String         @id @default(cuid())
  name         String
  sessionCount Int
  active       Boolean        @default(true)
  updatedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  trialClasses TrialClassV2[]
}

/// R7-02 — lớp trải nghiệm (mới; TrialClass cũ giữ đọc-only 2-phase). Center-scoped.
model TrialClassV2 {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  type         String             @default("TRIAL_ROBOSIM")
  centerId     String // cách ly cơ sở (scopedDb)
  roomId       String?
  startDate    DateTime           @db.Date
  startTime    String
  endTime      String
  capacity     Int
  teacherId    String?
  assistantId  String?
  status       TrialClassV2Status @default(OPEN)
  configId     String?
  config       TrialProgramConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  sessionCount Int // snapshot lúc tạo (lớp cũ giữ N cũ khi config đổi)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  sessions    TrialClassSession[]
  enrollments TrialEnrollment[]

  @@index([centerId, status])
}

/// R7-02 — buổi của lớp trải nghiệm (sinh tự động khi tạo lớp, né Holiday).
model TrialClassSession {
  id           String             @id @default(cuid())
  trialClassId String
  trialClass   TrialClassV2       @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  seq          Int // 1..N
  date         DateTime           @db.Date
  startTime    String
  endTime      String
  roomId       String?
  teacherId    String?
  status       TrialSessionStatus @default(SCHEDULED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  attendances TrialAttendance[]

  @@index([trialClassId, seq])
}

/// R7-02 — ghi danh 1 LeadChild vào 1 lớp trải nghiệm. Partial-unique 1 lớp ACTIVE/con (migration).
model TrialEnrollment {
  id           String                @id @default(cuid())
  trialClassId String
  trialClass   TrialClassV2          @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  leadChildId  String
  leadChild    LeadChild             @relation(fields: [leadChildId], references: [id], onDelete: Cascade)
  status       TrialEnrollmentStatus @default(ACTIVE)
  summaryNote  String?               @db.Text // nhận xét tổng kết học thử
  addedById    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  attendances TrialAttendance[]

  @@index([trialClassId])
  @@index([leadChildId])
}

/// R7-02 — điểm danh + nhận xét per buổi per LeadChild.
model TrialAttendance {
  id                String                @id @default(cuid())
  trialSessionId    String
  trialSession      TrialClassSession     @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)
  trialEnrollmentId String
  trialEnrollment   TrialEnrollment       @relation(fields: [trialEnrollmentId], references: [id], onDelete: Cascade)
  status            TrialAttendanceStatus @default(PRESENT)
  note              String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([trialSessionId, trialEnrollmentId])
}

// ═══ R7-05 — Convert v2 ═══════════════════════════════════════════════════════
enum ConvertConflictStatus {
  OPEN
  RESOLVED
}

/// R7-05 §8.4 — xung đột dedupe parent (email thuộc hồ sơ A, phone thuộc hồ sơ B)
/// → khoá convert, Admin gộp/sửa ở /admin/convert-conflicts rồi RESOLVED để mở khoá.
model ConvertConflict {
  id           String                @id @default(cuid())
  leadId       String
  parentAId    String // User.id khớp theo email
  parentBId    String // User.id khớp theo phone
  status       ConvertConflictStatus @default(OPEN)
  resolvedById String?
  note         String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([leadId, status])
  @@index([status])
}

/// R7-05 — chống double-submit/idempotency cho thao tác nhạy cảm (convert...).
/// key = hash ổn định của payload (vd `convert:${leadId}:${hash}`).
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  scope     String? // "convert" | ...
  result    Json? // tham chiếu kết quả (vd enrollmentIds) để trả lại khi trùng
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}
