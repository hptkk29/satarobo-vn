  parentFeedback      String?     @db.Text
  recommendedCourseId String?
  recommendedCourse   Course?     @relation("TrialRecommendedCourse", fields: [recommendedCourseId], references: [id], onDelete: SetNull)
  createdAt           DateTime    @default(now())
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

model WebhookDelivery {
  id           String        @id @default(cuid())
  source       String // "facebook" | "zalo" | "google-form"
  externalId   String?
  payload      Json
  status       WebhookStatus @default(RECEIVED)
  receivedAt   DateTime      @default(now())
  processedAt  DateTime?
  errorMessage String?       @db.Text
  retryCount   Int           @default(0)

  @@index([source, externalId])
  @@index([status, receivedAt])
